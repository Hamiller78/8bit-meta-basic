uses "../source/reportqueue.mbas"
uses "../source/textqueue.mbas"
uses "../source/mainscreen.mbas"
uses "../source/decision.mbas"

globals
    reportQueueLength = 0
    reportedMissileCount = 0
    redImpactTime = -1
    txtQueueIndex = -1
    decisionActive = 0
    decisionType = NoDecision
end globals

test ReportsWaitUntilDueAndDrainAllDueEvents()
    resetTextQueue()
    scheduleReportQueueEvent(200, "SECOND")
    scheduleReportQueueEvent(100, "FIRST")
    scheduleReportQueueEvent(300, "LATER")
    set_jiffies(99)
    checkReportQueueEvents()
    assert_eq 3, reportQueueLength
    assert_eq -1, txtQueueIndex
    set_jiffies(200)
    checkReportQueueEvents()
    assert_eq "FIRST", left$(chatBuffer$(0), 5)
    assert_eq "SECOND", left$(chatBuffer$(1), 6)
    assert_eq 1, reportQueueLength
    assert_eq 300, reportQueue(0).reportTime
end test

test ImpactMetadataSurvivesQueueShifts()
    scheduleReportQueueEvent(200, "LATER")
    reportQueue(0).impactTime = 3000
    scheduleReportQueueEvent(100, "ORDINARY")
    assert_eq -1, reportQueue(0).impactTime
    assert_eq 3000, reportQueue(1).impactTime
    set_jiffies(100)
    checkReportQueueEvents()
    assert_eq -1, redImpactTime
    assert_eq 3000, reportQueue(0).impactTime
    set_jiffies(200)
    checkReportQueueEvents()
    assert_eq 3000, redImpactTime
    assert_eq 1, reportedMissileCount
end test

test ReportsWithEqualTimesKeepInsertionOrder()
    scheduleReportQueueEvent(100, "FIRST")
    scheduleReportQueueEvent(100, "SECOND")
    set_jiffies(100)
    checkReportQueueEvents()
    assert_eq 0, reportQueueLength
    assert_eq "SECOND", left$(chatBuffer$(1), 6)
    checkReportQueueEvents()
    assert_eq 0, reportQueueLength
end test

test ReportDelayIsBetweenTwentyAndSixtySeconds()
    local i
    set_jiffies(500)
    for i = 1 to 20
        addReportQueueEvent("REPORT")
    next i
    for i = 0 to reportQueueLength - 1
        assert_true reportQueue(i).reportTime >= 500 + 20 * JIFFIES_PER_SECOND
        assert_true reportQueue(i).reportTime <= 500 + 60 * JIFFIES_PER_SECOND
    next i
end test

test FullReportQueueRejectsNewReportWithoutOverwriting()
    local i
    for i = 1 to reportQueueSize
        scheduleReportQueueEvent(100, "KEPT")
    next i
    scheduleReportQueueEvent(0, "REJECTED")
    assert_eq reportQueueSize, reportQueueLength
    assert_eq 100, reportQueue(0).reportTime
    assert_eq "KEPT", left$(reportQueue(0).reportText$, 4)
end test

test NewReportCancelsActiveDecision()
    resetTextQueue()
    startDecision(IncomingMissileDecision)
    scheduleReportQueueEvent(100, "NEW REPORT")

    set_jiffies(100)
    checkReportQueueEvents()

    assert_false decisionActive
    assert_eq "NEW REPORT", left$(chatBuffer$(0), 10)
end test

test IncomingMissileReportStartsAdvisorDecision()
    resetTextQueue()
    scheduleReportQueueEvent(100, "INCOMING MISSILE")
    reportQueue(0).impactTime = 1000

    set_jiffies(100)
    checkReportQueueEvents()

    assert_true decisionActive
    assert_eq IncomingMissileDecision, decisionType
    assert_eq "INCOMING MISSILE", left$(chatBuffer$(0), 16)
    assert_eq "ADVISOR: SELECT OUR RESPONSE", left$(chatBuffer$(1), 28)
    assert_eq 1, txtQueueIndex
    assert_printat decisionLastRow, 1, "  LAUNCH EVERYTHING"
end test
