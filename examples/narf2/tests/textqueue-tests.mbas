uses "../source/textqueue.mbas"

globals
    txtQueueIndex = -1
end globals

test AddToTextQueueStoresAndPrintsChatLine()
    addToTextQueue(5, 6, 7, "ABC")

    assert_eq 0, txtQueueIndex
    assert_eq "ABC", chatBuffer$(0)
    assert_printat 5, 9, left$(chatBlankLine$, TEXT_COLUMNS - 8)
end test

test AddToTextQueueStoresHighestUsedChatRow()
    addToTextQueue(5, 1, 7, "FIRST")
    addToTextQueue(7, 1, 7, "THIRD")

    assert_eq 2, txtQueueIndex
    assert_eq "FIRST", chatBuffer$(0)
    assert_eq "THIRD", chatBuffer$(2)
end test

test AddToTextQueuePrintsNonChatLineWithoutBuffering()
    addToTextQueue(3, 2, 7, "HEADER")

    assert_eq -1, txtQueueIndex
    assert_printat 3, 2, "HEADER"
end test

test ClearTextQueueResetsBuffer()
    addToTextQueue(5, 1, 7, "ABC")
    clearTextQueue()

    assert_eq -1, txtQueueIndex
    assert_eq "", chatBuffer$(0)
    assert_printat chatLastRow, 1, blankChatLine$
end test

test ResetTextQueueResetsBufferWithoutPrinting()
    addToTextQueue(5, 1, 7, "ABC")
    resetTextQueue()

    assert_eq -1, txtQueueIndex
    assert_eq "", chatBuffer$(0)
    assert_printat 5, 4, left$(chatBlankLine$, TEXT_COLUMNS - 3)
end test

test DrawTextQueueRedrawsBufferedLines()
    addToTextQueue(5, 1, 7, "FIRST")
    addToTextQueue(7, 1, 7, "THIRD")

    drawTextQueue()

    assert_printat 7, 6, left$(chatBlankLine$, TEXT_COLUMNS - 5)
end test

test PrintQueuesDoesNotAnimateText()
    addToTextQueue(5, 1, 7, "ABC")
    printQueues()

    assert_eq 0, txtQueueIndex
    assert_eq "ABC", chatBuffer$(0)
end test
