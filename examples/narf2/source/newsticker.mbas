const TICKER_UPDATE_DELAY = 10
const TICKER_TEXT_WIDTH = TEXT_COLUMNS - 10

newsText$ = "PRESIDENT REAGAN CONTINUES ASIA TOUR - "
newsText$ = newsText$ + "LIONEL RICHIE'S 'ALL NIGHT LONG' TOPS THE U.S. SINGLES CHART - "
newsText$ = newsText$ + "FIGHTING CONTINUES BETWEEN RIVAL PLO FACTIONS IN LEBANON - "
newsText$ = newsText$ + "TONIGHT: MAGNUM P.I. ON CBS - "
newsText$ = newsText$ + "THE WEATHER: PARTLY CLOUDY WITH A HIGH OF 75 - "
displayedText$ = left$(newsText$, TICKER_TEXT_WIDTH)
nextText$ = ""
newsIndex = 1
nextTickerUpdate = 0


function setupTicker()
    displayedText$ = left$(newsText$, TICKER_TEXT_WIDTH)
    newsIndex = TICKER_TEXT_WIDTH + 1
    nextTickerUpdate = jiffies() + TICKER_UPDATE_DELAY
end function

function setNextTickerText(text$)
    nextText$ = text$
end function

function updateTicker()
    if jiffies() > nextTickerUpdate then
        getNewsLine()
        print_at TEXT_ROWS - 1, 5, displayedText$
        nextTickerUpdate = nextTickerUpdate + TICKER_UPDATE_DELAY
    end if
end function

inline function getNewsLine()
    if newsIndex > len(newsText$) then
        if nextText$ <> "" then
            newsText$ = nextText$
            nextText$ = ""
        end if
        newsIndex = 1
    end if

    displayedText$ = mid$(displayedText$, 2)
    displayedText$ = displayedText$ + mid$(newsText$, newsIndex, 1)

    newsIndex = newsIndex + 1
end function
