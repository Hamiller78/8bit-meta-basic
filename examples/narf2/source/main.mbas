uses "mainscreen.mbas"
uses "textqueue.mbas"
uses "worldqueue.mbas"
uses "reportqueue.mbas"
uses "timehelper.mbas"

program_mode
screen_border_color BLUE
screen_background_color BLUE
screen_text_color WHITE
cls

'begin program
printIntroText()

addToTextQueue(12, 1, 5, "Connecting to NORAD...")
addToTextQueue(13, 1, 30, "User: RONALD REAGAN")

waitForKeyPress()
resetTextQueue()
waitForKeyRelease()
drawMainScreen()

setClock("11:47:30") ' Set initial time for clock
drawMainClock(currentTime$)
addWorldQueueEvent(MissileHitsOurCity, jiffies() + 60 * JIFFIES_PER_SECOND, "WASHINGTON D.C.", 0)
drawRedCountdown()

repeat
    checkWorldQueueEvents()
    checkReportQueueEvents()
    updateMainScreen()
until key_pressed()

print free_memory();" bytes free"

end

inline function printIntroText()
    printCentered(5, "Nuclear Attack")
    printCentered(7, "Reaction Failsafe")
    printCentered(9, "(N.A.R.F.)")
end function

function printCentered(row, text$)
    column = (TEXT_COLUMNS - len(text$)) / 2 + 1
    print_at row, column, text$;
end function

function waitForKeyRelease()
    key = key_code()
    repeat
        key = key_code()
    until not key_pressed()
end function

function waitForKeyPress()
    local pressed

    repeat
        pressed = key_pressed()
    until pressed
end function
