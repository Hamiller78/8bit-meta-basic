program_mode
screen_border_color BLUE
screen_background_color BLUE
screen_text_color WHITE
cls

'Variables for game logic
icbms = 500
submarines = 50
bombers = 100
defcon = 1

'begin program
printIntroText()

addToTextQueue(12, 1, 5, "Connecting to NORAD...")
addToTextQueue(13, 7, 30, "RONALD REAGAN")

'main loop: add text output queue for telegraph effect
repeat
    printQueues()
until key_pressed()

clearTextQueue()
waitForKeyRelease()
setUpMainScreen()

setClock("11:47:30") ' Set initial time for clock
print_at 4, (TEXT_COLUMNS - 10) / 2, " ";currentTime$;" "

setupTicker()
repeat
    time$ = getCurrentTimeIfUpdated$()
    if time$ <> "" then
        print_at 4, (TEXT_COLUMNS - 10) / 2, " ";time$;" " 
    end if
    updateTicker()
until key_pressed()

print free_memory();" bytes free"

end

inline function printIntroText()
    printCentered(5, "Nuclear Attack")
    printCentered(7, "Reaction Failsafe")
    printCentered(9, "(N.A.R.F.)")

    print_at 13, 1, "User:"
end function

inline function setUpMainScreen()
    cls

    print_at 1, TEXT_COLUMNS - 11, "DEFCON:   " + right$(str$(defcon),1);
    print_at 2, TEXT_COLUMNS - 11, "RED:  11:47";
    print_at 3, TEXT_COLUMNS - 11, "BLUE: 22:21";
    print_at 1, 1, "ICBMS:   " + str$(icbms);
    print_at 2, 1, "SUBS:    " + str$(submarines);
    print_at 3, 1, "BOMBERS: " + str$(bombers);
    print_at 4,1, string$("-", TEXT_COLUMNS);
    text_color YELLOW
    print_at TEXT_ROWS - 1, 1, "***";
    print_at TEXT_ROWS - 1, TEXT_COLUMNS -4, "***";
    text_color WHITE
end function

function printCentered(row, text$)
    column = (TEXT_COLUMNS - len(text$)) / 2 + 1
    print_at row, column, text$
end function

function waitForKeyRelease()
    key = key_code()
    repeat
        key = key_code()
    until not key_pressed()
end function
