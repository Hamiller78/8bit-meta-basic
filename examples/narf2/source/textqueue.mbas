' Struct for telegraph text being printed one character at a time
struct TextQueueItem
    row
    column
    delay
    text$(40)
    length
    nextTime
end struct

' Variables for telegraph text output queue, several in parallel can be printed at once, each with its own delay
const txtQueueSize = 20
dim txtQueue AS TextQueueItem(txtQueueSize)
txtQueueIndex = -1

function addToTextQueue(row, column, delay, text$)
    if txtQueueIndex = txtQueueSize - 1 then
        ' Queue is full, emergency flush one text to make room
        print_at txtQueue(txtQueueIndex).row, txtQueue(txtQueueIndex).column, left$(txtQueue(txtQueueIndex).text$, txtQueue(txtQueueIndex).length)
        txtQueueIndex = txtQueueSize - 2
    end if

    txtQueueIndex = txtQueueIndex + 1
    txtQueue(txtQueueIndex).row = row
    txtQueue(txtQueueIndex).column = column
    txtQueue(txtQueueIndex).delay = delay
    txtQueue(txtQueueIndex).text$ = text$
    txtQueue(txtQueueIndex).length = len(text$)
    txtQueue(txtQueueIndex).nextTime = jiffies()
end function

function clearTextQueue()
    txtQueueIndex = -1
end function

function printQueues()
    for i = 0 to txtQueueIndex
        if txtQueueIndex < 0 or i > txtQueueIndex then
            exit for
        end if

        if jiffies() < txtQueue(i).nextTime then
            continue for
        end if

        print_at txtQueue(i).row, txtQueue(i).column, left$(txtQueue(i).text$, 1) ' Print one character at a time
        txtQueue(i).length = txtQueue(i).length - 1

        if txtQueue(i).length = 0 then
            remove_element(txtQueue, i)
            txtQueueIndex = txtQueueIndex - 1
            i = i - 1 ' Adjust index since we removed an item
            continue for
        end if

        advanceQueueItem(i)
    next i
end function

inline function advanceQueueItem(queueIndex)
    txtQueue(queueIndex).text$ = mid$(txtQueue(queueIndex).text$, 2, txtQueue(queueIndex).length) ' Remove the printed character from the string
    txtQueue(queueIndex).column = txtQueue(queueIndex).column + 1
    txtQueue(queueIndex).nextTime = jiffies() + txtQueue(queueIndex).delay
end function
