' Buffered text output for the main chat area
const chatFirstRow = 5
const chatLastRow = TEXT_ROWS - 3
const chatRows = chatLastRow - chatFirstRow + 1
const blankChatLine$ = string$(" ", TEXT_COLUMNS)

dim chatBuffer$(chatRows, TEXT_COLUMNS)
chatBlankLine$ = blankChatLine$
txtQueueIndex = -1

function addToTextQueue(row, column, delay, text$)
    local bufferIndex
    local printWidth
    local textLength

    if row < chatFirstRow or row > chatLastRow then
        print_at row, column, text$;
        return
    end if

    bufferIndex = row - chatFirstRow
    chatBuffer$(bufferIndex) = text$
    if bufferIndex > txtQueueIndex then
        txtQueueIndex = bufferIndex
    end if

    printWidth = TEXT_COLUMNS - column + 1
    textLength = len(text$)
    print_at row, column, text$;
    if textLength < printWidth then
        print_at row, column + textLength, left$(chatBlankLine$, printWidth - textLength);
    end if
end function

function clearTextQueue()
    resetTextQueue()
    clearTextQueueArea()
end function

function resetTextQueue()
    local i

    i = 0
    while i < chatRows
        chatBuffer$(i) = ""
        i = i + 1
    wend

    txtQueueIndex = -1
end function

function clearTextQueueArea()
    local i

    i = 0
    while i < chatRows
        print_at chatFirstRow + i, 1, blankChatLine$;
        i = i + 1
    wend
end function

function drawTextQueue()
    local i
    local textLength

    i = 0
    while i <= txtQueueIndex
        if chatBuffer$(i) <> "" then
            textLength = len(chatBuffer$(i))
            print_at chatFirstRow + i, 1, chatBuffer$(i);
            if textLength < TEXT_COLUMNS then
                print_at chatFirstRow + i, textLength + 1, left$(chatBlankLine$, TEXT_COLUMNS - textLength);
            end if
        end if
        i = i + 1
    wend
end function

function printQueues()
end function
