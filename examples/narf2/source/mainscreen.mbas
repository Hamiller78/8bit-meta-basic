uses "timehelper.mbas"

icbms = 500
submarines = 50
bombers = 100
defcon = 1

' Only delivered intelligence contributes to the red countdown.
const reportedMissileCapacity = 50
dim reportedImpactTimes(reportedMissileCapacity)
reportedMissileCount = 0
redImpactTime = -1

function reportIncomingMissile(impactTime)
    refreshRedCountdownTarget()
    if impactTime <= jiffies() then
        return
    end if
    if reportedMissileCount >= reportedMissileCapacity then
        return
    end if
    reportedImpactTimes(reportedMissileCount) = impactTime
    reportedMissileCount = reportedMissileCount + 1
    if redImpactTime < 0 or impactTime < redImpactTime then
        redImpactTime = impactTime
    end if
end function

function refreshRedCountdownTarget()
    local i
    local now

    now = jiffies()
    redImpactTime = -1
    i = 0
    while i < reportedMissileCount
        if reportedImpactTimes(i) <= now then
            reportedMissileCount = reportedMissileCount - 1
            reportedImpactTimes(i) = reportedImpactTimes(reportedMissileCount)
        else
            if redImpactTime < 0 or reportedImpactTimes(i) < redImpactTime then
                redImpactTime = reportedImpactTimes(i)
            end if
            i = i + 1
        end if
    wend
end function

function secondsUntilReportedMissileImpact()
    local now

    now = jiffies()
    if redImpactTime >= 0 and redImpactTime <= now then
        refreshRedCountdownTarget()
    end if
    if redImpactTime < 0 then
        return -1
    end if
    return int((redImpactTime - now) / JIFFIES_PER_SECOND)
end function

inline function drawMainScreen()
    cls

    print_at 1, TEXT_COLUMNS - 11, "DEFCON:   " + right$(str$(defcon),1);
    drawRedCountdown()
    print_at 3, TEXT_COLUMNS - 11, "BLUE: --:--";
    print_at 1, 1, "ICBMS:   " + str$(icbms);
    print_at 2, 1, "SUBS:    " + str$(submarines);
    print_at 3, 1, "BOMBERS: " + str$(bombers);
    print_at 4,1, string$("-", TEXT_COLUMNS);
    text_color YELLOW
    print_at TEXT_ROWS - 1, 1, "***";
    print_at TEXT_ROWS - 1, TEXT_COLUMNS -4, "***";
    text_color WHITE
end function

function drawMainClock(time$)
    print_at 4, (TEXT_COLUMNS - 10) / 2, " ";time$;" "
end function

function updateMainScreen()
    local screenTime$

    screenTime$ = getCurrentTimeIfUpdated$()
    if screenTime$ <> "" then
        drawMainClock(screenTime$)
        drawRedCountdown()
    end if
end function

function drawRedCountdown()
    local secondsLeft
    local minutesLeft
    local remainingSeconds

    secondsLeft = secondsUntilReportedMissileImpact()
    if secondsLeft < 0 then
        print_at 2, TEXT_COLUMNS - 11, "RED:  --:--";
    else
        minutesLeft = int(secondsLeft / 60)
        remainingSeconds = secondsLeft MOD 60
        print_at 2, TEXT_COLUMNS - 11, "RED:  " + twoDigits$(minutesLeft) + ":" + twoDigits$(remainingSeconds);
    end if
end function
