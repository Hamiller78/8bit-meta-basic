test RandomNumberRange()
    randomize 123
    Value = rnd()
    assert_true Value >= 0
    assert_true Value < 1
end test

test JiffiesRead()
    Tick = jiffies()
    assert_true Tick >= 0
end test

test FreeMemoryRead()
    MemoryLeft = free_memory()
    assert_true MemoryLeft > 0
end test

test InlineFunctionExpansion()
    Result = InlineDouble(4)
    assert_eq 8, Result
end test

inline function InlineDouble(Value)
    return Value * 2
end function

test NoKeyPressed()
    assert_false key_pressed()
end test
