test ArithmeticAndPrecedence()
    assert_eq 14, 2 + 3 * 4
    assert_eq 20, (2 + 3) * 4
    assert_eq 8, 2 ^ 3
end test

test ComparisonsAndLogic()
    assert_true 4 > 3
    assert_true 4 >= 4 and 2 < 3
    assert_true 1 or 0
    assert_false not true
    assert_false 0 and 1
end test

test EnvironmentConstants()
    assert_true TEXT_COLUMNS >= 32
    assert_true TEXT_ROWS >= 22
    assert_true TEXT_ROWS <= 25
    assert_eq 50, JIFFIES_PER_SECOND
end test

test NumericFunctions()
    assert_eq 5, abs(-5)
    assert_eq 3, int(3.7)
    assert_eq -1, sgn(-12)
    assert_eq 4, sqr(16)
end test

enum DemoState
    DemoIdle
    DemoRunning = 4
    DemoFinished
end enum

test EnumConstants()
    assert_eq 0, DemoIdle
    assert_eq 4, DemoRunning
    assert_eq 5, DemoFinished
end test
