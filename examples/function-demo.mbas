screen_border_color BLUE
screen_background_color BLACK
screen_text_color WHITE
cls

score = 100
bonus = 25
result = 999

total = addBonus(score, bonus)
doubleTotal = doubleValue(total)

print "function demo"
print "global score: "; score
print "global bonus: "; bonus
print "global result: "; result
print "add bonus: "; total
print "double total: "; doubleTotal
print "globals still: "; score; " "; result

function addBonus(score, bonus)
    local result
    result = score + bonus
    return result
end function

function doubleValue(value)
    local result
    result = value * 2
    return result
end function
