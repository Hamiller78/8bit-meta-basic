uses "../source/characters.mbas"
uses "../source/characternames.mbas"
uses "../source/characterfactory.mbas"

test ProgramModeDoesNotInterruptNameInitialization()
    program_mode
    resetNameSelection()
    assert_eq "Vladimir", readCharacterName$(russianMaleNameOffset, 0)
    assert_eq "Sokolov", readCharacterName$(russianLastNameOffset, russianLastNames - 1)
end test

test CharacterNamesAreUsedOnlyOnce()
    local characterIndex, firstIndex, secondIndex

    resetCharacterFactory()

    for characterIndex = 0 to englishMaleFirstNames - 1
        assert_eq characterIndex, createCharacter(us, none)
    next characterIndex
    assert_eq -1, createCharacter(us, none)

    for firstIndex = 0 to englishMaleFirstNames - 2
        for secondIndex = firstIndex + 1 to englishMaleFirstNames - 1
            assert_ne characters(firstIndex).first$, characters(secondIndex).first$
            assert_ne characters(firstIndex).last$, characters(secondIndex).last$
        next secondIndex
    next firstIndex
end test

test CharacterAttributesHaveSafeDefaults()
    local characterIndex

    resetCharacterFactory()
    characterIndex = createCharacter(us, none)

    assert_ne -1, characterIndex
    assert_eq none, characters(characterIndex).role%
    assert_true characters(characterIndex).integrity% >= 0
    assert_true characters(characterIndex).integrity% <= 10
    assert_eq -1, characters(characterIndex).agenda%
end test

test AllCharacterRolesAreCreated()
    local characterIndex, agendaIndex, agendaOwner

    createAllCharacters(false)

    assert_eq numberOfCharacters, createdCharacterCount
    assert_eq usagent, characters(0).role%
    assert_eq usagent, characters(1).role%
    assert_eq ussragent, characters(2).role%
    assert_eq ussragent, characters(3).role%
    assert_eq president, characters(4).role%
    assert_eq daughter, characters(5).role%
    assert_eq characters(4).last$, characters(5).last$
    assert_eq daughterFirstNames - 1, daughterFirstNamesRemaining
    assert_eq spanishLastNames - 6, spanishLastNamesRemaining
    assert_eq advisor, characters(6).role%
    assert_eq general, characters(7).role%
    assert_eq priest, characters(8).role%
    assert_eq innkeeper, characters(9).role%
    assert_eq landowner, characters(10).role%
    assert_eq ustourist, characters(11).role%

    for characterIndex = 0 to createdCharacterCount - 1
        assert_true characters(characterIndex).integrity% >= 0
        assert_true characters(characterIndex).integrity% <= 10
    next characterIndex

    assert_true characterAgendaCount% <= maximumCharacterAgendas
    for agendaIndex = 0 to characterAgendaCount% - 1
        agendaOwner = -1
        for characterIndex = 0 to createdCharacterCount - 1
            if characters(characterIndex).agenda% = agendaIndex then
                agendaOwner = characterIndex
            end if
        next characterIndex
        assert_true agendaOwner >= 0
        assert_true agendaOwner < createdCharacterCount
        assert_true characterAgendas(agendaIndex).kind% >= usurpRole
        assert_true characterAgendas(agendaIndex).kind% <= secretSpy
        assert_eq 0, characterAgendas(agendaIndex).money
        assert_eq 0, characterAgendas(agendaIndex).weapons%
        if characterAgendas(agendaIndex).kind% = usurpRole or characterAgendas(agendaIndex).kind% = findLove then
            assert_true characterAgendas(agendaIndex).target% >= 0
            assert_true characterAgendas(agendaIndex).target% < createdCharacterCount
            assert_ne agendaOwner, characterAgendas(agendaIndex).target%
        else
            assert_eq -1, characterAgendas(agendaIndex).target%
        end if
    next agendaIndex
end test

test DutyNeedsNoAgendaRecord()
    local agendaIndex
    characterAgendaCount% = 0
    characters(4).agenda% = -1
    assert_eq -1, characters(4).agenda%
    assert_eq 0, characterAgendaCount%
    agendaIndex = characterAgendaCount%
    characterAgendaCount% = characterAgendaCount% + 1
    characters(4).agenda% = agendaIndex
    characterAgendas(agendaIndex).kind% = usurpRole
    characterAgendas(agendaIndex).target% = 6
    characterAgendas(agendaIndex).money = 0
    characterAgendas(agendaIndex).weapons% = 0
    assert_eq 1, characterAgendaCount%
    assert_eq usurpRole, characterAgendas(agendaIndex).kind%
    assert_eq 6, characterAgendas(agendaIndex).target%
end test
