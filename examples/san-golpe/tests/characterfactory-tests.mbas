uses "../source/characters.mbas"
uses "../source/characternames.mbas"
uses "../source/characterfactory.mbas"

test CharacterNamesAreUsedOnlyOnce()
    local characterIndex, firstIndex, secondIndex

    resetCharacterFactory()

    for characterIndex = 0 to englishMaleFirstNames - 1
        assert_eq characterIndex, createCharacter(us, male)
    next characterIndex
    assert_eq noCharacterIndex, createCharacter(us, male)

    for firstIndex = 0 to englishMaleFirstNames - 2
        for secondIndex = firstIndex + 1 to englishMaleFirstNames - 1
            assert_ne characters(firstIndex).first$, characters(secondIndex).first$
            assert_ne characters(firstIndex).last$, characters(secondIndex).last$
        next secondIndex
    next firstIndex
end test

test AllCharacterRolesAreCreated()
    local russianMaleLast$, russianFemaleLast$, femaleNameHasSuffix

    createAllCharacters()

    assert_eq characterCapacity, createdCharacterCount
    assert_eq usagent, characters(0).role
    assert_eq male, characters(0).gender
    assert_eq usagent, characters(1).role
    assert_eq female, characters(1).gender
    assert_eq ussragent, characters(2).role
    assert_eq male, characters(2).gender
    russianMaleLast$ = characters(2).last$
    assert_ne "a", mid$(russianMaleLast$, 7, 1)
    assert_ne "a", mid$(russianMaleLast$, 8, 1)
    assert_eq ussragent, characters(3).role
    assert_eq female, characters(3).gender
    russianFemaleLast$ = characters(3).last$
    femaleNameHasSuffix = 0
    if mid$(russianFemaleLast$, 7, 1) = "a" then
        femaleNameHasSuffix = 1
    end if
    if mid$(russianFemaleLast$, 8, 1) = "a" then
        femaleNameHasSuffix = 1
    end if
    assert_true femaleNameHasSuffix
    assert_eq president, characters(4).role
    assert_eq daughter, characters(5).role
    assert_eq characters(4).last$, characters(5).last$
    assert_eq advisor, characters(6).role
    assert_eq priest, characters(7).role
    assert_eq bartender, characters(8).role
    assert_eq landowner, characters(9).role
    assert_eq ustourist, characters(10).role
end test
