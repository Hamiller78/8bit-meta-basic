uses "../source/characters.mbas"
uses "../source/politics.mbas"
uses "../source/presidentevents.mbas"

function setupPresidentEvents()
    local characterIndex
    for characterIndex = 0 to numberOfCharacters - 1
        characters(characterIndex).role% = none
        characters(characterIndex).isAlive% = 1
        characters(characterIndex).integrity% = 5
    next characterIndex
    characters(4).role% = president
    characters(6).role% = advisor
    characters(7).role% = general
    characters(6).first$ = "Carlos"
    characters(6).last$ = "Vega"
    characters(7).first$ = "Miguel"
    characters(7).last$ = "Santos"
    initializePolitics()
    initializePresidentEvents()
end function

test EventWeightsFollowTheEconomicPosition()
    setupPresidentEvents()
    presidentEconomy% = economyMinimum
    assert_eq 10, presidentEventWeight(presidentPraisesOfficial)
    assert_eq 30, presidentEventWeight(presidentCriticizesOfficial)
    assert_eq 0, presidentEventWeight(presidentReactsToHighCoffee)
    assert_eq 0, presidentEventWeight(presidentReactsToLowCoffee)

    presidentEconomy% = economyMaximum
    assert_eq 30, presidentEventWeight(presidentPraisesOfficial)
    assert_eq 10, presidentEventWeight(presidentCriticizesOfficial)

    worldCoffeePrice% = coffeePriceHigh
    assert_eq 60, presidentEventWeight(presidentReactsToHighCoffee)
    worldCoffeePrice% = coffeePriceLow
    presidentEconomy% = economyMinimum
    assert_eq 60, presidentEventWeight(presidentReactsToLowCoffee)
end test

test WeightedSelectionUsesAllEligibleEvents()
    setupPresidentEvents()
    presidentEconomy% = economyInitial
    assert_eq 40, presidentEventTotalWeight()
    assert_eq presidentPraisesOfficial, presidentEventAt(0)
    assert_eq presidentPraisesOfficial, presidentEventAt(19)
    assert_eq presidentCriticizesOfficial, presidentEventAt(20)
    assert_eq presidentCriticizesOfficial, presidentEventAt(39)

    worldCoffeePrice% = coffeePriceHigh
    assert_eq presidentReactsToHighCoffee, presidentEventAt(presidentEventTotalWeight() - 1)
end test

test SpeechEventsChangeTheMentionedOfficial()
    setupPresidentEvents()
    characters(6).integrity% = 9
    characters(7).integrity% = 1

    applyPresidentEvent(presidentPraisesOfficial, 0)
    assert_eq 6, currentPresidentEventTarget%
    assert_eq 10, characters(6).integrity%
    applyPresidentEvent(presidentPraisesOfficial, 0)
    assert_eq 10, characters(6).integrity%

    applyPresidentEvent(presidentCriticizesOfficial, 1)
    assert_eq 7, currentPresidentEventTarget%
    assert_eq 0, characters(7).integrity%
    applyPresidentEvent(presidentCriticizesOfficial, 1)
    assert_eq 0, characters(7).integrity%
end test

test CoffeeEventsMoveThePresidentWithinBounds()
    setupPresidentEvents()
    presidentEconomy% = 98
    applyPresidentEvent(presidentReactsToHighCoffee, 0)
    assert_eq economyMaximum, presidentEconomy%
    presidentEconomy% = 2
    applyPresidentEvent(presidentReactsToLowCoffee, 0)
    assert_eq economyMinimum, presidentEconomy%

    worldCoffeePrice% = 95
    updateWorldCoffeePrice(10)
    assert_eq coffeePriceMaximum, worldCoffeePrice%
    worldCoffeePrice% = 5
    updateWorldCoffeePrice(-10)
    assert_eq coffeePriceMinimum, worldCoffeePrice%
end test

test PresidentEventTextUsesTheSelectedResult()
    setupPresidentEvents()
    applyPresidentEvent(presidentPraisesOfficial, 0)
    printPresidentEvent()
    assert_print "In a speech, the President praises Carlos Vega."
end test
