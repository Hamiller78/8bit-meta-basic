uses "../source/characters.mbas"
uses "../source/politics.mbas"
uses "../source/presidentevents.mbas"

function setupPresidentEvents()
    local characterIndex
    for characterIndex = 0 to numberOfCharacters - 1
        characters(characterIndex).role% = none
        characters(characterIndex).isAlive% = 1
        characters(characterIndex).integrity% = 5
        characters(characterIndex).influence% = 1
        characters(characterIndex).socialism% = 50
    next characterIndex
    characters(0).role% = president
    characters(1).role% = daughter
    characters(2).role% = advisor
    characters(3).role% = general
    characters(4).role% = priest
    characters(5).role% = innkeeper
    characters(6).role% = landowner
    characters(2).first$ = "Carlos"
    characters(2).last$ = "Vega"
    initializePolitics()
    initializePresidentEvents()
end function

test InfluenceIsAWeightedCharacterSelection()
    setupPresidentEvents()
    characters(1).influence% = 1
    characters(2).influence% = 3
    characters(3).influence% = 2
    characters(4).influence% = 0
    characters(5).influence% = 0
    characters(6).influence% = 0

    assert_eq 6, influenceTotalWeight()
    assert_eq 1, influencerAt(0)
    assert_eq 2, influencerAt(1)
    assert_eq 2, influencerAt(3)
    assert_eq 3, influencerAt(4)
    assert_eq 3, influencerAt(5)
    characters(2).isAlive% = 0
    assert_eq 3, influenceTotalWeight()
end test

test CombinedSocialismChoosesTheResponse()
    setupPresidentEvents()
    characters(0).socialism% = 50
    characters(2).socialism% = 16
    assert_eq responseAuthoritarian, presidentResponseFor(2)
    characters(2).socialism% = 17
    assert_eq responseBalanced, presidentResponseFor(2)
    characters(2).socialism% = 83
    assert_eq responseBalanced, presidentResponseFor(2)
    characters(2).socialism% = 84
    assert_eq responseSocial, presidentResponseFor(2)
end test

test ResponseMovesThePresidentWithinBounds()
    setupPresidentEvents()
    characters(1).influence% = 0
    characters(2).influence% = 1
    characters(3).influence% = 0
    characters(4).influence% = 0
    characters(5).influence% = 0
    characters(6).influence% = 0

    characters(0).socialism% = 98
    characters(2).socialism% = 100
    resolveRoundEvent(bananaBlight, 0)
    assert_eq bananaBlight, currentRoundEvent%
    assert_eq 2, currentInfluencer%
    assert_eq responseSocial, currentPresidentResponse%
    assert_eq politicalMaximum, characters(0).socialism%

    characters(0).socialism% = 2
    characters(2).socialism% = 0
    resolveRoundEvent(dockStrike, 0)
    assert_eq responseAuthoritarian, currentPresidentResponse%
    assert_eq politicalMinimum, characters(0).socialism%
end test

test RoundEventTextShowsInfluenceAndResponse()
    setupPresidentEvents()
    characters(1).influence% = 0
    characters(2).influence% = 1
    characters(3).influence% = 0
    characters(4).influence% = 0
    characters(5).influence% = 0
    characters(6).influence% = 0

    resolveRoundEvent(coffeePriceCollapse, 0)
    printPresidentEvent()
    assert_print "BALANCED"
end test
