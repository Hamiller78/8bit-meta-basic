uses "../source/characters.mbas"
uses "../source/intelligence.mbas"
uses "../source/politics.mbas"
uses "../source/agentoperations.mbas"

function setupOperations()
    local characterIndex
    characterAgendaCount% = 0
    for characterIndex = 0 to numberOfCharacters - 1
        characters(characterIndex).role% = none
        characters(characterIndex).isAlive% = 1
        characters(characterIndex).integrity% = 5
        characters(characterIndex).influence% = 1
        characters(characterIndex).socialism% = 50
        characters(characterIndex).agenda% = -1
    next characterIndex
    characters(0).role% = president
    characters(1).role% = daughter
    characters(2).role% = advisor
    characters(3).role% = general
    characters(4).role% = priest
    characters(5).role% = innkeeper
    characters(6).role% = landowner
    initializeIntelligence()
    initializePolitics()
    initializeUsaActions()
end function

function addTestContact(characterIndex)
    revealCharacter(characterIndex, intelObserved)
    return addContact(characterIndex)
end function

test PresidentAlignmentIsHiddenBehindQualitativeReports()
    local presidentIndex, advisorIndex
    setupOperations()
    presidentIndex = findRole(president)
    advisorIndex = findRole(advisor)

    assert_eq presidentSocialismInitial, characters(presidentIndex).socialism%
    adjustPresidentSocialism(-80)
    assert_eq politicalMinimum, characters(presidentIndex).socialism%
    adjustPresidentSocialism(140)
    assert_eq politicalMaximum, characters(presidentIndex).socialism%
    adjustPresidentSocialism(-50)
    assert_eq politicalMiddle, politicalAlignmentBand(characters(presidentIndex).socialism%)

    characters(advisorIndex).integrity% = 10
    assert_eq politicalMiddle, reportedPresidentAlignmentBand(advisorIndex, 9, 0)
    characters(advisorIndex).integrity% = 0
    assert_eq authoritarianLeaning, reportedPresidentAlignmentBand(advisorIndex, 0, 0)
    assert_eq socialistLeaning, reportedPresidentAlignmentBand(advisorIndex, 0, 9)
end test

test CharacterVicinityControlsKnowledge()
    local presidentIndex, advisorIndex, daughterIndex, generalIndex, priestIndex, innkeeperIndex
    setupOperations()
    presidentIndex = findRole(president)
    advisorIndex = findRole(advisor)
    daughterIndex = findRole(daughter)
    generalIndex = findRole(general)
    priestIndex = findRole(priest)
    innkeeperIndex = findRole(innkeeper)

    assert_eq 1, canCharacterKnowAbout(advisorIndex, presidentIndex)
    assert_eq 0, canCharacterKnowAbout(0, presidentIndex)
    assert_eq 0, canCharacterKnowAbout(advisorIndex, daughterIndex)
    assert_eq 0, canCharacterKnowAbout(advisorIndex, generalIndex)
    assert_eq 1, canCharacterKnowAbout(innkeeperIndex, generalIndex)
    assert_eq 0, canCharacterKnowAbout(priestIndex, generalIndex)
    characters(generalIndex).integrity% = 6
    assert_eq 1, canCharacterKnowAbout(priestIndex, generalIndex)
    assert_eq 0, canCharacterKnowAbout(innkeeperIndex, generalIndex)
    assert_eq 0, canCharacterKnowAbout(priestIndex, priestIndex)
end test

test PresidentInvestigationUsesAnInsiderReport()
    local presidentIndex, advisorIndex
    setupOperations()
    presidentIndex = findRole(president)
    advisorIndex = findRole(advisor)

    addTestContact(advisorIndex)
    revealCharacter(presidentIndex, intelObserved)
    characters(advisorIndex).integrity% = 10
    assert_eq 1, setUsaInvestigation(0, presidentIndex)
    resolveInvestigationRoll(0, presidentIndex, 0)
    assert_eq reportPoliticalInsight, usaReports%(0)
    assert_eq advisorIndex, usaReportTargets%(0)
    assert_eq politicalMiddle, usaActionValues%(0)
end test

test OnlyANearbyContactOpensThePresident()
    local presidentIndex, advisorIndex, innkeeperIndex
    setupOperations()
    presidentIndex = findRole(president)
    advisorIndex = findRole(advisor)
    innkeeperIndex = findRole(innkeeper)

    revealCharacter(presidentIndex, intelObserved)
    assert_eq 1, canApproach(presidentIndex)
    assert_eq 0, canInvestigate(presidentIndex)
    assert_eq 1, addTestContact(innkeeperIndex)
    assert_eq 0, canInvestigate(presidentIndex)
    assert_eq 1, addTestContact(advisorIndex)
    assert_eq 0, addContact(advisorIndex)
    assert_eq 1, contactCount%
    assert_eq 1, canApproach(presidentIndex)
    assert_eq 1, canInvestigate(presidentIndex)
    assert_eq 1, setUsaDeal(0, advisorIndex, presidentIndex)
end test

test CharacterObservationUnlocksSharedContact()
    local advisorIndex
    setupOperations()
    advisorIndex = findRole(advisor)

    revealCharacter(advisorIndex, intelName)
    assert_eq 0, addContact(advisorIndex)
    assert_eq 1, setUsaObserveCharacter(0, advisorIndex)
    resolveCharacterObservationMission(0)
    assert_eq intelObserved, playerIntel%(advisorIndex)
    assert_eq reportIntel, usaReports%(0)
    assert_eq missionIdle, usaActions%(0)
    assert_eq 0, setUsaObserveCharacter(1, advisorIndex)

    assert_eq 1, setUsaContact(1, advisorIndex)
    resolveContactMission(1)
    assert_eq 1, contactCount%
    assert_eq 1, hasContact(advisorIndex)
    assert_eq reportContact, usaReports%(1)
    assert_eq 0, setUsaContact(0, advisorIndex)
end test

test ObservationRulesUseThreeToOneWeights()
    local presidentIndex, daughterIndex, advisorIndex, generalIndex, priestIndex, innkeeperIndex, landownerIndex
    setupOperations()
    presidentIndex = findRole(president)
    daughterIndex = findRole(daughter)
    advisorIndex = findRole(advisor)
    generalIndex = findRole(general)
    priestIndex = findRole(priest)
    innkeeperIndex = findRole(innkeeper)
    landownerIndex = findRole(landowner)

    assert_eq 0, observationWeight(presidentIndex, palaceLocation)
    assert_eq 3, observationWeight(generalIndex, palaceLocation)
    assert_eq 3, observationWeight(advisorIndex, palaceLocation)
    assert_eq 1, observationWeight(daughterIndex, palaceLocation)
    assert_eq 1, observationWeight(landownerIndex, palaceLocation)
    assert_eq 3, observationWeight(priestIndex, churchLocation)
    assert_eq 3, observationWeight(innkeeperIndex, pubLocation)
    assert_eq 8, observationTotalWeight(palaceLocation)
    assert_eq 8, observationTotalWeight(churchLocation)
    assert_eq 8, observationTotalWeight(pubLocation)

    characters(landownerIndex).integrity% = 3
    assert_eq 0, observationWeight(landownerIndex, churchLocation)
    characters(landownerIndex).integrity% = 4
    assert_eq 1, observationWeight(landownerIndex, churchLocation)
    characters(advisorIndex).integrity% = 8
    assert_eq 1, observationWeight(advisorIndex, pubLocation)
    characters(advisorIndex).integrity% = 9
    assert_eq 0, observationWeight(advisorIndex, pubLocation)
end test

test ObservationDiscoversAnUnknownCharacterOnlyOnce()
    local presidentIndex, daughterIndex, advisorIndex, generalIndex, landownerIndex
    setupOperations()
    presidentIndex = findRole(president)
    daughterIndex = findRole(daughter)
    advisorIndex = findRole(advisor)
    generalIndex = findRole(general)
    landownerIndex = findRole(landowner)

    assert_eq daughterIndex, observationCandidateAt(palaceLocation, 0)
    assert_eq advisorIndex, observationCandidateAt(palaceLocation, 1)
    assert_eq advisorIndex, observationCandidateAt(palaceLocation, 2)
    assert_eq advisorIndex, observationCandidateAt(palaceLocation, 3)
    assert_eq generalIndex, observationCandidateAt(palaceLocation, 4)
    assert_eq generalIndex, observationCandidateAt(palaceLocation, 6)
    assert_eq landownerIndex, observationCandidateAt(palaceLocation, 7)

    resolveObservationRoll(0, palaceLocation, 4)
    assert_eq intelName, playerIntel%(generalIndex)
    assert_eq reportDiscovery, usaReports%(0)
    assert_eq generalIndex, usaReportTargets%(0)
    assert_eq 5, observationTotalWeight(palaceLocation)
    assert_eq 0, observationWeight(generalIndex, palaceLocation)
    assert_eq intelNone, playerIntel%(presidentIndex)
end test

test ContactAllowsDeeperInvestigation()
    local presidentIndex, advisorIndex
    setupOperations()
    presidentIndex = findRole(president)
    advisorIndex = findRole(advisor)

    assert_eq 0, setUsaInvestigation(0, presidentIndex)
    addTestContact(advisorIndex)
    revealCharacter(presidentIndex, intelObserved)
    assert_eq 1, setUsaInvestigation(0, presidentIndex)
    assert_eq intelObserved, playerIntel%(presidentIndex)
    resolveInvestigationRoll(0, presidentIndex, 0)
    assert_eq intelIntegrity, playerIntel%(presidentIndex)
    assert_eq missionInvestigate, usaActions%(0)
    assert_eq reportPoliticalInsight, usaReports%(0)
    assert_eq advisorIndex, usaReportTargets%(0)
    resolveInvestigationRoll(0, presidentIndex, 0)
    assert_eq intelAgenda, playerIntel%(presidentIndex)
    assert_eq missionIdle, usaActions%(0)
    assert_eq reportPoliticalInsight, usaReports%(0)
end test

test DealsDependOnIntegrity()
    local priestIndex, targetIndex, agendaIndex
    setupOperations()
    priestIndex = findRole(priest)
    targetIndex = findRole(advisor)
    characters(targetIndex).integrity% = 6
    addTestContact(priestIndex)
    revealCharacter(targetIndex, intelObserved)

    characters(priestIndex).integrity% = 10
    assert_eq dealHonored, dealOutcomeFor(10, 9)
    assert_eq 1, setUsaDeal(0, priestIndex, targetIndex)
    assert_eq startingBudgetK, budget
    resolveDealRoll(0, 9)
    assert_eq startingBudgetK - dealCostK, budget
    assert_eq intelAgenda, playerIntel%(targetIndex)
    assert_eq reportDealHonored, usaReports%(0)
    assert_eq missionIdle, usaActions%(0)

    initializeIntelligence()
    initializeUsaActions()
    addTestContact(priestIndex)
    revealCharacter(targetIndex, intelObserved)
    characters(priestIndex).integrity% = 0
    assert_eq dealPocketed, dealOutcomeFor(0, 0)
    assert_eq 1, setUsaDeal(0, priestIndex, targetIndex)
    resolveDealRoll(0, 0)
    assert_eq startingBudgetK - dealCostK, budget
    assert_eq intelObserved, playerIntel%(targetIndex)
    assert_eq -1, characters(priestIndex).agenda%
    assert_eq reportDealFailed, usaReports%(0)

    initializeIntelligence()
    initializeUsaActions()
    addTestContact(priestIndex)
    revealCharacter(targetIndex, intelObserved)
    agendaIndex = characterAgendaCount%
    characterAgendaCount% = characterAgendaCount% + 1
    characters(priestIndex).agenda% = agendaIndex
    characterAgendas(agendaIndex).kind% = usurpRole
    characterAgendas(agendaIndex).target% = -1
    characterAgendas(agendaIndex).money = 0
    characterAgendas(agendaIndex).weapons% = 0
    assert_eq dealDiverted, dealOutcomeFor(0, 9)
    assert_eq 1, setUsaDeal(0, priestIndex, targetIndex)
    resolveDealRoll(0, 9)
    assert_eq startingBudgetK - dealCostK, budget
    assert_eq intelObserved, playerIntel%(targetIndex)
    assert_eq dealCostK, characterAgendas(agendaIndex).money
    assert_eq 1, characterAgendas(agendaIndex).weapons%
    assert_eq reportDealFailed, usaReports%(0)
end test

test DealsNeedALivingContact()
    local advisorIndex, presidentIndex, priestIndex
    setupOperations()
    advisorIndex = findRole(advisor)
    presidentIndex = findRole(president)
    priestIndex = findRole(priest)

    assert_eq 0, setUsaDeal(0, advisorIndex, presidentIndex)
    addTestContact(advisorIndex)
    revealCharacter(presidentIndex, intelObserved)
    revealCharacter(priestIndex, intelObserved)
    assert_eq 0, setUsaDeal(0, advisorIndex, priestIndex)
    assert_eq 1, setUsaDeal(1, advisorIndex, presidentIndex)
    budget = 0
    assert_eq 0, setUsaDeal(0, advisorIndex, presidentIndex)
    budget = startingBudgetK
    characters(advisorIndex).isAlive% = 0
    assert_eq 1, canApproach(presidentIndex)
    assert_eq 0, canInvestigate(presidentIndex)
    assert_eq 0, setUsaDeal(0, advisorIndex, presidentIndex)
end test
