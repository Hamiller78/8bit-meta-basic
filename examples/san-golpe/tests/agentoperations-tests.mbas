uses "../source/characters.mbas"
uses "../source/intelligence.mbas"
uses "../source/politics.mbas"
uses "../source/agentoperations.mbas"

function setupOperations()
    local characterIndex
    for characterIndex = 0 to numberOfCharacters - 1
        characters(characterIndex).role% = none
        characters(characterIndex).isAlive% = 1
        characters(characterIndex).money = 0
        characters(characterIndex).agenda% = doDuty
        characters(characterIndex).integrity% = 5
        characters(characterIndex).weapons% = 0
    next characterIndex
    characters(0).role% = usagent
    characters(1).role% = usagent
    characters(2).role% = ussragent
    characters(3).role% = ussragent
    characters(4).role% = president
    characters(5).role% = daughter
    characters(6).role% = advisor
    characters(7).role% = general
    characters(8).role% = priest
    characters(9).role% = innkeeper
    characters(10).role% = landowner
    characters(11).role% = ustourist
    initializeIntelligence()
    initializePolitics()
    initializeAgentOperations()
end function

test PresidentEconomyIsHiddenBehindQualitativeReports()
    local advisorIndex
    setupOperations()
    advisorIndex = findRole(advisor)

    assert_eq economyInitial, presidentEconomy%
    adjustPresidentEconomy(-80)
    assert_eq economyMinimum, presidentEconomy%
    adjustPresidentEconomy(140)
    assert_eq economyMaximum, presidentEconomy%
    adjustPresidentEconomy(-50)
    assert_eq economicMiddle, economicPositionBand(presidentEconomy%)

    characters(advisorIndex).integrity% = 10
    assert_eq economicMiddle, reportedPresidentEconomyBand(advisorIndex, 9, 0)
    characters(advisorIndex).integrity% = 0
    assert_eq socialistLeaning, reportedPresidentEconomyBand(advisorIndex, 0, 0)
    assert_eq freeMarketLeaning, reportedPresidentEconomyBand(advisorIndex, 0, 9)
end test

test CharacterConnectionsControlPoliticalKnowledge()
    local presidentIndex, advisorIndex, daughterIndex, generalIndex, innkeeperIndex, touristIndex
    setupOperations()
    presidentIndex = findRole(president)
    advisorIndex = findRole(advisor)
    daughterIndex = findRole(daughter)
    generalIndex = findRole(general)
    innkeeperIndex = findRole(innkeeper)
    touristIndex = findRole(ustourist)

    assert_eq 1, canCharacterKnowAbout(advisorIndex, presidentIndex)
    assert_eq 0, canCharacterKnowAbout(0, presidentIndex)
    assert_eq 0, canCharacterKnowAbout(2, presidentIndex)
    assert_eq 0, canCharacterKnowAbout(touristIndex, presidentIndex)
    assert_eq 1, canCharacterKnowAbout(advisorIndex, daughterIndex)
    assert_eq 1, canCharacterKnowAbout(advisorIndex, generalIndex)
    assert_eq 1, canCharacterKnowAbout(innkeeperIndex, generalIndex)
end test

test PresidentInvestigationUsesAnInsiderReport()
    local presidentIndex, advisorIndex
    setupOperations()
    presidentIndex = findRole(president)
    advisorIndex = findRole(advisor)

    addAgentContact(0, advisorIndex)
    revealCharacter(presidentIndex, intelName)
    characters(advisorIndex).integrity% = 10
    assert_eq 1, setAgentInvestigation(0, presidentIndex)
    resolveInvestigationRoll(0, presidentIndex, 0)
    assert_eq reportPoliticalInsight, agentReports%(0)
    assert_eq advisorIndex, agentReportTargets%(0)
    assert_eq economicMiddle, agentMissionValues%(0)
end test

test AnyLivingContactOpensThePresident()
    local presidentIndex, advisorIndex
    setupOperations()
    presidentIndex = findRole(president)
    advisorIndex = findRole(advisor)

    assert_eq 0, canApproach(0, presidentIndex)
    assert_eq 0, canInvestigate(0, presidentIndex)
    assert_eq 1, addAgentContact(0, advisorIndex)
    assert_eq 0, addAgentContact(0, advisorIndex)
    assert_eq 1, agentContactCount%(0)
    assert_eq 1, canApproach(0, presidentIndex)
    assert_eq 1, canInvestigate(0, presidentIndex)
    assert_eq 0, canApproach(1, presidentIndex)
    assert_eq 1, setAgentDeal(0, advisorIndex, presidentIndex)
end test

test ObservationRulesUseThreeToOneWeights()
    local presidentIndex, daughterIndex, advisorIndex, generalIndex, priestIndex, innkeeperIndex, landownerIndex, touristIndex
    setupOperations()
    presidentIndex = findRole(president)
    daughterIndex = findRole(daughter)
    advisorIndex = findRole(advisor)
    generalIndex = findRole(general)
    priestIndex = findRole(priest)
    innkeeperIndex = findRole(innkeeper)
    landownerIndex = findRole(landowner)
    touristIndex = findRole(ustourist)

    assert_eq 0, observationWeight(presidentIndex, palaceLocation)
    assert_eq 0, observationWeight(0, palaceLocation)
    assert_eq 0, observationWeight(1, pubLocation)
    assert_eq 3, observationWeight(generalIndex, palaceLocation)
    assert_eq 3, observationWeight(advisorIndex, palaceLocation)
    assert_eq 1, observationWeight(daughterIndex, palaceLocation)
    assert_eq 1, observationWeight(landownerIndex, palaceLocation)
    assert_eq 3, observationWeight(2, embassyLocation)
    assert_eq 3, observationWeight(3, embassyLocation)
    assert_eq 3, observationWeight(priestIndex, churchLocation)
    assert_eq 3, observationWeight(innkeeperIndex, pubLocation)
    assert_eq 1, observationWeight(touristIndex, pubLocation)
    assert_eq 8, observationTotalWeight(palaceLocation)
    assert_eq 6, observationTotalWeight(embassyLocation)
    assert_eq 8, observationTotalWeight(churchLocation)
    assert_eq 9, observationTotalWeight(pubLocation)

    characters(landownerIndex).integrity% = 3
    assert_eq 0, observationWeight(landownerIndex, churchLocation)
    characters(landownerIndex).integrity% = 4
    assert_eq 1, observationWeight(landownerIndex, churchLocation)
    characters(advisorIndex).integrity% = 8
    assert_eq 1, observationWeight(advisorIndex, pubLocation)
    characters(advisorIndex).integrity% = 9
    assert_eq 0, observationWeight(advisorIndex, pubLocation)
end test

test ObservationDiscoversAnUnknownCharacterOnlyOnce()
    local presidentIndex, daughterIndex, advisorIndex, generalIndex, landownerIndex
    setupOperations()
    presidentIndex = findRole(president)
    daughterIndex = findRole(daughter)
    advisorIndex = findRole(advisor)
    generalIndex = findRole(general)
    landownerIndex = findRole(landowner)

    assert_eq daughterIndex, observationCandidateAt(palaceLocation, 0)
    assert_eq advisorIndex, observationCandidateAt(palaceLocation, 1)
    assert_eq advisorIndex, observationCandidateAt(palaceLocation, 2)
    assert_eq advisorIndex, observationCandidateAt(palaceLocation, 3)
    assert_eq generalIndex, observationCandidateAt(palaceLocation, 4)
    assert_eq generalIndex, observationCandidateAt(palaceLocation, 6)
    assert_eq landownerIndex, observationCandidateAt(palaceLocation, 7)

    resolveObservationRoll(0, palaceLocation, 4)
    assert_eq intelName, playerIntel%(generalIndex)
    assert_eq reportDiscovery, agentReports%(0)
    assert_eq generalIndex, agentReportTargets%(0)
    assert_eq 5, observationTotalWeight(palaceLocation)
    assert_eq 0, observationWeight(generalIndex, palaceLocation)
    assert_eq intelNone, playerIntel%(presidentIndex)
end test

test ContactAllowsDeeperInvestigation()
    local presidentIndex, advisorIndex
    setupOperations()
    presidentIndex = findRole(president)
    advisorIndex = findRole(advisor)

    assert_eq 0, setAgentInvestigation(0, presidentIndex)
    addAgentContact(0, advisorIndex)
    revealCharacter(presidentIndex, intelName)
    assert_eq 1, setAgentInvestigation(0, presidentIndex)
    assert_eq intelName, playerIntel%(presidentIndex)
    resolveInvestigationRoll(0, presidentIndex, 0)
    assert_eq intelIntegrity, playerIntel%(presidentIndex)
    assert_eq missionInvestigate, agentMissions%(0)
    assert_eq reportPoliticalInsight, agentReports%(0)
    assert_eq advisorIndex, agentReportTargets%(0)
    resolveInvestigationRoll(0, presidentIndex, 0)
    assert_eq intelAgenda, playerIntel%(presidentIndex)
    assert_eq missionIdle, agentMissions%(0)
    assert_eq reportPoliticalInsight, agentReports%(0)
end test

test DealsDependOnIntegrity()
    local priestIndex
    setupOperations()
    priestIndex = findRole(priest)
    addAgentContact(0, priestIndex)

    characters(priestIndex).integrity% = 10
    assert_eq dealHonored, dealOutcomeFor(10, 9)
    assert_eq 1, setAgentDeal(0, priestIndex, priestIndex)
    assert_eq startingBudgetK, budget
    resolveDealRoll(0, 9)
    assert_eq startingBudgetK - dealCostK, budget
    assert_eq intelAgenda, playerIntel%(priestIndex)
    assert_eq reportDealHonored, agentReports%(0)
    assert_eq missionIdle, agentMissions%(0)

    initializeIntelligence()
    initializeAgentOperations()
    addAgentContact(0, priestIndex)
    characters(priestIndex).integrity% = 0
    assert_eq dealPocketed, dealOutcomeFor(0, 0)
    assert_eq 1, setAgentDeal(0, priestIndex, priestIndex)
    resolveDealRoll(0, 0)
    assert_eq startingBudgetK - dealCostK, budget
    assert_eq intelName, playerIntel%(priestIndex)
    assert_eq 0, characters(priestIndex).money
    assert_eq reportDealFailed, agentReports%(0)

    initializeIntelligence()
    initializeAgentOperations()
    addAgentContact(0, priestIndex)
    characters(priestIndex).agenda% = usurpRole
    assert_eq dealDiverted, dealOutcomeFor(0, 9)
    assert_eq 1, setAgentDeal(0, priestIndex, priestIndex)
    resolveDealRoll(0, 9)
    assert_eq startingBudgetK - dealCostK, budget
    assert_eq intelName, playerIntel%(priestIndex)
    assert_eq dealCostK, characters(priestIndex).money
    assert_eq 1, characters(priestIndex).weapons%
    assert_eq reportDealFailed, agentReports%(0)
end test

test DealsNeedALivingContact()
    local advisorIndex, presidentIndex, priestIndex
    setupOperations()
    advisorIndex = findRole(advisor)
    presidentIndex = findRole(president)
    priestIndex = findRole(priest)

    assert_eq 0, setAgentDeal(0, advisorIndex, presidentIndex)
    addAgentContact(0, advisorIndex)
    assert_eq 1, setAgentDeal(0, advisorIndex, priestIndex)
    assert_eq 0, setAgentDeal(1, advisorIndex, presidentIndex)
    budget = 0
    assert_eq 0, setAgentDeal(0, advisorIndex, presidentIndex)
    budget = startingBudgetK
    characters(advisorIndex).isAlive% = 0
    assert_eq 0, canApproach(0, presidentIndex)
    assert_eq 0, setAgentDeal(0, advisorIndex, presidentIndex)
end test
