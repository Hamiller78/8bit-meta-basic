uses "../source/characters.mbas"
uses "../source/intelligence.mbas"
uses "../source/agentoperations.mbas"
uses "../source/mainscreen.mbas"

function setupMainScreenCast()
    local characterIndex
    for characterIndex = 0 to numberOfCharacters - 1
        characters(characterIndex).first$ = "Test"
        characters(characterIndex).last$ = "Person"
        characters(characterIndex).role% = none
        characters(characterIndex).isAlive% = 1
        characters(characterIndex).agenda% = -1
    next characterIndex
    characters(0).role% = president
    characters(1).role% = daughter
    characters(2).role% = advisor
    characters(3).role% = general
    characters(4).role% = priest
    characters(5).role% = innkeeper
    characters(6).role% = landowner
end function

test UsaStartsWithTwoIdleActionSlots()
    setupMainScreenCast()
    initializeIntelligence()
    initializeUsaActions()

    assert_eq 1000, budget
    assert_eq 0, contactCount%
    assert_eq 0, hasContact(findRole(innkeeper))
    assert_eq 0, hasContact(findRole(priest))
    assert_eq 2, numberOfUsaActions
    assert_eq 2, numberOfUssrActions
    assert_eq missionIdle, usaActions%(0)
    assert_eq -1, usaTargets%(0)
    assert_eq missionIdle, usaActions%(1)
    assert_eq -1, usaTargets%(1)
end test

test OverviewUsesTheSevenCharacterCast()
    setupMainScreenCast()
    initializeIntelligence()
    initializeUsaActions()

    assert_eq 7, numberOfCharacters
end test

test OverviewUsesNamesAppropriateToScreenWidth()
    setupMainScreenCast()
    initializeIntelligence()
    characters(0).first$ = "Juan"
    characters(0).last$ = "Navarro"

    printOverviewName(0)
    if TEXT_COLUMNS >= 40 then
        assert_print "J. Navarro"
    else
        assert_print "Navarro"
    end if
end test

test OverviewShowsCompactKnowledgeState()
    setupMainScreenCast()
    initializeIntelligence()
    initializeUsaActions()

    printOverviewStatus(0)
    assert_print "UNKNOWN"
    revealCharacter(0, intelObserved)
    printOverviewStatus(0)
    assert_print "OBSERVED"
    addContact(0)
    printOverviewStatus(0)
    assert_print "CONTACTED"
    revealCharacter(0, intelAgenda)
    printOverviewAgenda(0)
    assert_print "DUTY"
end test

test OverviewIgnoresEnterWithoutDispatchError()
    setupMainScreenCast()
    initializeIntelligence()
    initializeUsaActions()

    assert_eq 0, handleOverviewChoice(KEY_ENTER)
end test

test UsaActionSlotsRemainIndependent()
    setupMainScreenCast()
    initializeIntelligence()
    initializeUsaActions()

    assert_eq 1, setUsaObserve(0, pubLocation)
    revealCharacter(findRole(advisor), intelObserved)
    assert_eq 1, addContact(findRole(advisor))
    revealCharacter(findRole(president), intelObserved)
    assert_eq 1, setUsaInvestigation(1, findRole(president))
    assert_eq missionObserve, usaActions%(0)
    assert_eq pubLocation, usaActionValues%(0)
    assert_eq missionInvestigate, usaActions%(1)
    assert_eq findRole(president), usaTargets%(1)

    setUsaIdle(0)
    assert_eq missionIdle, usaActions%(0)
    assert_eq -1, usaTargets%(0)
    assert_eq missionInvestigate, usaActions%(1)
end test

test InitialKnowledgeContainsNoForeignAgentCharacters()
    setupMainScreenCast()
    initializeIntelligence()

    assert_eq intelNone, playerIntel%(findRole(president))
    assert_eq intelNone, playerIntel%(findRole(priest))
end test

test RevealsOnlyIncreaseKnowledge()
    setupMainScreenCast()
    initializeIntelligence()

    revealCharacter(2, intelIntegrity)
    assert_eq intelIntegrity, playerIntel%(2)
    revealCharacter(2, intelName)
    assert_eq intelIntegrity, playerIntel%(2)
    revealCharacter(2, 99)
    assert_eq intelAgenda, playerIntel%(2)
    assert_eq intelNone, playerIntel%(3)
    revealCharacter(-1, intelAgenda)
    revealCharacter(numberOfCharacters, intelAgenda)
    assert_eq intelAgenda, playerIntel%(2)
end test

test IntegrityIsReportedAsThreeBands()
    assert_eq integrityLow, integrityBand(0)
    assert_eq integrityLow, integrityBand(3)
    assert_eq integrityMedium, integrityBand(4)
    assert_eq integrityMedium, integrityBand(7)
    assert_eq integrityHigh, integrityBand(8)
    assert_eq integrityHigh, integrityBand(10)
end test
