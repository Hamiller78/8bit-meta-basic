uses "../source/characters.mbas"
uses "../source/intelligence.mbas"
uses "../source/agentoperations.mbas"
uses "../source/mainscreen.mbas"

function setupMainScreenCast()
    local characterIndex
    for characterIndex = 0 to numberOfCharacters - 1
        characters(characterIndex).first$ = "Test"
        characters(characterIndex).last$ = "Person"
        characters(characterIndex).role$ = noRole$
        characters(characterIndex).isAlive% = 1
        characters(characterIndex).agenda% = -1
    next characterIndex
    characters(0).role$ = presidentRole$
    characters(1).role$ = daughterRole$
    characters(2).role$ = advisorRole$
    characters(3).role$ = generalRole$
    characters(4).role$ = priestRole$
    characters(5).role$ = innkeeperRole$
    characters(6).role$ = landownerRole$
end function

test UsaStartsWithTwoIdleActionSlots()
    setupMainScreenCast()
    initializeIntelligence()
    initializeUsaActions()

    assert_eq 1000, budget
    assert_eq 0, contactCount%
    assert_eq 0, hasContact(innkeeperCharacter)
    assert_eq 0, hasContact(priestCharacter)
    assert_eq 2, numberOfUsaActions
    assert_eq 2, numberOfUssrActions
    assert_eq missionIdle, usaActions%(0)
    assert_eq -1, usaTargets%(0)
    assert_eq missionIdle, usaActions%(1)
    assert_eq -1, usaTargets%(1)
end test

test OverviewUsesTheSevenCharacterCast()
    setupMainScreenCast()
    initializeIntelligence()
    initializeUsaActions()

    assert_eq 7, numberOfCharacters
end test

test OverviewPagesCharactersForTheScreenWidth()
    setupMainScreenCast()

    assert_eq int((TEXT_COLUMNS - overviewBoxWidth()) / 2) + 1, overviewPresidentColumn()
    assert_eq int((TEXT_COLUMNS + 1) / (overviewBoxWidth() + 1)), overviewBoxesPerPage()
    assert_eq int((overviewCharacterCount + overviewBoxesPerPage() - 1) / overviewBoxesPerPage()), overviewPageCount()
    assert_eq generalCharacter, overviewCharacterAt(0)
    assert_eq advisorCharacter, overviewCharacterAt(2)
    assert_eq priestCharacter, overviewCharacterAt(3)
    assert_eq landownerCharacter, overviewCharacterAt(5)

    assert_true overviewBoxColumn(0, overviewBoxesPerPage()) >= 1
    assert_true overviewBoxColumn(overviewBoxesPerPage() - 1, overviewBoxesPerPage()) + overviewBoxWidth() - 1 <= TEXT_COLUMNS - 1
    if overviewBoxesPerPage() > 1 then
        assert_true overviewBoxColumn(1, overviewBoxesPerPage()) >= overviewBoxColumn(0, overviewBoxesPerPage()) + overviewBoxWidth()
    end if
end test

test OverviewPagesWrapWithLeftAndRight()
    overviewPage% = 0
    assert_eq 0, handleOverviewChoice(GAME_LEFT)
    assert_eq overviewPageCount() - 1, overviewPage%
    assert_eq 0, handleOverviewChoice(GAME_RIGHT)
    assert_eq 0, overviewPage%
    assert_eq 0, handleOverviewChoice(GAME_RIGHT)
    if overviewPageCount() > 1 then
        assert_eq 1, overviewPage%
    else
        assert_eq 0, overviewPage%
    end if
end test

test OverviewUsesNamesAppropriateToScreenWidth()
    setupMainScreenCast()
    initializeIntelligence()
    characters(0).first$ = "Juan"
    characters(0).last$ = "Navarro"

    printOverviewName(0, 1, 1)
    if TEXT_COLUMNS >= 40 then
        assert_printat 1, 1, "J. Navarro  "
    else
        assert_printat 1, 1, "Navarro   "
    end if
end test

test OverviewShowsCompactKnowledgeState()
    setupMainScreenCast()
    initializeIntelligence()
    initializeUsaActions()

    printOverviewStatus(0, 1, 1)
    if TEXT_COLUMNS >= 40 then
        assert_printat 1, 1, "UNKNOWN     "
    else
        assert_printat 1, 1, "UNKNOWN   "
    end if
    revealCharacter(0, intelAlignment)
    printOverviewStatus(0, 1, 1)
    if TEXT_COLUMNS >= 40 then
        assert_printat 1, 1, "OBSERVED    "
    else
        assert_printat 1, 1, "OBSERVED  "
    end if
    addContact(0)
    printOverviewStatus(0, 1, 1)
    if TEXT_COLUMNS >= 40 then
        assert_printat 1, 1, "CONTACTED   "
    else
        assert_printat 1, 1, "CONTACTED "
    end if
    revealCharacter(0, intelAgenda)
    printOverviewAgenda(0, 1, 1)
    if TEXT_COLUMNS >= 40 then
        assert_printat 1, 1, "DUTY        "
    else
        assert_printat 1, 1, "DUTY      "
    end if
end test

test OverviewIgnoresEnterWithoutDispatchError()
    setupMainScreenCast()
    initializeIntelligence()
    initializeUsaActions()

    assert_eq 0, handleOverviewChoice(KEY_ENTER)
end test

test OverviewShowsItsAvailableActions()
    printOverviewActions()
    assert_printat 21, 1, "4 End turn"
end test

test UsaActionSlotsRemainIndependent()
    setupMainScreenCast()
    initializeIntelligence()
    initializeUsaActions()

    assert_eq 1, setUsaObserve(0, priestCharacter)
    revealCharacter(advisorCharacter, intelAlignment)
    assert_eq 1, addContact(advisorCharacter)
    revealCharacter(presidentCharacter, intelAlignment)
    assert_eq 1, setUsaInvestigation(1, presidentCharacter)
    assert_eq missionObserve, usaActions%(0)
    assert_eq priestCharacter, usaTargets%(0)
    assert_eq missionInvestigate, usaActions%(1)
    assert_eq presidentCharacter, usaTargets%(1)

    setUsaIdle(0)
    assert_eq missionIdle, usaActions%(0)
    assert_eq -1, usaTargets%(0)
    assert_eq missionInvestigate, usaActions%(1)
end test

test InitialKnowledgeStartsEmpty()
    setupMainScreenCast()
    initializeIntelligence()

    assert_eq intelNone, playerIntel%(presidentCharacter)
    assert_eq intelNone, playerIntel%(priestCharacter)
end test

test RevealsOnlyIncreaseKnowledge()
    setupMainScreenCast()
    initializeIntelligence()

    revealCharacter(2, intelIntegrity)
    assert_eq intelIntegrity, playerIntel%(2)
    revealCharacter(2, intelAlignment)
    assert_eq intelIntegrity, playerIntel%(2)
    revealCharacter(2, 99)
    assert_eq intelAgenda, playerIntel%(2)
    assert_eq intelNone, playerIntel%(3)
    revealCharacter(-1, intelAgenda)
    revealCharacter(numberOfCharacters, intelAgenda)
    assert_eq intelAgenda, playerIntel%(2)
end test

test IntegrityIsReportedAsThreeBands()
    assert_eq integrityLow, integrityBand(0)
    assert_eq integrityLow, integrityBand(3)
    assert_eq integrityMedium, integrityBand(4)
    assert_eq integrityMedium, integrityBand(7)
    assert_eq integrityHigh, integrityBand(8)
    assert_eq integrityHigh, integrityBand(10)
end test
