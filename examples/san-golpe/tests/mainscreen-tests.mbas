uses "../source/characters.mbas"
uses "../source/intelligence.mbas"
uses "../source/agentoperations.mbas"
uses "../source/mainscreen.mbas"

function setupMainScreenCast()
    local characterIndex
    for characterIndex = 0 to numberOfCharacters - 1
        characters(characterIndex).role% = none
        characters(characterIndex).isAlive% = 1
    next characterIndex
    characters(0).role% = usagent
    characters(1).role% = usagent
    characters(2).role% = ussragent
    characters(3).role% = ussragent
    characters(4).role% = president
    characters(5).role% = daughter
    characters(6).role% = advisor
    characters(7).role% = general
    characters(8).role% = priest
    characters(9).role% = bartender
    characters(10).role% = landowner
    characters(11).role% = ustourist
end function

test AgentsStartWithoutContactsOrOrders()
    setupMainScreenCast()
    initializeIntelligence()
    initializeAgentOperations()

    assert_eq 1000, budget
    assert_eq 0, agentContactCount%(0)
    assert_eq 0, agentContactCount%(1)
    assert_eq 0, hasAgentContact(0, findRole(bartender))
    assert_eq 0, hasAgentContact(1, findRole(priest))
    assert_eq missionIdle, agentMissions%(0)
    assert_eq -1, agentTargets%(0)
    assert_eq missionIdle, agentMissions%(1)
    assert_eq -1, agentTargets%(1)
end test

test OverviewOffersAgentOrdersAndTurnEnd()
    setupMainScreenCast()
    initializeIntelligence()
    initializeAgentOperations()

    showOverview(1)
    assert_print "4 End turn"
end test

test AgentOrdersRemainIndependent()
    setupMainScreenCast()
    initializeIntelligence()
    initializeAgentOperations()

    assert_eq 1, setAgentVisit(0, pubLocation)
    assert_eq 1, addAgentContact(1, findRole(advisor))
    assert_eq 1, setAgentInvestigation(1, findRole(president))
    assert_eq missionVisit, agentMissions%(0)
    assert_eq pubLocation, agentLocations%(0)
    assert_eq missionInvestigate, agentMissions%(1)
    assert_eq findRole(president), agentTargets%(1)

    setAgentIdle(0)
    assert_eq missionIdle, agentMissions%(0)
    assert_eq -1, agentTargets%(0)
    assert_eq missionInvestigate, agentMissions%(1)
end test

test PeopleAreGroupedByLocation()
    setupMainScreenCast()

    assert_eq palaceLocation, characterLocation(findRole(president))
    assert_eq palaceLocation, characterLocation(findRole(daughter))
    assert_eq palaceLocation, characterLocation(findRole(advisor))
    assert_eq militaryLocation, characterLocation(findRole(general))
    assert_eq embassyLocation, characterLocation(findRole(ussragent))
    assert_eq churchLocation, characterLocation(findRole(priest))
    assert_eq pubLocation, characterLocation(findRole(bartender))
    assert_eq pubLocation, characterLocation(findRole(ustourist))
    assert_eq outsideLocation, characterLocation(findRole(landowner))
end test

test InitialKnowledgeHidesSovietNames()
    setupMainScreenCast()
    initializeIntelligence()

    assert_eq intelName, playerIntel%(0)
    assert_eq intelName, playerIntel%(1)
    assert_eq intelNone, playerIntel%(2)
    assert_eq intelNone, playerIntel%(3)
    assert_eq intelName, playerIntel%(findRole(president))
    assert_eq intelName, playerIntel%(findRole(priest))
end test

test RevealsOnlyIncreaseKnowledge()
    setupMainScreenCast()
    initializeIntelligence()

    revealCharacter(2, intelIntegrity)
    assert_eq intelIntegrity, playerIntel%(2)
    revealCharacter(2, intelName)
    assert_eq intelIntegrity, playerIntel%(2)
    revealCharacter(2, 99)
    assert_eq intelAgenda, playerIntel%(2)
    assert_eq intelNone, playerIntel%(3)
    revealCharacter(-1, intelAgenda)
    revealCharacter(numberOfCharacters, intelAgenda)
    assert_eq intelAgenda, playerIntel%(2)
end test

test IntegrityIsReportedAsThreeBands()
    assert_eq integrityLow, integrityBand(0)
    assert_eq integrityLow, integrityBand(3)
    assert_eq integrityMedium, integrityBand(4)
    assert_eq integrityMedium, integrityBand(7)
    assert_eq integrityHigh, integrityBand(8)
    assert_eq integrityHigh, integrityBand(10)
end test
