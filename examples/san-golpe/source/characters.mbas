const numberOfCharacters = 12
const maximumCharacterAgendas = 3

enum Nationality
    native = 0
    us
    russian
end enum

enum Role
    none = 0
    usagent
    ussragent
    president
    daughter
    advisor
    general
    priest
    innkeeper
    landowner
    ustourist
end enum

enum Agenda
    doDuty = 0
    usurpRole
    findLove
    secretSpy
end enum

struct Character
    first$(10)
    last$(10)
    role%
    isAlive%   '0 = dead, 1 = alive
    integrity%  'meaning depends on role, but 0 to 10, where 10 truly believes in their role and 0 is a complete fraud
    agenda%     'index in characterAgendas(), or -1 for ordinary duty
end struct

struct CharacterAgenda
    kind%       'non-default agenda; doDuty has no record
    target%     'the character's agenda target if applicable
    money       'In k$: one unit is 1,000 US dollars.
    weapons%    'abstract units available to equip an army
end struct

dim characters as Character(numberOfCharacters)
dim characterAgendas as CharacterAgenda(maximumCharacterAgendas)
characterAgendaCount% = 0

function findRole(wantedRole)
    local characterIndex
    for characterIndex = 0 to numberOfCharacters - 1
        if characters(characterIndex).role% = wantedRole then
            return characterIndex
        end if
    next characterIndex
    return -1
end function

function isSanGolpeNative(characterIndex)
    local roleValue
    roleValue = characters(characterIndex).role%
    if roleValue = president or roleValue = daughter or roleValue = advisor or roleValue = general or roleValue = priest or roleValue = innkeeper or roleValue = landowner then
        return 1
    end if
    return 0
end function

