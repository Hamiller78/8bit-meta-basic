const numberOfCharacters = 7
const maximumCharacterAgendas = 3

const presidentCharacter = 0
const daughterCharacter = 1
const advisorCharacter = 2
const generalCharacter = 3
const priestCharacter = 4
const innkeeperCharacter = 5
const landownerCharacter = 6

const noRole$ = ""
const presidentRole$ = text$("overviewRolePresident")
const daughterRole$ = text$("overviewRoleDaughter")
const advisorRole$ = text$("overviewRoleAdvisor")
const generalRole$ = text$("overviewRoleGeneral")
const priestRole$ = text$("overviewRolePriest")
const innkeeperRole$ = text$("overviewRoleInnkeeper")
const landownerRole$ = text$("overviewRoleLandowner")

enum Agenda
    doDuty = 0
    usurpRole
    findLove
    secretSpy
end enum

struct Character
    first$(10)
    last$(10)
    role$(10)
    isAlive%   '0 = dead, 1 = alive
    integrity%  'meaning depends on role, but 0 to 10, where 10 truly believes in their role and 0 is a complete fraud
    influence%  'weight when somebody sways the President
    socialism%  'political alignment from 0 authoritarian to 100 socialist
    agenda%     'index in characterAgendas(), or -1 for ordinary duty
end struct

struct CharacterAgenda
    kind%       'non-default agenda; doDuty has no record
    target%     'the character's agenda target if applicable
    money       'In k$: one unit is 1,000 US dollars.
    weapons%    'abstract units available to equip an army
end struct

dim characters as Character(numberOfCharacters)
dim characterAgendas as CharacterAgenda(maximumCharacterAgendas)
characterAgendaCount% = 0

