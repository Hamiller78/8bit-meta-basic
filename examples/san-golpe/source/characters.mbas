const numberOfCharacters = 12

enum Gender
    any = 0
    male
    female
end enum

enum Nationality
    native = 0
    us
    russian
end enum

enum Role
    none = 0
    usagent
    ussragent
    president
    daughter
    advisor
    general
    priest
    bartender
    landowner
    ustourist
end enum

enum Agenda
    doDuty = 0
    usurpRole
    findLove
    secretSpy
end enum

enum Location
    palaceLocation = 1
    militaryLocation
    embassyLocation
    churchLocation
    pubLocation
    outsideLocation
end enum

struct Character
    first$(10)
    last$(10)
    role%
    isAlive%   '0 = dead, 1 = alive
    money       'In k$: one unit is 1,000 US dollars.
    agenda%     'most get doDuty, but some may have secret agendas
    target%     'the character's agenda target if applicable
    integrity%  'meaning depends on role, but 0 to 10, where 10 truly believes in their role and 0 is a complete fraud
    weapons%    'weapons the characters has at their disposal to equip an army, we abstract in the number of times he has acquired some
end struct

dim characters as Character(numberOfCharacters)

function findRole(wantedRole)
    local characterIndex
    for characterIndex = 0 to numberOfCharacters - 1
        if characters(characterIndex).role% = wantedRole then
            return characterIndex
        end if
    next characterIndex
    return -1
end function

function characterLocation(characterIndex)
    local roleValue
    roleValue = characters(characterIndex).role%
    if roleValue = president or roleValue = daughter or roleValue = advisor then
        return palaceLocation
    end if
    if roleValue = general then
        return militaryLocation
    end if
    if roleValue = ussragent then
        return embassyLocation
    end if
    if roleValue = priest then
        return churchLocation
    end if
    if roleValue = bartender or roleValue = ustourist then
        return pubLocation
    end if
    return outsideLocation
end function
