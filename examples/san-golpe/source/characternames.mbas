uses "characters.mbas"

const spanishMaleFirstNames = 10
const spanishFemaleFirstNames = 5
const spanishLastNames = 10
const englishMaleFirstNames = 5
const englishFemaleFirstNames = 5
const englishLastNames = 5
const russianMaleFirstNames = 5
const russianFemaleFirstNames = 5
const russianLastNames = 5

const spanishMaleNameOffset = 0
const spanishFemaleNameOffset = spanishMaleNameOffset + spanishMaleFirstNames
const spanishLastNameOffset = spanishFemaleNameOffset + spanishFemaleFirstNames
const englishMaleNameOffset = spanishLastNameOffset + spanishLastNames
const englishFemaleNameOffset = englishMaleNameOffset + englishMaleFirstNames
const englishLastNameOffset = englishFemaleNameOffset + englishFemaleFirstNames
const russianMaleNameOffset = englishLastNameOffset + englishLastNames
const russianFemaleNameOffset = russianMaleNameOffset + russianMaleFirstNames
const russianLastNameOffset = russianFemaleNameOffset + russianFemaleFirstNames

function resetNameSelection()
    spanishMaleNameIndex = int(rnd() * spanishMaleFirstNames)
    spanishFemaleNameIndex = int(rnd() * spanishFemaleFirstNames)
    spanishLastNameIndex = int(rnd() * spanishLastNames)
    englishMaleNameIndex = int(rnd() * englishMaleFirstNames)
    englishFemaleNameIndex = int(rnd() * englishFemaleFirstNames)
    englishLastNameIndex = int(rnd() * englishLastNames)
    russianMaleNameIndex = int(rnd() * russianMaleFirstNames)
    russianFemaleNameIndex = int(rnd() * russianFemaleFirstNames)
    russianLastNameIndex = int(rnd() * russianLastNames)

    spanishMaleNamesRemaining = spanishMaleFirstNames
    spanishFemaleNamesRemaining = spanishFemaleFirstNames
    spanishLastNamesRemaining = spanishLastNames
    englishMaleNamesRemaining = englishMaleFirstNames
    englishFemaleNamesRemaining = englishFemaleFirstNames
    englishLastNamesRemaining = englishLastNames
    russianMaleNamesRemaining = russianMaleFirstNames
    russianFemaleNamesRemaining = russianFemaleFirstNames
    russianLastNamesRemaining = russianLastNames
end function

'RESTORE is program-wide; character names must remain the first DATA values.
function readCharacterName$(nameOffset, nameIndex)
    local scanIndex, name$
    restore
    for scanIndex = 0 to nameOffset + nameIndex
        read name$
    next scanIndex
    return name$
end function

function availableFirstNames(nationality, gender)
    if nationality = native and gender = male then
        return spanishMaleNamesRemaining
    end if
    if nationality = native and gender = female then
        return spanishFemaleNamesRemaining
    end if
    if nationality = us and gender = male then
        return englishMaleNamesRemaining
    end if
    if nationality = us and gender = female then
        return englishFemaleNamesRemaining
    end if
    if nationality = russian and gender = male then
        return russianMaleNamesRemaining
    end if
    if nationality = russian and gender = female then
        return russianFemaleNamesRemaining
    end if
    return 0
end function

function availableLastNames(nationality)
    if nationality = native then
        return spanishLastNamesRemaining
    end if
    if nationality = us then
        return englishLastNamesRemaining
    end if
    if nationality = russian then
        return russianLastNamesRemaining
    end if
    return 0
end function

function chooseGender(nationality, requestedGender)
    local maleNames, femaleNames, selectedName

    if requestedGender <> any then
        return requestedGender
    end if

    maleNames = availableFirstNames(nationality, male)
    femaleNames = availableFirstNames(nationality, female)
    if maleNames + femaleNames = 0 then
        return any
    end if

    selectedName = int(rnd() * (maleNames + femaleNames))
    if selectedName < maleNames then
        return male
    end if
    return female
end function

function takeFirstName$(nationality, gender)
    local selectedName$

    if availableFirstNames(nationality, gender) = 0 then
        return ""
    end if

    if nationality = native and gender = male then
        selectedName$ = readCharacterName$(spanishMaleNameOffset, spanishMaleNameIndex)
        spanishMaleNameIndex = spanishMaleNameIndex + 1
        if spanishMaleNameIndex = spanishMaleFirstNames then
            spanishMaleNameIndex = 0
        end if
        spanishMaleNamesRemaining = spanishMaleNamesRemaining - 1
        return selectedName$
    end if
    if nationality = native and gender = female then
        selectedName$ = readCharacterName$(spanishFemaleNameOffset, spanishFemaleNameIndex)
        spanishFemaleNameIndex = spanishFemaleNameIndex + 1
        if spanishFemaleNameIndex = spanishFemaleFirstNames then
            spanishFemaleNameIndex = 0
        end if
        spanishFemaleNamesRemaining = spanishFemaleNamesRemaining - 1
        return selectedName$
    end if
    if nationality = us and gender = male then
        selectedName$ = readCharacterName$(englishMaleNameOffset, englishMaleNameIndex)
        englishMaleNameIndex = englishMaleNameIndex + 1
        if englishMaleNameIndex = englishMaleFirstNames then
            englishMaleNameIndex = 0
        end if
        englishMaleNamesRemaining = englishMaleNamesRemaining - 1
        return selectedName$
    end if
    if nationality = us and gender = female then
        selectedName$ = readCharacterName$(englishFemaleNameOffset, englishFemaleNameIndex)
        englishFemaleNameIndex = englishFemaleNameIndex + 1
        if englishFemaleNameIndex = englishFemaleFirstNames then
            englishFemaleNameIndex = 0
        end if
        englishFemaleNamesRemaining = englishFemaleNamesRemaining - 1
        return selectedName$
    end if
    if nationality = russian and gender = male then
        selectedName$ = readCharacterName$(russianMaleNameOffset, russianMaleNameIndex)
        russianMaleNameIndex = russianMaleNameIndex + 1
        if russianMaleNameIndex = russianMaleFirstNames then
            russianMaleNameIndex = 0
        end if
        russianMaleNamesRemaining = russianMaleNamesRemaining - 1
        return selectedName$
    end if
    if nationality = russian and gender = female then
        selectedName$ = readCharacterName$(russianFemaleNameOffset, russianFemaleNameIndex)
        russianFemaleNameIndex = russianFemaleNameIndex + 1
        if russianFemaleNameIndex = russianFemaleFirstNames then
            russianFemaleNameIndex = 0
        end if
        russianFemaleNamesRemaining = russianFemaleNamesRemaining - 1
        return selectedName$
    end if
    return ""
end function

function takeLastName$(nationality)
    local selectedName$

    if availableLastNames(nationality) = 0 then
        return ""
    end if

    if nationality = native then
        selectedName$ = readCharacterName$(spanishLastNameOffset, spanishLastNameIndex)
        spanishLastNameIndex = spanishLastNameIndex + 1
        if spanishLastNameIndex = spanishLastNames then
            spanishLastNameIndex = 0
        end if
        spanishLastNamesRemaining = spanishLastNamesRemaining - 1
        return selectedName$
    end if
    if nationality = us then
        selectedName$ = readCharacterName$(englishLastNameOffset, englishLastNameIndex)
        englishLastNameIndex = englishLastNameIndex + 1
        if englishLastNameIndex = englishLastNames then
            englishLastNameIndex = 0
        end if
        englishLastNamesRemaining = englishLastNamesRemaining - 1
        return selectedName$
    end if
    if nationality = russian then
        selectedName$ = readCharacterName$(russianLastNameOffset, russianLastNameIndex)
        russianLastNameIndex = russianLastNameIndex + 1
        if russianLastNameIndex = russianLastNames then
            russianLastNameIndex = 0
        end if
        russianLastNamesRemaining = russianLastNamesRemaining - 1
        return selectedName$
    end if
    return ""
end function

'Spanish male first names
data "Pablo", "Juan", "Carlos", "Miguel", "Diego"
data "Javier", "Luis", "Pedro", "Ramon", "Antonio"

