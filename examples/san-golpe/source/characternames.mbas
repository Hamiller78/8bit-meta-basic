uses "characters.mbas"

const spanishMaleFirstNames = 10
const daughterFirstNames = 5
const spanishLastNames = 10

const spanishMaleNameOffset = 0
const daughterFirstNameOffset = spanishMaleNameOffset + spanishMaleFirstNames
const spanishLastNameOffset = daughterFirstNameOffset + daughterFirstNames

function resetNameSelection()
    spanishMaleNameIndex = int(rnd() * spanishMaleFirstNames)
    daughterFirstNameIndex = int(rnd() * daughterFirstNames)
    spanishLastNameIndex = int(rnd() * spanishLastNames)

    spanishMaleNamesRemaining = spanishMaleFirstNames
    daughterFirstNamesRemaining = daughterFirstNames
    spanishLastNamesRemaining = spanishLastNames
end function

'RESTORE is program-wide; character names must remain the first DATA values.
function readCharacterName$(nameOffset, nameIndex)
    local scanIndex, name$
    restore
    for scanIndex = 0 to nameOffset + nameIndex
        read name$
    next scanIndex
    return name$
end function

function availableFirstNames(characterRole)
    if characterRole = daughter then
        return daughterFirstNamesRemaining
    end if
    return spanishMaleNamesRemaining
end function

function availableLastNames()
    return spanishLastNamesRemaining
end function

function takeFirstName$(characterRole)
    local selectedName$

    if availableFirstNames(characterRole) = 0 then
        return ""
    end if

    if characterRole = daughter then
        selectedName$ = readCharacterName$(daughterFirstNameOffset, daughterFirstNameIndex)
        daughterFirstNameIndex = daughterFirstNameIndex + 1
        if daughterFirstNameIndex = daughterFirstNames then
            daughterFirstNameIndex = 0
        end if
        daughterFirstNamesRemaining = daughterFirstNamesRemaining - 1
        return selectedName$
    end if
    selectedName$ = readCharacterName$(spanishMaleNameOffset, spanishMaleNameIndex)
    spanishMaleNameIndex = spanishMaleNameIndex + 1
    if spanishMaleNameIndex = spanishMaleFirstNames then
        spanishMaleNameIndex = 0
    end if
    spanishMaleNamesRemaining = spanishMaleNamesRemaining - 1
    return selectedName$
end function

function takeLastName$()
    local selectedName$

    if availableLastNames() = 0 then
        return ""
    end if

    selectedName$ = readCharacterName$(spanishLastNameOffset, spanishLastNameIndex)
    spanishLastNameIndex = spanishLastNameIndex + 1
    if spanishLastNameIndex = spanishLastNames then
        spanishLastNameIndex = 0
    end if
    spanishLastNamesRemaining = spanishLastNamesRemaining - 1
    return selectedName$
end function

'Spanish male first names
data "Pablo", "Juan", "Carlos", "Miguel", "Diego"
data "Javier", "Luis", "Pedro", "Ramon", "Antonio"

'The President's daughter's first names
data "Esmeranza", "Maria", "Carmen", "Sofia", "Lucia"

'Spanish last names
data "Gonzales", "Garcia", "Romero", "Martinez", "Lopez"
data "Navarro", "Sanchez", "Perez", "Ramirez", "Torres"
