uses "characters.mbas"
uses "politics.mbas"

const responseSocialismChange = 5

enum RoundEvent
    coffeePriceCollapse = 0
    coffeePriceBoom
    bananaBlight
    dockStrike
    foreignPlantationOffer
    missingParadeCannon
    numberOfRoundEvents
end enum

enum PresidentResponse
    responseAuthoritarian = 0
    responseBalanced
    responseSocial
end enum

currentRoundEvent% = coffeePriceCollapse
currentInfluencer% = -1
currentPresidentResponse% = responseBalanced

function initializePresidentEvents()
    currentRoundEvent% = coffeePriceCollapse
    currentInfluencer% = -1
    currentPresidentResponse% = responseBalanced
end function

function influenceWeight(characterIndex)
    if characterIndex < 0 or characterIndex >= numberOfCharacters then
        return 0
    end if
    if characters(characterIndex).role% = president or characters(characterIndex).isAlive% = 0 then
        return 0
    end if
    if characters(characterIndex).influence% < 0 then
        return 0
    end if
    return characters(characterIndex).influence%
end function

function influenceTotalWeight()
    local characterIndex, totalWeight
    totalWeight = 0
    for characterIndex = 0 to numberOfCharacters - 1
        totalWeight = totalWeight + influenceWeight(characterIndex)
    next characterIndex
    return totalWeight
end function

function influencerAt(selection)
    local characterIndex, weight
    for characterIndex = 0 to numberOfCharacters - 1
        weight = influenceWeight(characterIndex)
        if selection < weight then
            return characterIndex
        end if
        selection = selection - weight
    next characterIndex
    return -1
end function

'The two political values are added directly. The possible sum is 0..200.
function presidentResponseFor(influencerIndex)
    local presidentIndex, combinedSocialism
    presidentIndex = findRole(president)
    if presidentIndex < 0 then
        return responseBalanced
    end if
    combinedSocialism = characters(presidentIndex).socialism% * 2
    if influencerIndex >= 0 and influencerIndex < numberOfCharacters then
        combinedSocialism = characters(presidentIndex).socialism% + characters(influencerIndex).socialism%
    end if
    if combinedSocialism < 67 then
        return responseAuthoritarian
    end if
    if combinedSocialism < 134 then
        return responseBalanced
    end if
    return responseSocial
end function

function resolveRoundEvent(eventValue, influenceSelection)
    currentRoundEvent% = eventValue MOD numberOfRoundEvents
    currentInfluencer% = influencerAt(influenceSelection)
    currentPresidentResponse% = presidentResponseFor(currentInfluencer%)
    if currentPresidentResponse% = responseSocial then
        adjustPresidentSocialism(responseSocialismChange)
    end if
    if currentPresidentResponse% = responseAuthoritarian then
        adjustPresidentSocialism(-responseSocialismChange)
    end if
end function

function doPresidentTurn()
    local totalWeight
    totalWeight = influenceTotalWeight()
    resolveRoundEvent(int(rnd() * numberOfRoundEvents), int(rnd() * totalWeight))
end function

function printPresidentEvent()
    print
    print text$("presidentEventHeading")
    if currentRoundEvent% = coffeePriceCollapse then
        print_text "roundEventCoffeeCollapse"
    end if
    if currentRoundEvent% = coffeePriceBoom then
        print_text "roundEventCoffeeBoom"
    end if
    if currentRoundEvent% = bananaBlight then
        print_text "roundEventBananaBlight"
    end if
    if currentRoundEvent% = dockStrike then
        print_text "roundEventDockStrike"
    end if
    if currentRoundEvent% = foreignPlantationOffer then
        print_text "roundEventForeignPlantation"
    end if
    if currentRoundEvent% = missingParadeCannon then
        print_text "roundEventMissingCannon"
    end if
    if currentInfluencer% >= 0 then
        print text$("presidentInfluencedBy"); " "; characters(currentInfluencer%).first$; " "; characters(currentInfluencer%).last$
    end if
    if currentPresidentResponse% = responseSocial then
        print text$("presidentResponseSocial")
    end if
    if currentPresidentResponse% = responseBalanced then
        print text$("presidentResponseBalanced")
    end if
    if currentPresidentResponse% = responseAuthoritarian then
        print text$("presidentResponseAuthoritarian")
    end if
end function
