uses "characters.mbas"

const politicalMinimum = 0
const politicalMaximum = 100
const presidentSocialismInitial = 50

enum PoliticalAlignment
    stronglyAuthoritarian = 0
    authoritarianLeaning
    politicalMiddle
    socialistLeaning
    stronglySocialist
end enum

function initializePolitics()
    local presidentIndex
    presidentIndex = findRole(president)
    if presidentIndex >= 0 then
        characters(presidentIndex).socialism% = presidentSocialismInitial
        characters(presidentIndex).influence% = 0
    end if
end function

function adjustPresidentSocialism(change)
    local presidentIndex
    presidentIndex = findRole(president)
    if presidentIndex < 0 then
        return
    end if
    characters(presidentIndex).socialism% = characters(presidentIndex).socialism% + change
    if characters(presidentIndex).socialism% < politicalMinimum then
        characters(presidentIndex).socialism% = politicalMinimum
    end if
    if characters(presidentIndex).socialism% > politicalMaximum then
        characters(presidentIndex).socialism% = politicalMaximum
    end if
end function

function politicalAlignmentBand(value)
    local positionBand
    positionBand = int(value / 20)
    if positionBand > stronglySocialist then
        positionBand = stronglySocialist
    end if
    return positionBand
end function

function canCharacterKnowAbout(sourceIndex, targetIndex)
    local sourceRole, targetRole
    if sourceIndex < 0 or sourceIndex >= numberOfCharacters or targetIndex < 0 or targetIndex >= numberOfCharacters then
        return 0
    end if
    if sourceIndex = targetIndex then
        return 0
    end if
    if characters(sourceIndex).isAlive% = 0 or characters(targetIndex).isAlive% = 0 then
        return 0
    end if
    sourceRole = characters(sourceIndex).role%
    targetRole = characters(targetIndex).role%
    if targetRole = president then
        if sourceRole = general or sourceRole = advisor or sourceRole = daughter then
            return 1
        end if
        return 0
    end if
    if sourceRole = priest then
        if characters(targetIndex).integrity% > 5 then
            return 1
        end if
    end if
    if sourceRole = innkeeper then
        if characters(targetIndex).integrity% < 6 then
            return 1
        end if
    end if
    return 0
end function

'A reliable contact reports the true qualitative band. An unreliable contact
'misses by one neighboring band; directionRoll keeps the distortion unbiased.
function reportedPresidentAlignmentBand(sourceIndex, reliabilityRoll, directionRoll)
    local reportedBand, presidentIndex
    presidentIndex = findRole(president)
    if canCharacterKnowAbout(sourceIndex, presidentIndex) = 0 then
        return -1
    end if
    reportedBand = politicalAlignmentBand(characters(presidentIndex).socialism%)
    if reliabilityRoll < characters(sourceIndex).integrity% then
        return reportedBand
    end if
    if directionRoll < 5 then
        reportedBand = reportedBand - 1
    else
        reportedBand = reportedBand + 1
    end if
    if reportedBand < stronglyAuthoritarian then
        reportedBand = stronglyAuthoritarian
    end if
    if reportedBand > stronglySocialist then
        reportedBand = stronglySocialist
    end if
    return reportedBand
end function
