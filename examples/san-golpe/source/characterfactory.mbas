uses "characters.mbas"
uses "characternames.mbas"

function createAllCharacters()
    local presidentIndex, daughterIndex

    resetCharacterFactory()

    createRoleCharacter(usagent, us, male)
    createRoleCharacter(usagent, us, female)
    createRoleCharacter(ussragent, russian, male)
    createRoleCharacter(ussragent, russian, female)

    presidentIndex = createRoleCharacter(president, native, male)
    daughterIndex = createRoleCharacter(daughter, native, female)
    createRoleCharacter(advisor, native, male)
    createRoleCharacter(priest, native, male)
    createRoleCharacter(bartender, native, any)
    createRoleCharacter(landowner, native, male)
    createRoleCharacter(ustourist, us, any)

    if presidentIndex <> -1 and daughterIndex <> -1 then
        characters(daughterIndex).last$ = characters(presidentIndex).last$
    end if

    assignSecretAgendas()
end function

function createRoleCharacter(characterRole, nationality, gender)
    local characterIndex

    characterIndex = createCharacter(nationality, gender)
    if characterIndex <> -1 then
        characters(characterIndex).role% = characterRole
    end if
    return characterIndex
end function

function resetCharacterFactory()
    randomize
    initNameArrays()
    createdCharacterCount = 0
    characterFactoryInitialized = 1
end function

'Returns an index into characters(), or -1 when no name is available.
function createCharacter(nationality, gender)
    local characterIndex, actualGender, firstName$, lastName$

    if characterFactoryInitialized = 0 then
        resetCharacterFactory()
    end if

    if createdCharacterCount >= numberOfCharacters then
        return -1
    end if

    actualGender = chooseGender(nationality, gender)
    if actualGender = any then
        return -1
    end if
    if availableFirstNames(nationality, actualGender) = 0 or availableLastNames(nationality) = 0 then
        return -1
    end if

    firstName$ = takeFirstName$(nationality, actualGender)
    lastName$ = takeLastName$(nationality)
    lastName$ = trimName$(lastName$)
    if nationality = russian and actualGender = female then
        lastName$ = lastName$ + "a"
    end if
    characterIndex = createdCharacterCount

    characters(characterIndex).gender% = actualGender
    characters(characterIndex).nationality% = nationality
    characters(characterIndex).first$ = firstName$
    characters(characterIndex).last$ = lastName$
    characters(characterIndex).role% = none
    characters(characterIndex).isAlive% = 1
    characters(characterIndex).money = 0
    characters(characterIndex).agenda% = doDuty
    characters(characterIndex).target% = -1
    characters(characterIndex).integrity% = int(rnd() * 11)
    characters(characterIndex).weapons% = 0

    createdCharacterCount = createdCharacterCount + 1
    return characterIndex
end function

function assignSecretAgendas()
    local characterIndex, agendaRoll

    for characterIndex = 0 to createdCharacterCount - 1
        characters(characterIndex).agenda% = doDuty
        characters(characterIndex).target% = -1

        'Nine of twelve results keep the character focused on their normal duty.
        agendaRoll = int(rnd() * 12)
        if agendaRoll >= 9 then
            characters(characterIndex).agenda% = agendaRoll - 8
            if characters(characterIndex).agenda% = usurpRole or characters(characterIndex).agenda% = findLove then
                characters(characterIndex).target% = chooseAgendaTarget(characterIndex)
            end if
        end if
    next characterIndex
end function

function chooseAgendaTarget(characterIndex)
    local targetIndex

    if createdCharacterCount < 2 then
        return -1
    end if

    targetIndex = int(rnd() * (createdCharacterCount - 1))
    if targetIndex >= characterIndex then
        targetIndex = targetIndex + 1
    end if
    return targetIndex
end function

function trimName$(name$)
    local nameLength

    nameLength = len(name$)
    while nameLength > 0
        if mid$(name$, nameLength, 1) <> " " then
            return left$(name$, nameLength)
        end if
        nameLength = nameLength - 1
    wend
    return ""
end function
