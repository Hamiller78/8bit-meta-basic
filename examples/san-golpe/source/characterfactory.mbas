uses "characters.mbas"
uses "characternames.mbas"

const presidentInfluenceMinimum = 0
const presidentInfluenceMaximum = 0
const presidentAlignmentMinimum = 35
const presidentAlignmentMaximum = 65
const daughterInfluenceMinimum = 0
const daughterInfluenceMaximum = 10
const daughterAlignmentMinimum = 20
const daughterAlignmentMaximum = 80
const advisorInfluenceMinimum = 4
const advisorInfluenceMaximum = 8
const advisorAlignmentMinimum = 25
const advisorAlignmentMaximum = 75
const generalInfluenceMinimum = 7
const generalInfluenceMaximum = 10
const generalAlignmentMinimum = 0
const generalAlignmentMaximum = 40
const priestInfluenceMinimum = 0
const priestInfluenceMaximum = 10
const priestAlignmentMinimum = 20
const priestAlignmentMaximum = 80
const innkeeperInfluenceMinimum = 2
const innkeeperInfluenceMaximum = 6
const innkeeperAlignmentMinimum = 30
const innkeeperAlignmentMaximum = 70
const landownerInfluenceMinimum = 4
const landownerInfluenceMaximum = 8
const landownerAlignmentMinimum = 0
const landownerAlignmentMaximum = 35

function createAllCharacters(showProgress)
    local presidentIndex, daughterIndex

    resetCharacterFactory()

    presidentIndex = createRoleCharacter(presidentRole$, false, presidentInfluenceMinimum, presidentInfluenceMaximum, presidentAlignmentMinimum, presidentAlignmentMaximum, showProgress)
    daughterIndex = createRoleCharacter(daughterRole$, true, daughterInfluenceMinimum, daughterInfluenceMaximum, daughterAlignmentMinimum, daughterAlignmentMaximum, showProgress)
    createRoleCharacter(advisorRole$, false, advisorInfluenceMinimum, advisorInfluenceMaximum, advisorAlignmentMinimum, advisorAlignmentMaximum, showProgress)
    createRoleCharacter(generalRole$, false, generalInfluenceMinimum, generalInfluenceMaximum, generalAlignmentMinimum, generalAlignmentMaximum, showProgress)
    createRoleCharacter(priestRole$, false, priestInfluenceMinimum, priestInfluenceMaximum, priestAlignmentMinimum, priestAlignmentMaximum, showProgress)
    createRoleCharacter(innkeeperRole$, false, innkeeperInfluenceMinimum, innkeeperInfluenceMaximum, innkeeperAlignmentMinimum, innkeeperAlignmentMaximum, showProgress)
    createRoleCharacter(landownerRole$, false, landownerInfluenceMinimum, landownerInfluenceMaximum, landownerAlignmentMinimum, landownerAlignmentMaximum, showProgress)

    if presidentIndex <> -1 and daughterIndex <> -1 then
        characters(daughterIndex).last$ = characters(presidentIndex).last$
    end if

    assignSecretAgendas()
end function

function createRoleCharacter(characterRole$, usesDaughterNames, influenceMinimum, influenceMaximum, alignmentMinimum, alignmentMaximum, showProgress)
    local characterIndex

    characterIndex = createCharacter(characterRole$, usesDaughterNames, influenceMinimum, influenceMaximum, alignmentMinimum, alignmentMaximum)
    if characterIndex <> -1 then
        if showProgress then
            set_pos int(TEXT_ROWS / 2) + 2, 1
            print_centered text$("creatingCharactersProgress"); created = createdCharacterCount, 2; total = numberOfCharacters, 2
        end if
    end if
    return characterIndex
end function

function resetCharacterFactory()
    randomize
    resetNameSelection()
    characterAgendaCount% = 0
    createdCharacterCount = 0
    characterFactoryInitialized = 1
end function

'Returns an index into characters(), or -1 when no name is available.
function createCharacter(characterRole$, usesDaughterNames, influenceMinimum, influenceMaximum, alignmentMinimum, alignmentMaximum)
    local characterIndex, firstName$, lastName$

    if characterFactoryInitialized = 0 then
        resetCharacterFactory()
    end if

    if createdCharacterCount >= numberOfCharacters then
        return -1
    end if

    if availableFirstNames(usesDaughterNames) = 0 then
        return -1
    end if
    if usesDaughterNames = 0 and availableLastNames() = 0 then
        return -1
    end if

    firstName$ = takeFirstName$(usesDaughterNames)
    lastName$ = ""
    if usesDaughterNames = 0 then
        lastName$ = takeLastName$()
    end if
    characterIndex = createdCharacterCount

    characters(characterIndex).first$ = firstName$
    characters(characterIndex).last$ = lastName$
    characters(characterIndex).role$ = characterRole$
    characters(characterIndex).isAlive% = 1
    characters(characterIndex).integrity% = int(rnd() * 11)
    characters(characterIndex).influence% = randomInitialValue(influenceMinimum, influenceMaximum)
    characters(characterIndex).socialism% = randomInitialValue(alignmentMinimum, alignmentMaximum)
    characters(characterIndex).agenda% = -1

    createdCharacterCount = createdCharacterCount + 1
    return characterIndex
end function

function randomInitialValue(minimumValue, maximumValue)
    return minimumValue + int(rnd() * (maximumValue - minimumValue + 1))
end function

function assignSecretAgendas()
    local characterIndex, agendaIndex, agendaRoll, agendaKind, targetIndex

    characterAgendaCount% = 0
    for characterIndex = 0 to createdCharacterCount - 1
        characters(characterIndex).agenda% = -1
        'Nine of twelve results keep the character focused on their normal duty.
        agendaRoll = int(rnd() * 12)
        if agendaRoll >= 9 and characterAgendaCount% < maximumCharacterAgendas then
            agendaKind = agendaRoll - 8
            targetIndex = -1
            if agendaKind = usurpRole or agendaKind = findLove then
                targetIndex = chooseAgendaTarget(characterIndex)
            end if
            agendaIndex = characterAgendaCount%
            characterAgendaCount% = characterAgendaCount% + 1
            characters(characterIndex).agenda% = agendaIndex
            characterAgendas(agendaIndex).kind% = agendaKind
            characterAgendas(agendaIndex).target% = targetIndex
            characterAgendas(agendaIndex).money = 0
            characterAgendas(agendaIndex).weapons% = 0
        end if
    next characterIndex
end function

function chooseAgendaTarget(characterIndex)
    local targetIndex

    if createdCharacterCount < 2 then
        return -1
    end if

    targetIndex = int(rnd() * (createdCharacterCount - 1))
    if targetIndex >= characterIndex then
        targetIndex = targetIndex + 1
    end if
    return targetIndex
end function
