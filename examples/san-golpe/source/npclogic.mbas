uses "characters.mbas"

dim npcEventActors%(numberOfCharacters)
dim npcEventTargets%(numberOfCharacters)
numberOfNpcEvents% = 0

function doNpcActions()
    local eventNpcIndex%, eventTargetIndex%
    cls
    numberOfNpcEvents% = 0
    for npcIndex% = 0 to numberOfCharacters - 1
        if characters(npcIndex%).isAlive% = 1 then
            doNpcAction(npcIndex%)
        end if
    next npcIndex%

    print_text "npcEventsHeading"
    if numberOfNpcEvents% > 0 then
        for i% = 0 to numberOfNpcEvents% - 1
            eventNpcIndex% = npcEventActors%(i%)
            eventTargetIndex% = npcEventTargets%(i%)
            print characters(eventNpcIndex%).first$; " "; characters(eventNpcIndex%).last$; text$("npcRanAwayWith"); characters(eventTargetIndex%).first$; " "; characters(eventTargetIndex%).last$; text$("npcRanAwaySuffix")
        next i%
    else
        print_text "npcQuietMonth"
    end if
end function

function doNpcAction(npcIndex%)
    local npcRole%, npcAgenda%, targetIndex%
    npcRole% = characters(npcIndex%).role%
    npcAgenda% = characters(npcIndex%).agenda%
    targetIndex% = characters(npcIndex%).target%

    if npcAgenda% = Agenda.findLove and characters(npcIndex%).money > 0 then
        if targetIndex% <> -1 and characters(targetIndex%).isAlive% = 1 then
            npcEventActors%(numberOfNpcEvents%) = npcIndex%
            npcEventTargets%(numberOfNpcEvents%) = targetIndex%
        end if
    end if
    'TODO: Implement other NPC agendas and actions here.

end function
