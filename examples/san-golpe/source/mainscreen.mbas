uses "characters.mbas"
uses "intelligence.mbas"
uses "agentoperations.mbas"
uses "politics.mbas"

overviewUssrSelection% = 0

function showOverview(turnNumber)
    local presidentIndex, generalIndex, daughterIndex, advisorIndex
    local priestIndex, innkeeperIndex, landownerIndex, ussrIndex
    local leftColumn, middleColumn, rightColumn

    cls
    set_pos 1, 1
    print text$("overviewTurnKey"); turnNumber; " $"; budget; "K 1/2"; text$("overviewAgentsKey"); " 3"; text$("overviewPeopleKey"); " 4"; text$("overviewEndKey");

    set_pos 2, 1
    print_centered text$("overviewGovernment")

    if TEXT_COLUMNS >= 40 then
        leftColumn = 1
        middleColumn = 15
        rightColumn = 29
    else
        leftColumn = 1
        middleColumn = 12
        rightColumn = 23
    end if

    presidentIndex = findRole(president)
    generalIndex = findRole(general)
    daughterIndex = findRole(daughter)
    advisorIndex = findRole(advisor)
    priestIndex = findRole(priest)
    innkeeperIndex = findRole(innkeeper)
    landownerIndex = findRole(landowner)

    printOverviewCharacterAt(presidentIndex, 3, middleColumn)
    set_pos 7, int(TEXT_COLUMNS / 2)
    print "+";
    set_pos 8, 1
    if TEXT_COLUMNS >= 40 then
        print_centered "+------------+------------+"
    else
        print_centered "+----------+----------+"
    end if
    printOverviewCharacterAt(generalIndex, 9, leftColumn)
    printOverviewCharacterAt(daughterIndex, 9, middleColumn)
    printOverviewCharacterAt(advisorIndex, 9, rightColumn)

    set_pos 13, 1
    print_centered text$("overviewOtherFigures")
    printOverviewCharacterAt(priestIndex, 14, leftColumn)
    printOverviewCharacterAt(innkeeperIndex, 14, middleColumn)
    printOverviewCharacterAt(landownerIndex, 14, rightColumn)

    set_pos 18, 1
    print "5 "; text$("overviewUssrActivity"); " "; overviewUssrSelection% + 1; "/2";
    ussrIndex = findUssrAgent(overviewUssrSelection%)
    printOverviewCharacterAt(ussrIndex, 19, leftColumn)
end function

function printOverviewCharacterAt(characterIndex, firstRow, firstColumn)
    set_pos firstRow, firstColumn
    printOverviewName(characterIndex)
    set_pos firstRow + 1, firstColumn
    printOverviewRole(characterIndex)
    set_pos firstRow + 2, firstColumn
    printOverviewAgenda(characterIndex)
    set_pos firstRow + 3, firstColumn
    printOverviewStatus(characterIndex)
end function

function printOverviewName(characterIndex)
    if characterIndex < 0 then
        print text$("overviewUnknownShort");
        return
    end if
    if characters(characterIndex).role% = ussragent and playerIntel%(characterIndex) < intelName then
        print text$("overviewUnknownShort");
        return
    end if
    if TEXT_COLUMNS >= 40 then
        print left$(characters(characterIndex).first$, 1); ". "; characters(characterIndex).last$;
    else
        print characters(characterIndex).last$;
    end if
end function

function printOverviewRole(characterIndex)
    local roleValue
    roleValue = characters(characterIndex).role%
    if roleValue = president then
        print text$("overviewRolePresident");
    end if
    if roleValue = daughter then
        print text$("overviewRoleDaughter");
    end if
    if roleValue = advisor then
        print text$("overviewRoleAdvisor");
    end if
    if roleValue = general then
        print text$("overviewRoleGeneral");
    end if
    if roleValue = priest then
        print text$("overviewRolePriest");
    end if
    if roleValue = innkeeper then
        print text$("overviewRoleInnkeeper");
    end if
    if roleValue = landowner then
        print text$("overviewRoleLandowner");
    end if
    if roleValue = ussragent then
        print text$("overviewRoleUssrAgent");
    end if
end function

function printOverviewAgenda(characterIndex)
    local agendaIndex, agendaValue
    if playerIntel%(characterIndex) < intelAgenda then
        print text$("overviewUnknownShort");
        return
    end if
    agendaIndex = characters(characterIndex).agenda%
    agendaValue = doDuty
    if agendaIndex >= 0 then
        agendaValue = characterAgendas(agendaIndex).kind%
    end if
    if agendaValue = doDuty then
        print text$("overviewAgendaDuty");
    end if
    if agendaValue = usurpRole then
        print text$("overviewAgendaPower");
    end if
    if agendaValue = findLove then
        print text$("overviewAgendaLove");
    end if
    if agendaValue = secretSpy then
        print text$("overviewAgendaSpy");
    end if
end function

function printOverviewStatus(characterIndex)
    local intelValue
    if characters(characterIndex).isAlive% = 0 then
        print text$("overviewStatusDead");
        return
    end if
    if hasContact(characterIndex) = 1 then
        print text$("overviewStatusContacted");
        return
    end if
    intelValue = playerIntel%(characterIndex)
    if intelValue = intelNone then
        print text$("overviewUnknownShort");
    end if
    if intelValue = intelName then
        print text$("overviewStatusDiscovered");
    end if
    if intelValue = intelObserved then
        print text$("overviewStatusObserved");
    end if
    if intelValue = intelIntegrity then
        print text$("overviewStatusAssessed");
    end if
    if intelValue = intelAgenda then
        print text$("overviewStatusKnown");
    end if
end function

function findUssrAgent(selection)
    local characterIndex, foundCount
    foundCount = 0
    for characterIndex = 0 to numberOfCharacters - 1
        if characters(characterIndex).role% = ussragent then
            if foundCount = selection then
                return characterIndex
            end if
            foundCount = foundCount + 1
        end if
    next characterIndex
    return -1
end function

function printAgentReports()
    local agentIndex, targetIndex, reportValue
    if agentReports%(0) = reportNone and agentReports%(1) = reportNone then
        return
    end if
    print
    print text$("agentReportsHeading")
    for agentIndex = 0 to numberOfAgents - 1
        reportValue = agentReports%(agentIndex)
        if reportValue <> reportNone then
            print agentIndex + 1; " ";
            if reportValue = reportNoLead then
                print text$("reportNoLead");
            end if
            if reportValue = reportDiscovery then
                print text$("reportDiscovery");
            end if
            if reportValue = reportIntel then
                print text$("reportIntel");
            end if
            if reportValue = reportContact then
                print text$("reportContact");
            end if
            if reportValue = reportDealHonored then
                print text$("reportDealHonored");
            end if
            if reportValue = reportDealFailed then
                print text$("reportDealFailed");
            end if
            if reportValue = reportNoFunds then
                print text$("reportNoFunds");
            end if
            if reportValue = reportPoliticalInsight then
                printKnownFirstName(agentReportTargets%(agentIndex))
                print ": "; text$("reportPresidentThinking"); " ";
                printEconomicPosition(agentMissionValues%(agentIndex))
            end if
            targetIndex = agentReportTargets%(agentIndex)
            if targetIndex >= 0 and reportValue <> reportDealFailed and reportValue <> reportPoliticalInsight then
                print " ";
                printKnownFirstName(targetIndex)
            end if
            print
        end if
    next agentIndex
end function

'Returns 1 only when the player ends the turn.
function handleOverviewInput()
    local choice
    choice = getInput()
    return handleOverviewChoice(choice)
end function

function handleOverviewChoice(choice)
    if choice = KEY_1 then
        showAgentMenu(0)
    end if
    if choice = KEY_2 then
        showAgentMenu(1)
    end if
    if choice = KEY_3 then
        browsePeople()
    end if
    if choice = KEY_4 then
        return 1
    end if
    if choice = KEY_5 then
        overviewUssrSelection% = 1 - overviewUssrSelection%
    end if
    return 0
end function

function showAgentMenu(agentIndex)
    local choice, characterIndex

    repeat
        cls
        print_centered text$("overviewAgentHeading")
        printKnownName(agentIndex)
        print
        print
        print text$("overviewContacts"); ": "; contactCount%
        for characterIndex = 2 to numberOfCharacters - 1
            if hasContact(characterIndex) = 1 then
                printKnownName(characterIndex)
                print
            end if
        next characterIndex
        print
        print text$("overviewCurrentMission")
        printMissionName(agentMissions%(agentIndex))
        print
        if agentMissions%(agentIndex) = missionObserve then
            printLocationName(agentMissionValues%(agentIndex))
            print
        end if
        if agentTargets%(agentIndex) >= 0 then
            printKnownName(agentTargets%(agentIndex))
            print
        end if
        print
        print "1 "; text$("overviewAssignMission")
        print "0 "; text$("overviewBack")
        choice = getInput()
        if choice = KEY_1 then
            chooseMission(agentIndex)
        end if
    until choice = KEY_0
end function

function chooseMission(agentIndex)
    local choice, selectedLocation, selectedContact, selectedPerson

    cls
    print_centered text$("overviewMissionHeading")
    print "1 "; text$("missionObserve")
    print "2 "; text$("missionObserveCharacter")
    print "3 "; text$("missionContact")
    print "4 "; text$("missionInvestigate")
    print "5 "; text$("missionDeal")
    print "6 "; text$("missionIdle")
    print "0 "; text$("overviewBack")
    choice = getInput()

    if choice = KEY_1 then
        selectedLocation = chooseLocation()
        if selectedLocation > 0 then
            setAgentObserve(agentIndex, selectedLocation)
        end if
    end if
    if choice = KEY_2 then
        selectedPerson = choosePerson()
        if selectedPerson >= 0 then
            if setAgentObserveCharacter(agentIndex, selectedPerson) = 0 then
                showOrderMessage(3)
            end if
        end if
    end if
    if choice = KEY_3 then
        selectedPerson = choosePerson()
        if selectedPerson >= 0 then
            if setAgentContact(agentIndex, selectedPerson) = 0 then
                showOrderMessage(4)
            end if
        end if
    end if
    if choice = KEY_4 then
        selectedPerson = choosePerson()
        if selectedPerson >= 0 then
            if setAgentInvestigation(agentIndex, selectedPerson) = 0 then
                showOrderMessage(1)
            end if
        end if
    end if
    if choice = KEY_5 then
        if budget < dealCostK then
            showOrderMessage(2)
        else
            selectedContact = chooseContact()
            if selectedContact >= 0 then
                selectedPerson = choosePerson()
                if selectedPerson >= 0 then
                    if setAgentDeal(agentIndex, selectedContact, selectedPerson) = 0 then
                        showOrderMessage(1)
                    end if
                end if
            end if
        end if
    end if
    if choice = KEY_6 then
        setAgentIdle(agentIndex)
    end if
end function

function showOrderMessage(messageKind)
    cls
    if messageKind = 1 then
        print_text "orderNeedsContact"
    end if
    if messageKind = 2 then
        print_text "orderNoFunds"
    end if
    if messageKind = 3 then
        print_text "orderCannotObserve"
    end if
    if messageKind = 4 then
        print_text "orderCannotContact"
    end if
    print
    print text$("continue")
    getInput()
end function

function chooseContact()
    local characterIndex, listedCount, choice, chosenNumber

    cls
    print_centered text$("overviewContacts")
    listedCount = 0
    for characterIndex = 2 to numberOfCharacters - 1
        if hasContact(characterIndex) = 1 then
            listedCount = listedCount + 1
            if listedCount < 10 then
                print listedCount; " ";
            else
                print "A ";
            end if
            printKnownName(characterIndex)
            print
        end if
    next characterIndex
    if listedCount = 0 then
        print text$("overviewNone")
    end if
    print "0 "; text$("overviewBack")
    choice = getInput()
    chosenNumber = keyDigit(choice)
    if choice = KEY_A then
        chosenNumber = 10
    end if
    if chosenNumber < 1 or chosenNumber > listedCount then
        return -1
    end if
    listedCount = 0
    for characterIndex = 2 to numberOfCharacters - 1
        if hasContact(characterIndex) = 1 then
            listedCount = listedCount + 1
            if listedCount = chosenNumber then
                return characterIndex
            end if
        end if
    next characterIndex
    return -1
end function

function browsePeople()
    local chosenPerson
    repeat
        chosenPerson = choosePerson()
        if chosenPerson >= 0 then
            showCharacterCard(chosenPerson)
        end if
    until chosenPerson < 0
end function

function choosePerson()
    local characterIndex, listedCount, choice, chosenNumber

    cls
    print_centered text$("overviewPeopleHeading")
    listedCount = 0
    for characterIndex = 2 to numberOfCharacters - 1
        if playerIntel%(characterIndex) >= intelName then
            listedCount = listedCount + 1
            if listedCount < 10 then
                print listedCount; " ";
            else
                print "A ";
            end if
            printKnownName(characterIndex)
            print
        end if
    next characterIndex
    if listedCount = 0 then
        print text$("overviewNoPeople")
    end if
    print
    print text$("overviewSelectPerson")
    print "0 "; text$("overviewBack")
    choice = getInput()
    chosenNumber = keyDigit(choice)
    if choice = KEY_A then
        chosenNumber = 10
    end if
    if chosenNumber < 1 or chosenNumber > listedCount then
        return -1
    end if
    listedCount = 0
    for characterIndex = 2 to numberOfCharacters - 1
        if playerIntel%(characterIndex) >= intelName then
            listedCount = listedCount + 1
            if listedCount = chosenNumber then
                return characterIndex
            end if
        end if
    next characterIndex
    return -1
end function

function chooseLocation()
    local choice
    cls
    print_centered text$("locationHeading")
    print "1 "; text$("locationPalace")
    print "2 "; text$("locationEmbassy")
    print "3 "; text$("locationChurch")
    print "4 "; text$("locationPub")
    print "0 "; text$("overviewBack")
    choice = getInput()
    if choice = KEY_1 then
        return palaceLocation
    end if
    if choice = KEY_2 then
        return embassyLocation
    end if
    if choice = KEY_3 then
        return churchLocation
    end if
    if choice = KEY_4 then
        return pubLocation
    end if
    return 0
end function

function showCharacterCard(characterIndex)
    local agendaIndex
    cls
    print_centered text$("overviewPersonHeading")
    printKnownName(characterIndex)
    print
    print text$("intelLevelLabel"); ": "; playerIntel%(characterIndex); "/4"
    print text$("overviewContacts"); ": ";
    if hasContact(characterIndex) = 1 then
        print "1";
    else
        print text$("overviewNone");
    end if
    print
    if playerIntel%(characterIndex) >= intelIntegrity then
        print text$("intelIntegrityLabel"); ": ";
        printIntegrityBand(integrityBand(characters(characterIndex).integrity%))
        print
    end if
    if playerIntel%(characterIndex) >= intelAgenda then
        print text$("intelAgendaLabel"); ": ";
        agendaIndex = characters(characterIndex).agenda%
        if agendaIndex < 0 then
            printAgenda(doDuty)
        else
            printAgenda(characterAgendas(agendaIndex).kind%)
        end if
        print
    end if
    print
    print text$("continue")
    getInput()
end function

function printLocationName(locationValue)
    if locationValue = palaceLocation then
        print text$("locationPalace");
    end if
    if locationValue = embassyLocation then
        print text$("locationEmbassy");
    end if
    if locationValue = churchLocation then
        print text$("locationChurch");
    end if
    if locationValue = pubLocation then
        print text$("locationPub");
    end if
end function

function printIntegrityBand(band)
    if band = integrityLow then
        print text$("intelLow");
    end if
    if band = integrityMedium then
        print text$("intelMedium");
    end if
    if band = integrityHigh then
        print text$("intelHigh");
    end if
end function

function printAgenda(agendaValue)
    if agendaValue = doDuty then
        print text$("agendaDuty");
    end if
    if agendaValue = usurpRole then
        print text$("agendaUsurp");
    end if
    if agendaValue = findLove then
        print text$("agendaLove");
    end if
    if agendaValue = secretSpy then
        print text$("agendaSpy");
    end if
end function

function printMissionName(missionValue)
    if missionValue = missionObserve then
        print text$("missionObserve");
    end if
    if missionValue = missionObserveCharacter then
        print text$("missionObserveCharacter");
    end if
    if missionValue = missionContact then
        print text$("missionContact");
    end if
    if missionValue = missionInvestigate then
        print text$("missionInvestigate");
    end if
    if missionValue = missionDeal then
        print text$("missionDeal");
    end if
    if missionValue = missionIdle then
        print text$("missionIdle");
    end if
end function

function printEconomicPosition(positionValue)
    if positionValue = stronglySocialist then
        print text$("economyStronglySocialist");
    end if
    if positionValue = socialistLeaning then
        print text$("economySocialistLeaning");
    end if
    if positionValue = economicMiddle then
        print text$("economyMiddle");
    end if
    if positionValue = freeMarketLeaning then
        print text$("economyFreeMarketLeaning");
    end if
    if positionValue = stronglyFreeMarket then
        print text$("economyStronglyFreeMarket");
    end if
end function

function keyDigit(keyValue)
    if keyValue = KEY_1 then
        return 1
    end if
    if keyValue = KEY_2 then
        return 2
    end if
    if keyValue = KEY_3 then
        return 3
    end if
    if keyValue = KEY_4 then
        return 4
    end if
    if keyValue = KEY_5 then
        return 5
    end if
    if keyValue = KEY_6 then
        return 6
    end if
    if keyValue = KEY_7 then
        return 7
    end if
    if keyValue = KEY_8 then
        return 8
    end if
    if keyValue = KEY_9 then
        return 9
    end if
    return 0
end function

function getInput()
    local inputKey
    repeat
        inputKey = key_code()
    until inputKey = KEY_NONE
    repeat
        inputKey = key_code()
    until inputKey <> KEY_NONE
    return inputKey
end function
