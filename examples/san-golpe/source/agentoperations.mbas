uses "characters.mbas"
uses "intelligence.mbas"
uses "politics.mbas"

const numberOfUsaActions = 2
const numberOfUssrActions = 2
const startingBudgetK = 1000
const dealCostK = 10
const investigationChance = 50

enum ObservationLocation
    palaceLocation = 1
    churchLocation
    pubLocation
end enum

enum UsaActionKind
    missionIdle = 0
    missionObserve
    missionObserveCharacter
    missionContact
    missionInvestigate
    missionDeal
end enum

enum UsaActionReport
    reportNone = 0
    reportNoLead
    reportDiscovery
    reportIntel
    reportContact
    reportDealHonored
    reportDealFailed
    reportNoFunds
    reportPoliticalInsight
end enum

enum DealOutcome
    dealHonored = 0
    dealPocketed
    dealDiverted
end enum

budget = 0
dim contacts%(numberOfCharacters)
contactCount% = 0
dim usaActions%(numberOfUsaActions)
dim usaTargets%(numberOfUsaActions)
dim usaActionValues%(numberOfUsaActions)
dim usaDealContacts%(numberOfUsaActions)
dim usaReports%(numberOfUsaActions)
dim usaReportTargets%(numberOfUsaActions)

function initializeUsaActions()
    local actionIndex, characterIndex

    budget = startingBudgetK
    contactCount% = 0
    for characterIndex = 0 to numberOfCharacters - 1
        contacts%(characterIndex) = 0
    next characterIndex
    for actionIndex = 0 to numberOfUsaActions - 1
        usaActions%(actionIndex) = missionIdle
        usaTargets%(actionIndex) = -1
        usaActionValues%(actionIndex) = 0
        usaDealContacts%(actionIndex) = -1
        usaReports%(actionIndex) = reportNone
        usaReportTargets%(actionIndex) = -1
    next actionIndex
end function

function hasContact(characterIndex)
    if characterIndex < 0 or characterIndex >= numberOfCharacters then
        return 0
    end if
    return contacts%(characterIndex)
end function

function firstContact()
    local characterIndex
    for characterIndex = 0 to numberOfCharacters - 1
        if hasContact(characterIndex) = 1 and characters(characterIndex).isAlive% = 1 then
            return characterIndex
        end if
    next characterIndex
    return -1
end function

function firstContactFor(characterIndex)
    local contactIndex
    for contactIndex = 0 to numberOfCharacters - 1
        if hasContact(contactIndex) = 1 then
            if canCharacterKnowAbout(contactIndex, characterIndex) = 1 then
                return contactIndex
            end if
        end if
    next contactIndex
    return -1
end function

function addContact(characterIndex)
    if characterIndex < 0 or characterIndex >= numberOfCharacters then
        return 0
    end if
    if characters(characterIndex).isAlive% = 0 then
        return 0
    end if
    if playerIntel%(characterIndex) < intelObserved then
        return 0
    end if
    if hasContact(characterIndex) = 1 then
        return 0
    end if
    contacts%(characterIndex) = 1
    contactCount% = contactCount% + 1
    return 1
end function

'The placeholder investigation logic requires any living contact.
function canApproach(characterIndex)
    if characterIndex < 0 or characterIndex >= numberOfCharacters then
        return 0
    end if
    if characters(characterIndex).isAlive% = 0 then
        return 0
    end if
    return 1
end function

function canInvestigate(characterIndex)
    if canApproach(characterIndex) = 0 then
        return 0
    end if
    if playerIntel%(characterIndex) < intelObserved then
        return 0
    end if
    if firstContactFor(characterIndex) >= 0 then
        return 1
    end if
    return 0
end function

'Common characters carry weight 3 and rare characters weight 1.
function observationWeight(characterIndex, locationValue)
    local roleValue
    if characterIndex < 0 or characterIndex >= numberOfCharacters then
        return 0
    end if
    if characters(characterIndex).isAlive% = 0 or playerIntel%(characterIndex) >= intelName then
        return 0
    end if
    roleValue = characters(characterIndex).role%
    if roleValue = president then
        return 0
    end if
    if locationValue = palaceLocation then
        if roleValue = general or roleValue = advisor then
            return 3
        end if
        if roleValue = daughter or roleValue = landowner then
            return 1
        end if
        return 0
    end if
    if locationValue = churchLocation then
        if roleValue = priest then
            return 3
        end if
        if characters(characterIndex).integrity% > 3 then
            return 1
        end if
        return 0
    end if
    if locationValue = pubLocation then
        if roleValue = innkeeper then
            return 3
        end if
        if characters(characterIndex).integrity% < 9 then
            return 1
        end if
    end if
    return 0
end function

function observationTotalWeight(locationValue)
    local characterIndex, totalWeight
    totalWeight = 0
    for characterIndex = 0 to numberOfCharacters - 1
        totalWeight = totalWeight + observationWeight(characterIndex, locationValue)
    next characterIndex
    return totalWeight
end function

function observationCandidateAt(locationValue, selection)
    local characterIndex, weight
    for characterIndex = 0 to numberOfCharacters - 1
        weight = observationWeight(characterIndex, locationValue)
        if selection < weight then
            return characterIndex
        end if
        selection = selection - weight
    next characterIndex
    return -1
end function

function setUsaObserve(actionIndex, locationValue)
    if actionIndex < 0 or actionIndex >= numberOfUsaActions then
        return 0
    end if
    if locationValue < palaceLocation or locationValue > pubLocation then
        return 0
    end if
    usaActions%(actionIndex) = missionObserve
    usaActionValues%(actionIndex) = locationValue
    usaTargets%(actionIndex) = -1
    usaDealContacts%(actionIndex) = -1
    return 1
end function

function setUsaObserveCharacter(actionIndex, characterIndex)
    if actionIndex < 0 or actionIndex >= numberOfUsaActions then
        return 0
    end if
    if characterIndex < 0 or characterIndex >= numberOfCharacters then
        return 0
    end if
    if characters(characterIndex).isAlive% = 0 then
        return 0
    end if
    if playerIntel%(characterIndex) <> intelName then
        return 0
    end if
    usaActions%(actionIndex) = missionObserveCharacter
    usaActionValues%(actionIndex) = 0
    usaTargets%(actionIndex) = characterIndex
    usaDealContacts%(actionIndex) = -1
    return 1
end function

function setUsaContact(actionIndex, characterIndex)
    if actionIndex < 0 or actionIndex >= numberOfUsaActions then
        return 0
    end if
    if characterIndex < 0 or characterIndex >= numberOfCharacters then
        return 0
    end if
    if characters(characterIndex).isAlive% = 0 then
        return 0
    end if
    if playerIntel%(characterIndex) < intelObserved or hasContact(characterIndex) = 1 then
        return 0
    end if
    usaActions%(actionIndex) = missionContact
    usaActionValues%(actionIndex) = 0
    usaTargets%(actionIndex) = characterIndex
    usaDealContacts%(actionIndex) = -1
    return 1
end function

function setUsaInvestigation(actionIndex, characterIndex)
    if canInvestigate(characterIndex) = 0 then
        return 0
    end if
    usaActions%(actionIndex) = missionInvestigate
    usaActionValues%(actionIndex) = 0
    usaTargets%(actionIndex) = characterIndex
    usaDealContacts%(actionIndex) = -1
    return 1
end function

function setUsaDeal(actionIndex, contactIndex, targetIndex)
    if budget < dealCostK then
        return 0
    end if
    if hasContact(contactIndex) = 0 then
        return 0
    end if
    if characters(contactIndex).isAlive% = 0 then
        return 0
    end if
    if canCharacterKnowAbout(contactIndex, targetIndex) = 0 then
        return 0
    end if
    if canInvestigate(targetIndex) = 0 then
        return 0
    end if
    usaActions%(actionIndex) = missionDeal
    usaActionValues%(actionIndex) = 0
    usaTargets%(actionIndex) = targetIndex
    usaDealContacts%(actionIndex) = contactIndex
    return 1
end function

function setUsaIdle(actionIndex)
    usaActions%(actionIndex) = missionIdle
    usaActionValues%(actionIndex) = 0
    usaTargets%(actionIndex) = -1
    usaDealContacts%(actionIndex) = -1
end function

'Location observation and investigation persist; character observation,
'contact, and deals are one-time orders.
function resolveUsaActions()
    local actionIndex
    for actionIndex = 0 to numberOfUsaActions - 1
        usaReports%(actionIndex) = reportNone
        usaReportTargets%(actionIndex) = -1
        if usaActions%(actionIndex) = missionObserve then
            resolveObservationMission(actionIndex)
        end if
        if usaActions%(actionIndex) = missionObserveCharacter then
            resolveCharacterObservationMission(actionIndex)
        end if
        if usaActions%(actionIndex) = missionContact then
            resolveContactMission(actionIndex)
        end if
        if usaActions%(actionIndex) = missionInvestigate then
            resolveInvestigationMission(actionIndex)
        end if
        if usaActions%(actionIndex) = missionDeal then
            resolveDealMission(actionIndex)
        end if
    next actionIndex
end function

function resolveContactMission(actionIndex)
    local characterIndex
    characterIndex = usaTargets%(actionIndex)
    usaReports%(actionIndex) = reportNoLead
    usaReportTargets%(actionIndex) = -1
    if addContact(characterIndex) = 1 then
        usaReports%(actionIndex) = reportContact
        usaReportTargets%(actionIndex) = characterIndex
    end if
    setUsaIdle(actionIndex)
end function

function resolveCharacterObservationMission(actionIndex)
    local characterIndex
    characterIndex = usaTargets%(actionIndex)
    usaReports%(actionIndex) = reportNoLead
    usaReportTargets%(actionIndex) = -1
    if characterIndex >= 0 and characterIndex < numberOfCharacters then
        if characters(characterIndex).isAlive% = 1 and playerIntel%(characterIndex) = intelName then
            revealCharacter(characterIndex, intelObserved)
            usaReports%(actionIndex) = reportIntel
            usaReportTargets%(actionIndex) = characterIndex
        end if
    end if
    setUsaIdle(actionIndex)
end function

function resolveObservationMission(actionIndex)
    local locationValue, totalWeight
    locationValue = usaActionValues%(actionIndex)
    totalWeight = observationTotalWeight(locationValue)
    resolveObservationRoll(actionIndex, locationValue, int(rnd() * totalWeight))
end function

function resolveObservationRoll(actionIndex, locationValue, selection)
    local characterIndex
    usaReports%(actionIndex) = reportNoLead
    usaReportTargets%(actionIndex) = -1
    if selection < 0 then
        return
    end if
    characterIndex = observationCandidateAt(locationValue, selection)
    if characterIndex < 0 then
        return
    end if
    revealCharacter(characterIndex, intelName)
    usaReports%(actionIndex) = reportDiscovery
    usaReportTargets%(actionIndex) = characterIndex
end function

function resolveInvestigationMission(actionIndex)
    local characterIndex
    characterIndex = usaTargets%(actionIndex)
    resolveInvestigationRoll(actionIndex, characterIndex, int(rnd() * 100))
end function

function resolveInvestigationRoll(actionIndex, characterIndex, roll)
    local chance, contactIndex, reportedBand
    usaReports%(actionIndex) = reportNoLead
    if canInvestigate(characterIndex) = 0 then
        setUsaIdle(actionIndex)
        return
    end if
    if playerIntel%(characterIndex) >= intelAgenda then
        usaReports%(actionIndex) = reportNone
        setUsaIdle(actionIndex)
        return
    end if
    chance = investigationChance
    if roll < chance then
        revealCharacter(characterIndex, playerIntel%(characterIndex) + 1)
        if playerIntel%(characterIndex) >= intelAgenda then
            setUsaIdle(actionIndex)
        end if
        if characters(characterIndex).role% = president then
            contactIndex = firstContactFor(characterIndex)
            reportedBand = reportedPresidentAlignmentBand(contactIndex, roll MOD 10, int(roll / 10))
            usaReports%(actionIndex) = reportPoliticalInsight
            usaReportTargets%(actionIndex) = contactIndex
            usaActionValues%(actionIndex) = reportedBand
        else
            usaReports%(actionIndex) = reportIntel
            usaReportTargets%(actionIndex) = characterIndex
        end if
    end if
end function

'Integrity 10 always honors a deal; integrity 0 never does.
function dealOutcomeFor(integrityValue, roll)
    if roll < integrityValue then
        return dealHonored
    end if
    if roll < integrityValue + int((10 - integrityValue) / 2) then
        return dealPocketed
    end if
    return dealDiverted
end function

function resolveDealMission(actionIndex)
    resolveDealRoll(actionIndex, int(rnd() * 10))
end function

function resolveDealRoll(actionIndex, roll)
    local contactIndex, targetIndex, outcome, agendaIndex
    contactIndex = usaDealContacts%(actionIndex)
    targetIndex = usaTargets%(actionIndex)
    if hasContact(contactIndex) = 0 then
        usaReports%(actionIndex) = reportNoLead
        setUsaIdle(actionIndex)
        return
    end if
    if characters(contactIndex).isAlive% = 0 then
        usaReports%(actionIndex) = reportNoLead
        setUsaIdle(actionIndex)
        return
    end if
    if canCharacterKnowAbout(contactIndex, targetIndex) = 0 then
        usaReports%(actionIndex) = reportNoLead
        setUsaIdle(actionIndex)
        return
    end if
    if canInvestigate(targetIndex) = 0 then
        usaReports%(actionIndex) = reportNoLead
        setUsaIdle(actionIndex)
        return
    end if
    if budget < dealCostK then
        usaReports%(actionIndex) = reportNoFunds
        setUsaIdle(actionIndex)
        return
    end if
    budget = budget - dealCostK
    outcome = dealOutcomeFor(characters(contactIndex).integrity%, roll)
    usaReportTargets%(actionIndex) = targetIndex
    if outcome = dealHonored then
        revealCharacter(targetIndex, intelAgenda)
        usaReports%(actionIndex) = reportDealHonored
    else
        'The player cannot tell pocketing from diversion just from the report.
        usaReports%(actionIndex) = reportDealFailed
        if outcome = dealDiverted then
            agendaIndex = characters(contactIndex).agenda%
            if agendaIndex >= 0 then
                characterAgendas(agendaIndex).money = characterAgendas(agendaIndex).money + dealCostK
                if characterAgendas(agendaIndex).kind% = usurpRole then
                    characterAgendas(agendaIndex).weapons% = characterAgendas(agendaIndex).weapons% + 1
                end if
            end if
        end if
    end if
    setUsaIdle(actionIndex)
end function
