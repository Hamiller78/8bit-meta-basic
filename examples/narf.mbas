const tickerRow = TEXT_ROWS
const lowerRuleRow = TEXT_ROWS - 1
const tickerColumns = TEXT_COLUMNS - 1
const scrollDelay = JIFFIES_PER_SECOND / 5
const ruleLine$ = string$("-", tickerColumns)
const clearLine$ = space$(tickerColumns)

tickerText$ = "BEIRUT ROCKET BATTERY WORRIES U.S. * "
tickerText$ = tickerText$ + "REAGAN MOURNS MARINES LOST IN LEBANON AND GRENADA * "
tickerText$ = tickerText$ + "NBC REPORTS K.I.T.T. THE CAT ON KNIGHT RIDER TONIGHT * "
tickerText$ = tickerText$ + "NATO MANEUVER ABLE ARCHER COMMENCES TOMORROW * "
tickerText$ = tickerText$ + space$(tickerColumns)
tickerPos = 1
lastTick = jiffies()
lastClockTick = jiffies()
clockMinuteTens = 0
clockMinuteOnes = 0
clockSecondTens = 0
clockSecondOnes = 0

screen_border_color BLACK
screen_background_color BLACK
cls
screen_text_color WHITE

print_at 1, 1, ruleLine$;
print_at 2, 1, "DEFCON5 1983-11-06 23:00:00";
print_at 3, 1, "N.A.R.F. FAILSAFE";
print_at 4, 1, ruleLine$;
print_at 6, 1, "COMMAND CHANNEL";
print_at 7, 1, "N.A.R.F. OFFLINE";
print_at 9, 1, "AUTOMATED FAILSAFE STANDING BY";
print_at 11, 1, "INCOMING THREATS";
print_at 12, 1, "NO THREATS DETECTED";
print_at 14, 1, "PRIMARY NETWORK: DISCONNECTED";
print_at 15, 1, "CIVIL DEFENCE LINK: STANDBY";
print_at 17, 1, "SYSTEM STATUS: PROBABLY FINE";
print_at lowerRuleRow, 1, ruleLine$;
cell_text_color YELLOW
print_at tickerRow, 1, clearLine$;
print_at tickerRow, 1, mid$(tickerText$, tickerPos, tickerColumns);

scroll:
    if jiffies() - lastClockTick >= JIFFIES_PER_SECOND then
        lastClockTick = jiffies()
        clockSecondOnes = clockSecondOnes + 1
        if clockSecondOnes >= 10 then
            clockSecondOnes = 0
            clockSecondTens = clockSecondTens + 1
            if clockSecondTens >= 6 then
                clockSecondTens = 0
                clockMinuteOnes = clockMinuteOnes + 1
                if clockMinuteOnes >= 10 then
                    clockMinuteOnes = 0
                    clockMinuteTens = clockMinuteTens + 1
                    if clockMinuteTens >= 6 then
                        clockMinuteTens = 0
                    end if
                end if
            end if
        end if
        cell_text_color WHITE
        print_at 2, 20, "23:";
        print_at 2, 23, chr$(48 + clockMinuteTens);
        print_at 2, 24, chr$(48 + clockMinuteOnes);
        print_at 2, 25, ":";
        print_at 2, 26, chr$(48 + clockSecondTens);
        print_at 2, 27, chr$(48 + clockSecondOnes);
        cell_text_color YELLOW
    end if
    if jiffies() - lastTick >= scrollDelay then
        lastTick = jiffies()
        tickerPos = tickerPos + 1
        if tickerPos > len(tickerText$) - tickerColumns then
            tickerPos = 1
        end if
        print_at tickerRow, 1, mid$(tickerText$, tickerPos, tickerColumns);
    end if
    goto scroll
