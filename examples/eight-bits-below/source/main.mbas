uses "dungeon.mbas"
uses "characters.mbas"

hot_module

program_mode
screen_border_color BLACK
screen_background_color BLACK
screen_text_color WHITE
cls

print_at 1, 1, "EIGHT BITS BELOW";
print_at TEXT_ROWS, 1, "PRESS ANY KEY TO START";
repeat
    key = key_code()
until key <> KEY_NONE
randomize
cls
print_at 1, 1, "EIGHT BITS BELOW";
GenerateDungeon()
DrawDungeon()
InitPlayer()
DrawPlayer()

print_at TEXT_ROWS - 1, 1, "MOVE: DIRECTION KEYS";
print_at TEXT_ROWS, 1, "Q/A/O/P ON SPECTRUM";

repeat
    key = key_code()
    HandlePlayerInput(key)
until gameOver%
end
