uses "dungeon.mbas"
uses "dungeon-movement.mbas"
uses "combat.mbas"

hot_module

const numMonsters = numRooms
const attackLogRow = dungeonHeight + 1
const statusRow = dungeonHeight + 2

enum TurnAction
    turnBlocked
    turnMoved
    turnAttacked
    turnExit
end enum

gameOver% = FALSE
activeMonsterCount% = 0
const dungeonCount = 8
const modeDungeon = 0
const modeVillage = 1
const modeShop = 2
const modeVictory = 3
const shopPrice = 10
dungeonNumber% = 1
gameMode% = modeDungeon
gold = 0
shopSlot% = 0

struct character
    row
    column
    health
    armor
    attackDice
    speed
    symbol$(1)
    name$(20)
end struct

dim monsters as character(numMonsters)
dim player as character

const equipmentSlots = 6
const slotHead = 0
const slotChest = 1
const slotLegs = 2
const slotFeet = 3
const slotMainHand = 4
const slotOffHand = 5

struct equipmentItem
    name$(16)
    armor
    attackDice
    speed
end struct

dim equipment as equipmentItem(equipmentSlots)
dim foundItem as equipmentItem
baseArmor = 0
baseAttackDice = 0
baseSpeed = 1
foundSlot% = -1

function RecalculateEquipment()
    local slot
    player.armor = baseArmor
    player.attackDice = baseAttackDice
    player.speed = baseSpeed
    for slot = 0 to equipmentSlots - 1
        player.armor = player.armor + equipment(slot).armor
        player.attackDice = player.attackDice + equipment(slot).attackDice
        player.speed = player.speed + equipment(slot).speed
    next slot
end function

function InitEquipment()
    local slot
    baseArmor = 0
    baseAttackDice = 0
    baseSpeed = 1
    for slot = 0 to equipmentSlots - 1
        equipment(slot).name$ = "NONE"
        equipment(slot).armor = 0
        equipment(slot).attackDice = 0
        equipment(slot).speed = 0
    next slot
    equipment(slotMainHand).name$ = "SIMPLE SWORD"
    equipment(slotMainHand).attackDice = 1
    foundSlot% = -1
    RecalculateEquipment()
end function

' Each room's bat carries an item for one of the six slots.
function FindEquipment(roomIndex%)
    foundSlot% = roomIndex% mod equipmentSlots
    foundItem.armor = 0
    foundItem.attackDice = 0
    foundItem.speed = 0
    if foundSlot% = slotHead then
        foundItem.name$ = "HELMET"
        foundItem.armor = 1
    end if
    if foundSlot% = slotChest then
        foundItem.name$ = "MAIL"
        foundItem.armor = 1
    end if
    if foundSlot% = slotLegs then
        foundItem.name$ = "LEGGINGS"
        foundItem.armor = 1
    end if
    if foundSlot% = slotFeet then
        foundItem.name$ = "BOOTS"
        foundItem.speed = 1
    end if
    if foundSlot% = slotMainHand then
        foundItem.name$ = "FINE SWORD"
        foundItem.attackDice = 2
    end if
    if foundSlot% = slotOffHand then
        foundItem.name$ = "SHIELD"
        foundItem.armor = 1
    end if
end function

function DrawEquipmentChoice()
    cell_text_color WHITE
    print_at 19, 1, left$("FOUND: " + foundItem.name$ + space$(dungeonWidth), dungeonWidth);
    print_at 20, 1, left$("HAVE: " + equipment(foundSlot%).name$ + space$(dungeonWidth), dungeonWidth);
    print_at 21, 1, left$("A/D/S " + str$(equipment(foundSlot%).armor) + "/" + str$(equipment(foundSlot%).attackDice) + "/" + str$(equipment(foundSlot%).speed) + ">" + str$(foundItem.armor) + "/" + str$(foundItem.attackDice) + "/" + str$(foundItem.speed) + space$(dungeonWidth), dungeonWidth);
    print_at 22, 1, left$("UP EQUIP / DOWN LEAVE" + space$(dungeonWidth - 1), dungeonWidth - 1);
end function

function ResolveEquipmentChoice(equip%)
    if foundSlot% < 0 then
        return
    end if
    if equip% then
        equipment(foundSlot%) = foundItem
        RecalculateEquipment()
    end if
    foundSlot% = -1
    print_at 19, 1, space$(dungeonWidth);
    print_at 20, 1, space$(dungeonWidth);
    print_at 21, 1, left$("MOVE: DIRECTION KEYS" + space$(dungeonWidth), dungeonWidth);
    print_at 22, 1, left$("Q/A/O/P ON SPECTRUM" + space$(dungeonWidth - 1), dungeonWidth - 1);
end function

function ClearMonsters()
    local monsterIndex
    for monsterIndex = 0 to numMonsters - 1
        monsters(monsterIndex).health = 0
        monsters(monsterIndex).row = 0
        monsters(monsterIndex).column = 0
    next monsterIndex
    activeMonsterCount% = 0
end function

function MonsterAt(row%, column%)
    local monsterIndex
    for monsterIndex = 0 to numMonsters - 1
        if monsters(monsterIndex).health > 0 then
            if monsters(monsterIndex).row = row% and monsters(monsterIndex).column = column% then
                return monsterIndex
            end if
        end if
    next monsterIndex
    return -1
end function

function RestoreTile(row%, column%)
    cell_text_color WHITE
    print_at row%, column%, mid$(dungeonRows$(row% - 1), column%, 1);
end function

function DespawnMonster(monsterIndex%)
    if monsters(monsterIndex%).health > 0 then
        activeMonsterCount% = activeMonsterCount% - 1
    end if
    if monsters(monsterIndex%).row >= 1 and monsters(monsterIndex%).column >= 1 then
        RestoreTile(monsters(monsterIndex%).row, monsters(monsterIndex%).column)
    end if
    monsters(monsterIndex%).health = 0
    monsters(monsterIndex%).row = 0
    monsters(monsterIndex%).column = 0
end function

function ShowMessage(message$)
    cell_text_color WHITE
    print_at attackLogRow, 1, left$(message$ + space$(dungeonWidth), dungeonWidth);
end function

function DrawStatus()
    local statusText$
    statusText$ = "HP:" + str$(player.health) + " G:" + str$(gold)
    if gameOver% then
        statusText$ = "GAME OVER"
    end if
    cell_text_color WHITE
    print_at statusRow, 1, left$(statusText$ + space$(dungeonWidth), dungeonWidth);
end function

function ReportAttack(attacker$, target$, damage%, health%)
    local message$
    ' Spectrum and Atari slices must not extend beyond a short name.
    if len(attacker$) > 4 then
        attacker$ = left$(attacker$, 4)
    end if
    if len(target$) > 4 then
        target$ = left$(target$, 4)
    end if
    message$ = attacker$ + ">" + target$ + ": "
    if damage% = 0 then
        message$ = message$ + "NO DAMAGE"
    else
        message$ = message$ + str$(damage%)
        if health% = 0 then
            message$ = message$ + " DOWN"
        else
            message$ = message$ + " HP:" + str$(health%)
        end if
    end if
    ShowMessage(message$)
end function

function InitBat(monsterIndex%, row%, column%)
    if monsters(monsterIndex%).health <= 0 then
        activeMonsterCount% = activeMonsterCount% + 1
    end if
    monsters(monsterIndex%).row = row%
    monsters(monsterIndex%).column = column%
    monsters(monsterIndex%).health = 2
    monsters(monsterIndex%).armor = 0
    monsters(monsterIndex%).attackDice = 1
    monsters(monsterIndex%).speed = 2
    monsters(monsterIndex%).symbol$ = "B"
    monsters(monsterIndex%).name$ = "Bat"
end function

' Mutate the stored character: struct parameters would only change a copy.
function AttackMonster(monsterIndex%)
    local damage%
    if player.health > 0 and monsters(monsterIndex%).health > 0 then
        damage% = RollAttackDamage(player.attackDice, monsters(monsterIndex%).armor)
        if damage% >= monsters(monsterIndex%).health then
            DespawnMonster(monsterIndex%)
            gold = gold + 5
            FindEquipment(monsterIndex%)
        else
            monsters(monsterIndex%).health = monsters(monsterIndex%).health - damage%
        end if
        ReportAttack(player.name$, monsters(monsterIndex%).name$, damage%, monsters(monsterIndex%).health)
    end if
end function

function AttackPlayer(monsterIndex%)
    local damage%
    if player.health > 0 and monsters(monsterIndex%).health > 0 then
        damage% = RollAttackDamage(monsters(monsterIndex%).attackDice, player.armor)
        player.health = player.health - damage%
        if player.health <= 0 then
            player.health = 0
            gameOver% = TRUE
        end if
        ReportAttack(monsters(monsterIndex%).name$, player.name$, damage%, player.health)
        DrawStatus()
    end if
end function

function InitPlayer()
    ClearMonsters()
    gameOver% = FALSE
    gameMode% = modeDungeon
    dungeonNumber% = 1
    gold = 0
    player.health = 10
    InitEquipment()
    player.symbol$ = "P"
    player.name$ = "Hero"
    ShowMessage("")
    DrawStatus()
    PlacePlayerAtEntrance()
end function

function SpawnBatInRoom(roomIndex%)
    local rowIndex, columnIndex, tile$
    if rooms(roomIndex%).width% < 3 or rooms(roomIndex%).height% < 3 then
        return
    end if
    ' Each room owns one slot. Interiors exclude the shared surrounding walls.
    for rowIndex = rooms(roomIndex%).y% + 1 to rooms(roomIndex%).y% + rooms(roomIndex%).height% - 2
        for columnIndex = rooms(roomIndex%).x% + 1 to rooms(roomIndex%).x% + rooms(roomIndex%).width% - 2
            tile$ = mid$(dungeonRows$(rowIndex - 1), columnIndex, 1)
            if tile$ = dungeonFloor$ or tile$ = dungeonDoor$ then
                if rowIndex <> player.row or columnIndex <> player.column then
                    if MonsterAt(rowIndex, columnIndex) < 0 then
                        InitBat(roomIndex%, rowIndex, columnIndex)
                        return
                    end if
                end if
            end if
        next columnIndex
    next rowIndex
end function

function DiscoverRoomAt(row%, column%)
    local roomIndex%
    roomIndex% = RevealRoomAt(row%, column%)
    if roomIndex% >= 0 then
        SpawnBatInRoom(roomIndex%)
        DrawMonsters()
    end if
end function

function DrawVillage()
    cls
    print_at 1, 1, text$("village");
    if dungeonNumber% = 2 then
        set_pos 3, 1
        print_text "dungeon2", 22
    end if
    if dungeonNumber% = 3 then
        set_pos 3, 1
        print_text "dungeon3", 22
    end if
    if dungeonNumber% = 4 then
        set_pos 3, 1
        print_text "dungeon4", 22
    end if
    if dungeonNumber% = 5 then
        set_pos 3, 1
        print_text "dungeon5", 22
    end if
    if dungeonNumber% = 6 then
        set_pos 3, 1
        print_text "dungeon6", 22
    end if
    if dungeonNumber% = 7 then
        set_pos 3, 1
        print_text "dungeon7", 22
    end if
    if dungeonNumber% = 8 then
        set_pos 3, 1
        print_text "dungeon8", 22
    end if
    print_at 14, 1, text$("gold"); gold;
    print_at 16, 1, text$("villageShop");
    print_at 17, 1, text$("villageEnter");
end function

function DrawShop()
    cls
    print_at 1, 1, text$("shop");
    print_at 3, 1, text$("gold"); gold;
    print_at 5, 1, foundItem.name$;
    print_at 6, 1, text$("price"); shopPrice;
    print_at 8, 1, text$("current"); equipment(shopSlot%).name$;
    print_at 10, 1, "A/D/S "; equipment(shopSlot%).armor; "/"; equipment(shopSlot%).attackDice; "/"; equipment(shopSlot%).speed;
    print_at 11, 1, "     >"; foundItem.armor; "/"; foundItem.attackDice; "/"; foundItem.speed;
    print_at 14, 1, text$("shopBrowse");
    print_at 15, 1, text$("shopBuy");
    print_at 16, 1, text$("shopLeave");
end function

function SelectShopItem()
    FindEquipment(shopSlot%)
    ' Shop stock is an improved version of the corresponding dungeon item.
    if shopSlot% = slotFeet then
        foundItem.speed = foundItem.speed + 1
    else
        if shopSlot% = slotMainHand then
            foundItem.attackDice = foundItem.attackDice + 1
        else
            foundItem.armor = foundItem.armor + 1
        end if
    end if
    foundSlot% = -1
end function

function BuyShopItem()
    if gold < shopPrice then
        print_at 18, 1, text$("notEnough");
        return
    end if
    gold = gold - shopPrice
    equipment(shopSlot%) = foundItem
    RecalculateEquipment()
    DrawShop()
    print_at 18, 1, text$("purchased");
end function

function EnterNextDungeon()
    cls
    gameMode% = modeDungeon
    GenerateDungeon()
    DrawDungeon()
    ShowMessage("")
    PlacePlayerAtEntrance()
    print_at TEXT_ROWS - 1, 1, "MOVE: DIRECTION KEYS";
    print_at TEXT_ROWS, 1, "Q/A/O/P ON SPECTRUM";
    DrawStatus()
    DrawPlayer()
end function

function LeaveDungeon()
    ClearMonsters()
    if dungeonNumber% = dungeonCount then
        gameMode% = modeVictory
        cls
        set_pos 1, 1
        print_text "victory", 22
        return
    end if
    dungeonNumber% = dungeonNumber% + 1
    gameMode% = modeVillage
    DrawVillage()
end function

function HandleVillageInput(key)
    if gameMode% = modeVillage then
        if key = GAME_UP then
            gameMode% = modeShop
            shopSlot% = 0
            SelectShopItem()
            DrawShop()
            return
        end if
        if key = GAME_DOWN then
            EnterNextDungeon()
        end if
        return
    end if
    if gameMode% = modeShop then
        if key = GAME_LEFT then
            shopSlot% = shopSlot% - 1
            if shopSlot% < 0 then
                shopSlot% = equipmentSlots - 1
            end if
            SelectShopItem()
            DrawShop()
        end if
        if key = GAME_RIGHT then
            shopSlot% = (shopSlot% + 1) mod equipmentSlots
            SelectShopItem()
            DrawShop()
        end if
        if key = GAME_UP then
            BuyShopItem()
        end if
        if key = GAME_DOWN then
            gameMode% = modeVillage
            DrawVillage()
        end if
    end if
end function

function PlacePlayerAtEntrance()
    local rowIndex
    player.column = 1
    for rowIndex = 1 to dungeonHeight
        if left$(dungeonRows$(rowIndex - 1), 1) = dungeonEntrance$ then
            player.row = rowIndex
        end if
    next rowIndex
    DiscoverRoomAt(player.row, player.column)
end function

function DrawPlayer()
    cell_text_color YELLOW
    print_at player.row, player.column, player.symbol$;
    cell_text_color WHITE
end function

function HandlePlayerInput(key)
    local action%
    if gameOver% or player.health <= 0 then
        return
    end if
    if gameMode% <> modeDungeon then
        HandleVillageInput(key)
        return
    end if
    if foundSlot% >= 0 then
        if key = GAME_UP then
            ResolveEquipmentChoice(TRUE)
        end if
        if key = GAME_DOWN then
            ResolveEquipmentChoice(FALSE)
        end if
        return
    end if
    action% = turnBlocked
    if key = GAME_UP then
        action% = MovePlayer(-1, 0)
    end if
    if key = GAME_DOWN then
        action% = MovePlayer(1, 0)
    end if
    if key = GAME_LEFT then
        action% = MovePlayer(0, -1)
    end if
    if key = GAME_RIGHT then
        action% = MovePlayer(0, 1)
    end if
    if action% = turnExit then
        LeaveDungeon()
        return
    else
        if action% <> turnBlocked then
            MoveMonsters()
        end if
    end if
    if action% <> turnBlocked then
        DrawStatus()
        DrawPlayer()
        if foundSlot% >= 0 and not gameOver% then
            DrawEquipmentChoice()
        end if
    end if
end function

function MovePlayer(rowStep, columnStep)
    local nextRow%, nextColumn%, tile$, monsterIndex%
    if gameOver% or player.health <= 0 then
        return turnBlocked
    end if
    if abs(rowStep) + abs(columnStep) <> 1 then
        return turnBlocked
    end if
    nextRow% = player.row + rowStep
    nextColumn% = player.column + columnStep
    ' Check bounds before indexing: logical operators need not short-circuit.
    if IsOpenTile(nextRow%, nextColumn%) then
        monsterIndex% = MonsterAt(nextRow%, nextColumn%)
        if monsterIndex% >= 0 then
            AttackMonster(monsterIndex%)
            return turnAttacked
        end if
        tile$ = mid$(dungeonRows$(nextRow% - 1), nextColumn%, 1)
        if tile$ = dungeonExit$ then
            return turnExit
        end if
        RestoreTile(player.row, player.column)
        player.row = nextRow%
        player.column = nextColumn%
        if tile$ = dungeonDoor$ then
            DiscoverRoomAt(player.row, player.column)
        end if
        DrawPlayer()
        return turnMoved
    end if
    return turnBlocked
end function

function TryMonsterStep(monsterIndex%, rowStep%, columnStep%)
    local nextRow%, nextColumn%
    if rowStep% = 0 and columnStep% = 0 then
        return turnBlocked
    end if
    nextRow% = monsters(monsterIndex%).row + rowStep%
    nextColumn% = monsters(monsterIndex%).column + columnStep%
    if nextRow% = player.row and nextColumn% = player.column then
        AttackPlayer(monsterIndex%)
        return turnAttacked
    end if
    if IsOpenTile(nextRow%, nextColumn%) then
        if IsDiscoveredTile(nextRow%, nextColumn%) then
            if MonsterAt(nextRow%, nextColumn%) < 0 then
                RestoreTile(monsters(monsterIndex%).row, monsters(monsterIndex%).column)
                monsters(monsterIndex%).row = nextRow%
                monsters(monsterIndex%).column = nextColumn%
                DrawCharacter(monsterIndex%)
                return turnMoved
            end if
        end if
    end if
    return turnBlocked
end function

inline function MoveMonsterTowardPlayer(monsterIndex%)
    local rowStep%, columnStep%, action%
    rowStep% = sgn(player.row - monsters(monsterIndex%).row)
    columnStep% = sgn(player.column - monsters(monsterIndex%).column)
    if abs(player.column - monsters(monsterIndex%).column) >= abs(player.row - monsters(monsterIndex%).row) then
        action% = TryMonsterStep(monsterIndex%, 0, columnStep%)
        if action% = turnBlocked then
            action% = TryMonsterStep(monsterIndex%, rowStep%, 0)
        end if
    else
        action% = TryMonsterStep(monsterIndex%, rowStep%, 0)
        if action% = turnBlocked then
            action% = TryMonsterStep(monsterIndex%, 0, columnStep%)
        end if
    end if
    return action%
end function

function MoveMonsters()
    local monsterIndex, stepsLeft%, action%, monstersLeft%
    monstersLeft% = activeMonsterCount%
    if monstersLeft% = 0 then
        return
    end if
    for monsterIndex = 0 to numMonsters - 1
        if monsters(monsterIndex).health > 0 then
            stepsLeft% = monsters(monsterIndex).speed
            while stepsLeft% > 0 and player.health > 0
                action% = MoveMonsterTowardPlayer(monsterIndex)
                if action% = turnMoved then
                    stepsLeft% = stepsLeft% - 1
                else
                    ' An attack or two blocked directions end this bat's turn.
                    stepsLeft% = 0
                end if
            wend
            monstersLeft% = monstersLeft% - 1
            if monstersLeft% = 0 then
                return
            end if
        end if
    next monsterIndex
end function

function DrawMonsters()
    local monsterIndex
    for monsterIndex = 0 to numMonsters - 1
        if monsters(monsterIndex).health > 0 then
            DrawCharacter(monsterIndex)
        end if
    next monsterIndex
end function

function DrawCharacter(characterIndex%)
    local rowIndex, columnIndex

    rowIndex = monsters(characterIndex%).row
    columnIndex = monsters(characterIndex%).column

    cell_text_color RED
    print_at rowIndex, columnIndex, monsters(characterIndex%).symbol$;
    cell_text_color WHITE
end function
