uses "../source/dungeon.mbas"

test FirstRoomPlacesDistinctSideOpenings()
    local rowIndex, entranceCount, exitCount
    for rowIndex = 0 to dungeonHeight - 1
        dungeonRows$(rowIndex) = string$(".", dungeonWidth)
    next rowIndex
    InitFirstRoom()
    assert_ne dungeonEntrance$, dungeonExit$
    assert_eq string$("#", dungeonWidth), dungeonRows$(0)
    assert_eq string$("#", dungeonWidth), dungeonRows$(dungeonHeight - 1)
    entranceCount = 0
    exitCount = 0
    for rowIndex = 1 to dungeonHeight - 2
        assert_eq string$(".", 20), mid$(dungeonRows$(rowIndex), 2, dungeonWidth - 2)
        if left$(dungeonRows$(rowIndex), 1) = dungeonEntrance$ then
            entranceCount = entranceCount + 1
        else
            assert_eq dungeonWall$, left$(dungeonRows$(rowIndex), 1)
        end if
        if right$(dungeonRows$(rowIndex), 1) = dungeonExit$ then
            exitCount = exitCount + 1
        else
            assert_eq dungeonWall$, right$(dungeonRows$(rowIndex), 1)
        end if
    next rowIndex
    assert_eq 1, entranceCount
    assert_eq 1, exitCount
end test

test GeneratedOpeningsRemainAccessible()
    local rowIndex, entranceCount, exitCount
    for rowIndex = 0 to dungeonHeight - 1
        dungeonRows$(rowIndex) = "OLD"
    next rowIndex
    GenerateDungeon()
    assert_eq string$("#", dungeonWidth), dungeonRows$(0)
    assert_eq string$("#", dungeonWidth), dungeonRows$(dungeonHeight - 1)
    entranceCount = 0
    exitCount = 0
    for rowIndex = 1 to dungeonHeight - 2
        assert_eq dungeonWidth, len(dungeonRows$(rowIndex))
        if left$(dungeonRows$(rowIndex), 1) = dungeonEntrance$ then
            entranceCount = entranceCount + 1
            assert_eq dungeonFloor$, mid$(dungeonRows$(rowIndex), 2, 1)
        else
            assert_eq dungeonWall$, left$(dungeonRows$(rowIndex), 1)
        end if
        if right$(dungeonRows$(rowIndex), 1) = dungeonExit$ then
            exitCount = exitCount + 1
            assert_eq dungeonFloor$, mid$(dungeonRows$(rowIndex), dungeonWidth - 1, 1)
        else
            assert_eq dungeonWall$, right$(dungeonRows$(rowIndex), 1)
        end if
    next rowIndex
    assert_eq 1, entranceCount
    assert_eq 1, exitCount
end test

test HorizontalSplitProtectsEntranceAndExit()
    local rowIndex
    for rowIndex = 0 to dungeonHeight - 1
        dungeonRows$(rowIndex) = string$(".", dungeonWidth)
    next rowIndex
    rooms(0).x = 1
    rooms(0).y = 6
    rooms(0).width = dungeonWidth
    rooms(0).height = 5
    DrawHorizontalWall(6, 1, dungeonWidth)
    DrawHorizontalWall(10, 1, dungeonWidth)
    DrawVerticalWall(1, 6, 10)
    DrawVerticalWall(dungeonWidth, 6, 10)
    dungeonRows$(7) = dungeonEntrance$ + mid$(dungeonRows$(7), 2)
    dungeonRows$(7) = left$(dungeonRows$(7), dungeonWidth - 1) + dungeonExit$
    SplitRoomHorizontally(0, 1)
    assert_eq "<." + string$("#", 18) + ".>", dungeonRows$(7)
    assert_eq 3, rooms(0).height
    assert_eq 3, rooms(1).height
end test
