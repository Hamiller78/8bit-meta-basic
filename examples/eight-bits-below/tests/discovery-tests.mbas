uses "../source/dungeon.mbas"
uses "../source/characters.mbas"

' Run with --test-screen-output to verify both room state and visible tiles.
function PrepareDiscoveryTest()
    local rowIndex, roomIndex
    program_mode
    for rowIndex = 0 to dungeonHeight - 1
        dungeonRows$(rowIndex) = dungeonWallRow$
    next rowIndex
    dungeonRows$(1) = "#...#...#...#" + string$("#", 9)
    dungeonRows$(2) = "<...+...+...#" + string$("#", 9)
    dungeonRows$(3) = "#...#...#...#" + string$("#", 9)
    for roomIndex = 0 to numRooms - 1
        rooms(roomIndex).x% = 0
        rooms(roomIndex).y% = 0
        rooms(roomIndex).width% = 0
        rooms(roomIndex).height% = 0
        rooms(roomIndex).isDiscovered% = FALSE
    next roomIndex
    for roomIndex = 0 to 2
        rooms(roomIndex).x% = roomIndex * 4 + 1
        rooms(roomIndex).y% = 1
        rooms(roomIndex).width% = 5
        rooms(roomIndex).height% = 5
    next roomIndex
    cls
    DrawDungeon()
    InitPlayer()
    DrawPlayer()
end function

test EntranceRevealsOnlyItsRoom()
    PrepareDiscoveryTest()
    assert_true rooms(0).isDiscovered%
    assert_false rooms(1).isDiscovered%
    assert_false rooms(2).isDiscovered%
    assert_eq code("B"), screen_code(2, 2)
    assert_eq code(" "), screen_code(2, 6)
    assert_eq code(" "), screen_code(2, 10)
    assert_eq code("P"), screen_code(3, 1)
end test

test DoorRevealsOneRoomWithoutFollowingFurtherDoors()
    local stepIndex
    PrepareDiscoveryTest()
    for stepIndex = 1 to 4
        MovePlayer(0, 1)
    next stepIndex
    assert_eq 5, player.column
    assert_true rooms(0).isDiscovered%
    assert_true rooms(1).isDiscovered%
    assert_false rooms(2).isDiscovered%
    assert_eq code("<"), screen_code(3, 1)
    assert_eq code("B"), screen_code(2, 6)
    assert_eq code("+"), screen_code(3, 9)
    assert_eq code(" "), screen_code(2, 10)
    assert_eq code("P"), screen_code(3, 5)
    for stepIndex = 1 to 3
        MovePlayer(0, 1)
    next stepIndex
    assert_false rooms(2).isDiscovered%
    MovePlayer(0, 1)
    assert_true rooms(2).isDiscovered%
    assert_eq code("B"), screen_code(2, 10)
    MovePlayer(0, -1)
    assert_true rooms(2).isDiscovered%
end test

test BlockedMovesDoNotRevealRooms()
    PrepareDiscoveryTest()
    MovePlayer(0, -1)
    MovePlayer(-1, 0)
    MovePlayer(0, 0)
    assert_eq 3, player.row
    assert_eq 1, player.column
    assert_false rooms(1).isDiscovered%
    assert_false rooms(2).isDiscovered%
    assert_eq code(" "), screen_code(2, 6)
end test

test FloorAndEntranceStepsDoNotDiscoverRooms()
    PrepareDiscoveryTest()
    rooms(0).isDiscovered% = FALSE
    MovePlayer(0, 1)
    assert_eq 2, player.column
    assert_false rooms(0).isDiscovered%
    MovePlayer(0, -1)
    assert_eq 1, player.column
    assert_false rooms(0).isDiscovered%
end test

test HorizontalDoorRevealsRoomBelow()
    local rowIndex
    PrepareDiscoveryTest()
    rooms(1).x% = 1
    rooms(1).y% = 5
    rooms(2).width% = 0
    rooms(2).height% = 0
    dungeonRows$(4) = "##+##" + string$("#", 17)
    for rowIndex = 5 to 7
        dungeonRows$(rowIndex) = "#...#" + string$("#", 17)
    next rowIndex
    MovePlayer(0, 1)
    MovePlayer(0, 1)
    MovePlayer(1, 0)
    MovePlayer(1, 0)
    assert_eq 5, player.row
    assert_eq 3, player.column
    assert_true rooms(1).isDiscovered%
    assert_eq code("B"), screen_code(6, 2)
end test

test SharedWallCoordinatesStillRequireTheRoomSpan()
    PrepareDiscoveryTest()
    DiscoverRoomAt(1, 20)
    DiscoverRoomAt(12, 5)
    assert_false rooms(1).isDiscovered%
    assert_false rooms(2).isDiscovered%
end test

test RedrawKeepsDiscoveredRoomsAndControls()
    local stepIndex
    PrepareDiscoveryTest()
    for stepIndex = 1 to 4
        MovePlayer(0, 1)
    next stepIndex
    print_at TEXT_ROWS - 1, 1, "HELP";
    ' A redraw must erase stale map cells outside the discovered rooms.
    print_at 2, 10, "X";
    DrawDungeon()
    DrawMonsters()
    DrawPlayer()
    assert_eq code("B"), screen_code(2, 2)
    assert_eq code("B"), screen_code(2, 6)
    assert_eq code(" "), screen_code(2, 10)
    assert_eq code("H"), screen_code(TEXT_ROWS - 1, 1)
    assert_eq code("P"), screen_code(3, 5)
end test
