uses "../source/characters.mbas"
uses "../source/dungeon.mbas"

test ExitResetsRoomsAndMonstersButPreservesPlayerAndControls()
    local rowIndex, roomIndex, discoveredCount%, monsterCount%, hiddenRow%, hiddenColumn%
    program_mode
    gameOver% = FALSE
    for rowIndex = 0 to dungeonHeight - 1
        dungeonRows$(rowIndex) = dungeonWallRow$
    next rowIndex
    dungeonRows$(3) = string$(dungeonFloor$, dungeonWidth - 1) + dungeonExit$
    for roomIndex = 0 to numRooms - 1
        rooms(roomIndex).isDiscovered% = TRUE
        InitBat(roomIndex, 2, 2)
    next roomIndex
    player.row = 4
    player.column = dungeonWidth - 1
    player.health = 7
    player.armor = 2
    player.attackDice = 3
    player.speed = 2
    player.symbol$ = "P"
    player.name$ = "Explorer"
    cls
    print_at TEXT_ROWS - 1, 1, "HELP";
    ShowMessage("OLD ATTACK")
    HandlePlayerInput(GAME_RIGHT)
    discoveredCount% = 0
    monsterCount% = 0
    for roomIndex = 0 to numRooms - 1
        if rooms(roomIndex).isDiscovered% then
            discoveredCount% = discoveredCount% + 1
        else
            hiddenRow% = rooms(roomIndex).y% + 1
            hiddenColumn% = rooms(roomIndex).x% + 1
        end if
        if monsters(roomIndex).health > 0 then
            monsterCount% = monsterCount% + 1
            assert_true rooms(roomIndex).isDiscovered%
            assert_true monsters(roomIndex).row > rooms(roomIndex).y%
            assert_true monsters(roomIndex).column > rooms(roomIndex).x%
        else
            assert_eq 0, monsters(roomIndex).row
            assert_eq 0, monsters(roomIndex).column
        end if
    next roomIndex
    assert_eq 1, discoveredCount%
    assert_eq 1, monsterCount%
    assert_eq 1, player.column
    assert_eq dungeonEntrance$, left$(dungeonRows$(player.row - 1), 1)
    assert_eq dungeonWallRow$, dungeonRows$(0)
    assert_eq 7, player.health
    assert_eq 2, player.armor
    assert_eq 3, player.attackDice
    assert_eq 2, player.speed
    assert_eq "Explorer", player.name$
    assert_false gameOver%
    assert_eq code(" "), screen_code(hiddenRow%, hiddenColumn%)
    assert_eq code("H"), screen_code(TEXT_ROWS - 1, 1)
    assert_eq code(" "), screen_code(attackLogRow, 1)
    assert_printat player.row, 1, "P"
end test
