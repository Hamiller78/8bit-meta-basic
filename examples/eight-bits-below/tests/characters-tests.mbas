uses "../source/characters.mbas"
uses "../source/dungeon.mbas"

function PreparePlayerTest()
    local rowIndex, roomIndex
    for roomIndex = 0 to numRooms - 1
        rooms(roomIndex).width% = 0
        rooms(roomIndex).height% = 0
        rooms(roomIndex).isDiscovered% = FALSE
    next roomIndex
    rooms(0).x% = 1
    rooms(0).y% = 3
    rooms(0).width% = 5
    rooms(0).height% = 4
    for rowIndex = 0 to dungeonHeight - 1
        dungeonRows$(rowIndex) = dungeonWallRow$
    next rowIndex
    dungeonRows$(3) = "<..+" + string$("#", 18)
    dungeonRows$(4) = "#.." + string$("#", 19)
    InitPlayer()
    ' Isolate player movement; turn and spawning behavior have separate tests.
    ClearMonsters()
end function

test PlayerStartsAtEntrance()
    PreparePlayerTest()
    assert_eq 4, player.row
    assert_eq 1, player.column
    assert_eq 10, player.health
    assert_eq "Hero", player.name$
    DrawPlayer()
    assert_printat 4, 1, "P"
    assert_cell_text_color WHITE
end test

test DirectionKeysMoveAcrossFloorAndDoors()
    PreparePlayerTest()
    MovePlayer(0, 1)
    MovePlayer(1, 0)
    assert_eq 5, player.row
    assert_eq 2, player.column
    MovePlayer(-1, 0)
    MovePlayer(0, 1)
    MovePlayer(0, 1)
    assert_eq 4, player.row
    assert_eq 4, player.column
    MovePlayer(0, -1)
    assert_eq 3, player.column
    assert_eq "+", mid$(dungeonRows$(3), 4, 1)
    assert_printat 4, 3, "P"
end test

test WallsAndInvalidStepsDoNotMovePlayer()
    PreparePlayerTest()
    MovePlayer(-1, 0)
    MovePlayer(1, 0)
    MovePlayer(0, 0)
    MovePlayer(1, 1)
    assert_eq 4, player.row
    assert_eq 1, player.column
end test

test PlayerCanReturnToEntranceButCannotLeaveBounds()
    PreparePlayerTest()
    MovePlayer(0, -1)
    assert_eq 1, player.column
    MovePlayer(0, 1)
    MovePlayer(0, -1)
    assert_eq 4, player.row
    assert_eq 1, player.column
    player.row = 1
    MovePlayer(-1, 0)
    assert_eq 1, player.row
    player.row = dungeonHeight
    MovePlayer(1, 0)
    assert_eq dungeonHeight, player.row
    player.column = dungeonWidth
    MovePlayer(0, 1)
    assert_eq dungeonWidth, player.column
end test
