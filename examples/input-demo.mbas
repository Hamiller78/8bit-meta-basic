const coordinateRow = 4
const statusRow = 6
const clearLine$ = space$(TEXT_COLUMNS)

x = 11
y = 11
key = KEY_NONE

screen_border_color BLACK
screen_background_color BLACK
cls
screen_text_color WHITE

print_at 1, 1, "META-BASIC INPUT DEMO";
print_at 2, 1, "MOVE TARGET WITH GAME KEYS";

loop:
    key = key_code()

    if key = GAME_UP then
        if y > 1 then
            y = y - 1
        end if
    end if

    if key = GAME_DOWN then
        if y < TEXT_ROWS then
            y = y + 1
        end if
    end if

    if key = GAME_LEFT then
        if x > 1 then
            x = x - 1
        end if
    end if

    if key = GAME_RIGHT then
        if x < TEXT_COLUMNS then
            x = x + 1
        end if
    end if

    print_at coordinateRow, 1, clearLine$;
    print_at coordinateRow, 1, "X="; x; " Y="; y;

    if key = KEY_ENTER or key = GAME_FIRE then
        print_at statusRow, 1, clearLine$;
        print_at statusRow, 1, "Target coordinates set to "; x; ","; y;
    end if

    goto loop
