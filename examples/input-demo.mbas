const coordinateRow = 3
const statusRow = 5
const clearLine$ = space$(TEXT_COLUMNS)

x = 10
y = 10
key = KEY_NONE

screen_border_color BLACK
screen_background_color BLACK
cls
screen_text_color WHITE

print_at 0, 0, "META-BASIC INPUT DEMO";
print_at 1, 0, "MOVE TARGET WITH GAME KEYS";

loop:
    key = key_code()

    if key = GAME_UP then
        if y > 0 then
            y = y - 1
        end if
    end if

    if key = GAME_DOWN then
        if y < TEXT_ROWS - 1 then
            y = y + 1
        end if
    end if

    if key = GAME_LEFT then
        if x > 0 then
            x = x - 1
        end if
    end if

    if key = GAME_RIGHT then
        if x < TEXT_COLUMNS - 1 then
            x = x + 1
        end if
    end if

    print_at coordinateRow, 0, clearLine$;
    print_at coordinateRow, 0, "X="; x; " Y="; y;

    if key = KEY_ENTER or key = GAME_FIRE then
        print_at statusRow, 0, clearLine$;
        print_at statusRow, 0, "Target coordinates set to "; x; ","; y;
    end if

    goto loop
