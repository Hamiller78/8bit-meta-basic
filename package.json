{
  "name": "8bit-meta-basic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "build:target": "node scripts/build-target.mjs",
    "build:directory": "node scripts/build-directory.mjs",
    "build:all-targets": "node scripts/build-all.mjs",
    "build:all-profiles": "node scripts/build-all.mjs --all-profiles",
    "build:spectrum": "node scripts/build-target.mjs spectrum",
    "build:spectrum:all-profiles": "node scripts/build-target.mjs spectrum --all-profiles",
    "build:atari": "node scripts/build-target.mjs atari800xl",
    "build:atari:all-profiles": "node scripts/build-target.mjs atari800xl --all-profiles",
    "build:c64": "node scripts/build-target.mjs c64",
    "build:c64:all-profiles": "node scripts/build-target.mjs c64 --all-profiles",
    "launch:c64": "node scripts/launch-c64.mjs",
    "test": "vitest run test",
    "test:watch": "vitest test",
    "start": "node dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=24"
  }
}
