{
  "spectrum": {
    "tools": [
      {
        "name": "bas2tap",
        "path": "",
        "args": ["-a", "{input}", "{output}"],
        "outputExtension": ".tap"
      }
    ],
    "emulator": {
      "name": "Fuse",
      "path": "",
      "args": ["-tape", "{artifact}"]
    }
  },
  "atari800xl": {
    "tools": [
      {
        "name": "basicParser",
        "path": "",
        "inputArtifact": "basic",
        "args": ["-A", "-b", "-f", "-o", "{output}", "{input}"],
        "outputExtension": ".tokenized.bas",
        "copyToArtifact": "atariDiskDirectory",
        "copyExtension": "BAS"
      },
      {
        "name": "dir2atr",
        "path": "",
        "inputArtifact": "atariDiskDirectory",
        "args": ["-S", "{output}", "{input}"],
        "outputExtension": ".atr"
      }
    ],
    "emulator": {
      "name": "Altirra",
      "path": "",
      "args": ["{artifact}"],
      "artifactArgs": {
        "atr": ["/disk", "{artifact}"],
        "tokenized-bas": ["/runbas", "{artifact}"],
        "lst": ["/runbas", "{artifact}"],
        "disk-directory": ["{artifact}"]
      }
    }
  },
  "c64": {
    "tools": [
      {
        "name": "petcat",
        "path": "",
        "inputTransform": "lowercase",
        "args": ["-w2", "-o", "{output}", "--", "{input}"],
        "outputExtension": ".prg"
      }
    ],
    "emulator": {
      "name": "x64sc",
      "path": "",
      "args": ["-autostart", "{artifact}", "-autostart-warp"]
    }
  }
}
