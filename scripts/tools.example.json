{
  "spectrum": {
    "tools": [
      {
        "name": "bas2tap",
        "path": "",
        "args": ["-a", "{input}", "{output}"],
        "outputExtension": ".tap"
      }
    ],
    "emulator": {
      "name": "Fuse",
      "path": "",
      "testOutputDevice": "text-printer",
      "args": ["-tape", "{artifact}", "-auto-play"],
      "testArgs": ["--speed", "500"],
      "printerOutputPath": "build/printer/{profile}/{target}/{sourceName}.txt",
      "printerArgs": ["--printer", "--zxprinter", "--textfile", "{printerOutput}"],
      "rs232OutputPath": "build/rs232/{profile}/{target}/{sourceName}.txt",
      "rs232Args": []
    }
  },
  "atari800xl": {
    "tools": [
      {
        "name": "basicParser",
        "path": "",
        "inputArtifact": "basic",
        "args": ["-A", "-b", "-f", "-o", "{output}", "{input}"],
        "outputExtension": ".tokenized.bas",
        "copyToArtifact": "atariDiskDirectory",
        "copyExtension": "BAS"
      },
      {
        "name": "dir2atr",
        "path": "",
        "inputArtifact": "atariDiskDirectory",
        "args": ["-S", "{output}", "{input}"],
        "outputExtension": ".atr"
      }
    ],
    "emulator": {
      "name": "Altirra",
      "path": "",
      "testOutputDevice": "shared-drive",
      "printerOutputPath": "build/printer/{profile}/{target}/{sourceName}.txt",
      "printerArgs": [],
      "rs232OutputPath": "build/rs232/{profile}/{target}/{sourceName}.txt",
      "rs232Args": [],
      "sharedDrivePath": "build/altirra_drive",
      "sharedDriveOutputPath": "build/altirra_drive/MCP.TXT",
      "sharedDriveArgs": [],
      "args": ["{artifact}"],
      "artifactArgs": {
        "atr": ["/disk", "{artifact}"],
        "tokenized-bas": ["/runbas", "{artifact}"],
        "lst": ["/runbas", "{artifact}"],
        "disk-directory": ["{artifact}"]
      }
    }
  },
  "c64": {
    "tools": [
      {
        "name": "petcat",
        "path": "",
        "inputTransform": "lowercase",
        "args": ["-w2", "-o", "{output}", "--", "{input}"],
        "outputExtension": ".prg"
      }
    ],
    "emulator": {
      "name": "x64sc",
      "path": "",
      "testOutputDevice": "rs232",
      "args": ["-autostart", "{artifact}", "-autostart-warp"],
      "printerOutputPath": "build/printer/{profile}/{target}/{sourceName}.txt",
      "printerArgs": ["-busdevice4", "-devicebackend4", "1", "-prtxtdev1", "{printerOutput}", "-pr4txtdev", "0", "-pr4output", "text", "-pr4drv", "ascii"],
      "rs232OutputPath": "build/rs232/{profile}/{target}/{sourceName}.txt",
      "rs232Args": ["-rsuser", "-rsuserdev", "0", "-rsuserbaud", "2400", "-rsdev1", "{rs232Endpoint}", "-rsdev1baud", "2400"]
    }
  }
}
