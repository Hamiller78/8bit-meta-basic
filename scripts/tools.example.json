{
  "targets": {
    "spectrum": {
      "tools": [
        {
          "name": "bas2tap",
          "path": "",
          "args": ["-a", "{input}", "{output}"],
          "failureOutputPattern": "\\bERROR in line\\b",
          "outputExtension": ".tap"
        }
      ]
    },
    "atari800xl": {
      "tools": [
        {
          "name": "basicParser",
          "path": "",
          "inputArtifact": "atariListing",
          "args": ["-A", "-b", "-f", "-o", "{output}", "{input}"],
          "outputExtension": ".tokenized.bas",
          "copyToArtifact": "atariDiskDirectory",
          "copyExtension": "BAS"
        },
        {
          "name": "dir2atr",
          "path": "",
          "inputArtifact": "atariDiskDirectory",
          "args": ["-S", "{output}", "{input}"],
          "outputExtension": ".atr"
        }
      ]
    },
    "c64": {
      "tools": [
        {
          "name": "petcat",
          "path": "",
          "args": ["-w2", "-o", "{output}", "--", "{input}"],
          "outputExtension": ".prg"
        }
      ]
    }
  },
  "targetConfigurations": {
    "spectrum48": {
      "compilerTarget": "spectrum",
      "computer": {
        "model": "ZX Spectrum 48K",
        "ramKib": 48,
        "videoStandard": "PAL",
        "basic": "48K ROM BASIC"
      },
      "emulator": {
        "type": "fuse",
        "name": "Fuse",
        "path": "",
        "testOutputDevice": "text-printer",
        "args": ["--machine", "48", "-tape", "{artifact}", "-auto-play"],
        "testArgs": ["--speed", "1000"],
        "printerOutputPath": "build/printer/{profile}/{targetConfiguration}/{sourceName}.txt",
        "printerArgs": ["--printer", "--zxprinter", "--textfile", "{printerOutput}", "--graphicsfile", "{nullDevice}"],
        "rs232OutputPath": "build/rs232/{profile}/{targetConfiguration}/{sourceName}.txt",
        "rs232Args": []
      }
    },
    "spectrum128": {
      "compilerTarget": "spectrum",
      "computer": {
        "model": "ZX Spectrum 128K",
        "ramKib": 128,
        "videoStandard": "PAL",
        "basic": "128K ROM BASIC"
      },
      "emulator": {
        "type": "fuse",
        "name": "Fuse",
        "path": "",
        "testOutputDevice": "text-printer",
        "args": ["--machine", "128", "-tape", "{artifact}", "-auto-play"],
        "testArgs": ["--speed", "1000"],
        "printerOutputPath": "build/printer/{profile}/{targetConfiguration}/{sourceName}.txt",
        "printerArgs": ["--printer", "--zxprinter", "--textfile", "{printerOutput}", "--graphicsfile", "{nullDevice}"],
        "rs232OutputPath": "build/rs232/{profile}/{targetConfiguration}/{sourceName}.txt",
        "rs232Args": []
      }
    },
    "atari1": {
      "compilerTarget": "atari800xl",
      "computer": {
        "model": "Atari 800XL",
        "ramKib": 64,
        "videoStandard": "PAL",
        "basic": "built-in Atari BASIC",
        "romSet": "Altirra replacement ROMs"
      },
      "emulator": {
        "type": "altirra",
        "name": "Altirra",
        "path": "",
        "testOutputDevice": "shared-drive",
        "printerOutputPath": "build/printer/{profile}/{targetConfiguration}/{sourceName}.txt",
        "printerArgs": [],
        "rs232OutputPath": "build/rs232/{profile}/{targetConfiguration}/{sourceName}.txt",
        "rs232Args": [],
        "sharedDrivePath": "build/altirra_drive",
        "sharedDriveOutputPath": "build/altirra_drive/MCP.TXT",
        "sharedDriveArgs": [],
        "args": ["{artifact}"],
        "artifactArgs": {
          "atr": ["/disk", "{artifact}"],
          "tokenized-bas": ["/runbas", "{artifact}"],
          "lst": ["/runbas", "{artifact}"],
          "disk-directory": ["{artifact}"]
        }
      }
    },
    "atari2": {
      "compilerTarget": "atari800xl",
      "computer": {
        "model": "Atari 800XL",
        "ramKib": 64,
        "videoStandard": "PAL",
        "basic": "built-in Atari BASIC",
        "romSet": "original Atari ROMs"
      },
      "emulator": {
        "type": "atari800",
        "name": "Atari800",
        "path": "",
        "testOutputDevice": "shared-drive",
        "sharedDriveSpec": "H1:MCP.TXT",
        "sharedDrivePath": "build/atari800_drive",
        "sharedDriveOutputPath": "build/atari800_drive/MCP.TXT",
        "sharedDriveArgs": [],
        "printerOutputPath": "build/printer/{profile}/{targetConfiguration}/{sourceName}.txt",
        "printerArgs": [],
        "rs232OutputPath": "build/rs232/{profile}/{targetConfiguration}/{sourceName}.txt",
        "rs232Args": [],
        "args": ["-xl", "-pal", "-basic", "-H1", "{sharedDrive}", "-hreadwrite", "-run", "{artifact}"],
        "artifactArgs": {
          "basic": ["-xl", "-pal", "-basic", "-H1", "{sharedDrive}", "-hreadwrite", "-run", "{artifact}"],
          "tokenized-bas": ["-xl", "-pal", "-basic", "-H1", "{sharedDrive}", "-hreadwrite", "-run", "{artifact}"],
          "lst": ["-xl", "-pal", "-basic", "-H1", "{sharedDrive}", "-hreadwrite", "-run", "{artifact}"],
          "atr": ["-xl", "-pal", "-basic", "-H1", "{sharedDrive}", "-hreadwrite", "{artifact}"]
        }
      }
    },
    "c64": {
      "compilerTarget": "c64",
      "computer": {
        "model": "Commodore 64",
        "ramKib": 64,
        "videoStandard": "PAL",
        "basic": "Commodore BASIC V2"
      },
      "emulator": {
        "type": "vice",
        "name": "x64sc",
        "path": "",
        "testOutputDevice": "rs232",
        "args": ["-autostart", "{artifact}", "-autostart-warp"],
        "testArgs": ["-warp"],
        "printerOutputPath": "build/printer/{profile}/{targetConfiguration}/{sourceName}.txt",
        "printerArgs": ["-iecdevice4", "-prtxtdev1", "{printerOutput}", "-pr4txtdev", "0", "-pr4output", "text", "-pr4drv", "ascii"],
        "rs232OutputPath": "build/rs232/{profile}/{targetConfiguration}/{sourceName}.txt",
        "rs232Args": ["-userportdevice", "2", "-rsuserdev", "0", "-rsuserbaud", "2400", "-rsdev1", "{rs232Endpoint}", "-rsdev1baud", "2400"]
      }
    }
  }
}
