{
  "spectrum": {
    "tools": [
      {
        "name": "bas2tap",
        "path": "",
        "args": ["-a", "{input}", "{output}"],
        "outputExtension": ".tap"
      }
    ]
  },
  "atari800xl": {
    "tools": [
      {
        "name": "dir2atr",
        "path": "",
        "inputArtifact": "atariDiskDirectory",
        "args": ["-S", "{output}", "{input}"],
        "outputExtension": ".atr"
      }
    ]
  },
  "c64": {
    "tools": [
      {
        "name": "petcat",
        "path": "",
        "inputTransform": "lowercase",
        "args": ["-w2", "-o", "{output}", "--", "{input}"],
        "outputExtension": ".prg"
      }
    ]
  }
}
