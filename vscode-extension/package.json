{
  "name": "metabasic-vscode",
  "displayName": "8-Bit MetaBASIC",
  "description": "VS Code support for 8-Bit MetaBASIC projects.",
  "version": "0.0.1",
  "publisher": "torben-kneesch",
  "private": true,
  "type": "commonjs",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:metabasic",
    "onCommand:metabasic.buildProject",
    "onCommand:metabasic.buildTarget",
    "onCommand:metabasic.deployProject",
    "onCommand:metabasic.deployTarget",
    "onCommand:metabasic.buildTests",
    "onCommand:metabasic.launchProject",
    "onCommand:metabasic.launchTarget",
    "onCommand:metabasic.launchTests"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "metabasic",
        "aliases": [
          "8-Bit MetaBASIC",
          "metabasic"
        ],
        "extensions": [
          ".mbas"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "metabasic",
        "scopeName": "source.metabasic",
        "path": "./syntaxes/metabasic.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "metabasic.buildProject",
        "title": "MetaBASIC: Build Project"
      },
      {
        "command": "metabasic.buildTarget",
        "title": "MetaBASIC: Build Target..."
      },
      {
        "command": "metabasic.deployProject",
        "title": "MetaBASIC: Deploy Project"
      },
      {
        "command": "metabasic.deployTarget",
        "title": "MetaBASIC: Deploy Target..."
      },
      {
        "command": "metabasic.buildTests",
        "title": "MetaBASIC: Build Tests"
      },
      {
        "command": "metabasic.launchProject",
        "title": "MetaBASIC: Launch Project"
      },
      {
        "command": "metabasic.launchTarget",
        "title": "MetaBASIC: Launch Target..."
      },
      {
        "command": "metabasic.launchTests",
        "title": "MetaBASIC: Launch Tests"
      }
    ],
    "configuration": {
      "title": "MetaBASIC",
      "properties": {
        "metabasic.toolRoot": {
          "type": "string",
          "default": "",
          "description": "Optional path to a MetaBASIC tool checkout. Leave empty to use the tools bundled with the extension."
        },
        "metabasic.toolConfig": {
          "type": "string",
          "default": "",
          "description": "Optional path to local converter/emulator configuration JSON. Relative paths are resolved from the open MetaBASIC project folder. If empty, metabasic-tools.json in the project folder is used when present."
        },
        "metabasic.profile": {
          "type": "string",
          "enum": [
            "debug",
            "balanced",
            "release"
          ],
          "default": "debug",
          "description": "Build profile used by MetaBASIC extension commands."
        },
        "metabasic.runExternalTools": {
          "type": "boolean",
          "default": true,
          "description": "Compatibility setting from the first prototype. Prefer the explicit Deploy commands when converter tools should run."
        },
        "metabasic.restartEmulators": {
          "type": "boolean",
          "default": true,
          "description": "Restart a configured emulator before launch commands."
        },
        "metabasic.mirrorTestOutput": {
          "type": "boolean",
          "default": false,
          "description": "Mirror generated test-runner output to the configured target device during launch test commands."
        },
        "metabasic.testOutputDevice": {
          "type": "string",
            "enum": [
              "target-default",
              "printer",
              "text-printer",
              "shared-drive",
              "rs232"
            ],
            "default": "target-default",
            "description": "External device used when mirrorTestOutput is enabled. target-default lets each launcher choose its configured target transport."
          }
      }
    }
  }
}
