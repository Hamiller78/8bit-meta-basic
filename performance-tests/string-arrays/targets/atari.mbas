uses "../source/benchmarks.mbas"

program_mode
cls
open_device Results, SHARED_DRIVE

print "STRING ARRAY PERFORMANCE"
print "OPERATIONS: "; operationCount
print "RESULTS ARE JIFFIES"
print_device Results; "STRING ARRAY PERFORMANCE"
print_device Results; "OPERATIONS: "; operationCount
print_device Results; "RESULTS ARE JIFFIES"

elapsed = benchmarkNumericLoop()
reportResult("NUMERIC LOOP", elapsed)

elapsed = benchmarkScalarWrite()
reportResult("SCALAR WRITE", elapsed)

elapsed = benchmarkScalarLength()
reportResult("SCALAR LEN", elapsed)

elapsed = benchmarkNumericArrayWrite()
reportResult("NUMERIC ARRAY WRITE", elapsed)

elapsed = benchmarkNumericArrayRead()
reportResult("NUMERIC ARRAY READ", elapsed)

elapsed = benchmarkLiteralArrayWrite()
reportResult("ARRAY LITERAL WRITE", elapsed)

elapsed = benchmarkVariableArrayWrite()
reportResult("ARRAY VARIABLE WRITE", elapsed)

elapsed = benchmarkArrayRead()
reportResult("ARRAY READ", elapsed)

elapsed = benchmarkArrayLength()
reportResult("ARRAY LEN", elapsed)

elapsed = benchmarkArrayLeft()
reportResult("ARRAY LEFT", elapsed)

elapsed = benchmarkArrayConcatenation()
reportResult("ARRAY CONCAT", elapsed)

elapsed = benchmarkComputedIndexRead()
reportResult("COMPUTED INDEX READ", elapsed)

close_device Results
print "DONE"
end

function reportResult(label$, elapsedJiffies)
    print label$; ": "; elapsedJiffies
    print_device Results; label$; ": "; elapsedJiffies
end function
