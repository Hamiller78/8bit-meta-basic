test IfThenElse()
    local Result
    Flag = 1
    if Flag then
        Result = 10
    else
        Result = 20
    end if
    assert_eq 10, Result
end test

test FallthroughJumpKeepsLabels()
    local value
    value = 0
    goto FirstDestination
    value = 99
FirstDestination:
    value = value + 1
    goto SecondDestination
AliasDestination:
SecondDestination:
    value = value + 2
    assert_eq 3, value
end test

function dispatchResult(value)
    if value = 0 then
        return 10
    end if
    if value = 1 then
        return 20
    end if
    if value = 2 then
        return 30
    end if
    return 99
end function

function dispatchFirst()
    DispatchCallResult = 10
    return 0
end function

function dispatchSecond()
    DispatchCallResult = 20
    return 0
end function

function dispatchThird()
    DispatchCallResult = 30
    return 0
end function

function runCallDispatch(value)
    DispatchCallResult = 99
    if value = 0 then
        dispatchFirst()
    end if
    if value = 1 then
        dispatchSecond()
    end if
    if value = 2 then
        dispatchThird()
    end if
    return DispatchCallResult
end function

test ComputedDispatchBoundaries()
    local value, expected
    for value = -1 to 3
        expected = 99
        if value >= 0 and value <= 2 then
            expected = 10 + value * 10
        end if
        assert_eq expected, dispatchResult(value)
        assert_eq expected, runCallDispatch(value)
    next value
    assert_eq 99, dispatchResult(0.5)
    assert_eq 99, runCallDispatch(0.5)
end test

test ForNextLoop()
    Total = 0
    for Index = 0 to 3
        Total = Total + Index
    next Index
    assert_eq 6, Total
end test

test ForStepLoop()
    Total = 0
    for Index = 6 to 2 step -2
        Total = Total + Index
    next Index
    assert_eq 12, Total
end test

test EmptyDynamicForLoop()
    Last = 0
    Ran = 0
    for Index = 1 to Last
        Ran = 1
    next Index
    assert_eq 0, Ran
end test

test ExitAndContinueForLoop()
    Total = 0
    for Index = 1 to 5
        if Index = 2 then
            continue for
        end if
        if Index = 4 then
            exit for
        end if
        Total = Total + Index
    next Index
    assert_eq 4, Total
end test

function returnFromForLoop()
    for Index = 0 to 3
        if Index = 2 then
            return Index
        end if
    next Index
    return -1
end function

test ReturnFromForLoop()
    assert_eq 2, returnFromForLoop()
end test

test FixedStepsWithEarlyExit()
    local index, total
    total = 0
    for index = 1 to 5 step 2
        total = total + index
        if index = 99 then
            exit for
        end if
    next index
    assert_eq 9, total
    total = 0
    for index = 6 to 0 step -2
        if index = 4 then
            continue for
        end if
        if index = 0 then
            exit for
        end if
        total = total + index
    next index
    assert_eq 8, total
end test

test DynamicStepAndLimitAreCaptured()
    local index, limit, stride, total
    limit = 5
    stride = 2
    total = 0
    for index = 1 to limit step stride
        total = total + index
        limit = 0
        stride = -1
        if index = 5 then
            exit for
        end if
    next index
    assert_eq 9, total
end test

test ZeroStepCanExit()
    local index, total
    total = 0
    for index = 0 to 1 step 0
        total = total + 1
        if total = 3 then
            exit for
        end if
    next index
    assert_eq 3, total
end test

test EmptyDynamicLoopWithExit()
    local index, limit, total
    limit = 0
    total = 0
    for index = 1 to limit
        total = 1
        exit for
    next index
    assert_eq 0, total
end test

function returnFromDescendingForLoop()
    local index
    for index = 5 to 1 step -2
        if index = 3 then
            return index
        end if
    next index
    return -1
end function

test ReturnFromDescendingForLoop()
    assert_eq 3, returnFromDescendingForLoop()
    assert_eq 3, returnFromDescendingForLoop()
end test

test WhileWendLoop()
    Count = 0
    Total = 0
    while Count < 4
        Total = Total + Count
        Count = Count + 1
    wend
    assert_eq 6, Total
end test

test RepeatUntilLoop()
    Count = 3
    Total = 0
    repeat
        Total = Total + Count
        Count = Count - 1
    until Count = 0
    assert_eq 6, Total
end test

test GosubReturn()
    Value = 0
    gosub SetValue
    assert_eq 42, Value
    goto Done

SetValue:
    Value = 42
    return

Done:
    assert_true Value = 42
end test
