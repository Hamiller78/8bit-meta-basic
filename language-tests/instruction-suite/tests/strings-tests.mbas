dim BoundedSliceRows$(3, 3)
dim SingleCharacterItems$(3, 1)
dim RepeatedReadRows$(3, 8)

test RepeatedStringArrayReads()
    local index, result$
    RepeatedReadRows$(0) = "ABCD"
    RepeatedReadRows$(1) = "EF"
    RepeatedReadRows$(2) = ""
    index = 0
    result$ = left$(RepeatedReadRows$(index), 2) + right$(RepeatedReadRows$(index), 2)
    assert_eq "ABCD", result$
    RepeatedReadRows$(index) = "WXYZ"
    result$ = left$(RepeatedReadRows$(index), 2) + right$(RepeatedReadRows$(index), 2)
    assert_eq "WXYZ", result$
    index = 2
    result$ = RepeatedReadRows$(index) + RepeatedReadRows$(index)
    assert_eq "", result$
    set_rnd(0, 0.75)
    result$ = RepeatedReadRows$(int(rnd() * 2)) + RepeatedReadRows$(int(rnd() * 2))
    assert_eq "WXYZEF", result$
end test

test SingleCharacterSlicesAndArrays()
    local position, text$
    text$ = "ABC"
    position = 1
    assert_eq "A", mid$(text$, position, 1)
    assert_eq "B", mid$(text$, position + 1, 1)
    position = 3
    assert_eq "C", mid$(text$, position, 1)
    position = 1.25
    assert_eq 1, len(mid$(text$, position, 1))
    position = 2.75
    assert_eq 1, len(mid$(text$, position, 1))
    position = 0
    SingleCharacterItems$(position) = "A"
    SingleCharacterItems$(position + 1) = "B"
    SingleCharacterItems$(2) = "C"
    assert_eq "A", SingleCharacterItems$(position)
    assert_eq "B", SingleCharacterItems$(position + 1)
    assert_eq "C", SingleCharacterItems$(2)
end test

test SpectrumFractionalSingleCharacterSlice()
    local unit, position, text$
    if TEXT_COLUMNS = 32 then
        unit = 1
        position = 1.5 - unit / 2147483648
        text$ = "ABC"
        assert_eq "A", mid$(text$, position, 1)
    end if
end test

test BoundedArraySlices()
    local i, result$
    BoundedSliceRows$(0) = "ABC"
    BoundedSliceRows$(1) = "DEF"
    BoundedSliceRows$(2) = "GHI"
    result$ = ""
    for i = 1 to 3
        result$ = result$ + mid$(BoundedSliceRows$(i - 1), i, 1)
    next i
    assert_eq "AEI", result$
    assert_eq "I", right$(BoundedSliceRows$(2), 1)
    i = 2
    assert_eq "ABC", BoundedSliceRows$(i - 2)
    assert_eq "GHI", BoundedSliceRows$(i + 0)
    i = 1
    assert_eq "HI", right$(BoundedSliceRows$(i + 1), i + 1)
end test

test StringAssignmentAndConcat()
    T$ = "META"
    T$ = T$ + "-BASIC"
    assert_eq "META-BASIC", T$
end test

test StringSlices()
    local extra
    T$ = "ABCDEFG"
    assert_eq "BCD", mid$(T$, 2, 3)
    assert_eq "BCDEF", mid$(T$, 2, 5)
    assert_eq "ABC", left$(T$, 3)
    assert_eq "EFG", right$(T$, 3)
    assert_eq "G", right$(T$, 1)
    extra = 2
    assert_eq "EFG", right$(T$, extra + 1)
end test

test StringLengthAndCodes()
    assert_eq 5, len("HELLO")
    assert_eq "A", chr$(code("A"))
    assert_eq code("A"), asc("A")
    assert_eq 1, len(chr$(code("A")))
end test

test StringNumberConversion()
    assert_eq 42, val("42")
    T$ = str$(42)
    assert_true len(T$) >= 2
end test

test PrintCapture()
    print "READY"; " "; "OK"
    assert_print "READY OK"
end test

test PrintAtCapture()
    print_at 3, 4, "HI"
    assert_printat 3, 4, "HI"
end test
