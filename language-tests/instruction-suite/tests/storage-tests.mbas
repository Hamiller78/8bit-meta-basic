struct QueueStorage
    QueueRow
    QueueColumn
    QueueText$(8)
end struct

struct IntegerBoundsStorage
    left%
    right%
end struct

function ShiftedQueueRow(Item AS QueueStorage, Offset)
    local Result
    Result = Item.QueueRow + Offset
    Item.QueueRow = 99
    return Result
end function

test IntegerVariables()
    Counter% = 3.7
    assert_eq 3, Counter%
    Counter% = Counter% + 2.9
    assert_eq 5, Counter%
end test

test NumericArrays()
    dim Values(3)
    Values(0) = 2
    Values(1) = 4
    Values(2) = Values(0) + Values(1)
    assert_eq 6, Values(2)
end test

test ArrayConstantOffsets()
    dim OffsetValues(4)
    dim OffsetFlags as byte(4)
    local position
    position = 2
    OffsetValues(position - 2) = 11
    OffsetValues(position + 1) = 44
    OffsetFlags(position - 2) = 3
    OffsetFlags(position + 1) = 7
    assert_eq 11, OffsetValues(position - 2)
    assert_eq 44, OffsetValues(position + 1)
    assert_eq 3, OffsetFlags(position - 2)
    assert_eq 7, OffsetFlags(position + 1)
end test

test IntegerArrays()
    dim Counts%(2)
    local result%
    Counts%(0) = 4.8
    Counts%(1) = Counts%(0) + 2.2
    assert_eq 4, Counts%(0)
    assert_eq 6, Counts%(1)
    Counts%(0) = -3.8
    result% = Counts%(0)
    assert_eq -4, result%
    result% = Counts%(0) + 1
    assert_eq -3, result%
    result% = Counts%(0) + 0.5
    assert_eq -4, result%
end test

test IntegerStructArrayFields()
    dim Boxes as IntegerBoundsStorage(2)
    local result%
    Boxes(0).left% = -3
    Boxes(0).right% = 4
    result% = Boxes(0).left% + Boxes(0).right%
    assert_eq 1, result%
    result% = Boxes(0).left% + 0.5
    assert_eq -3, result%
end test

test ByteBooleanAssignments()
    dim Flags as byte(2)
    Flags(0) = false
    Flags(1) = true
    assert_eq 0, Flags(0)
    assert_eq 1, Flags(1)
end test

test StringArrays()
    dim M$(2, 8)
    M$(0) = "READY"
    M$(1) = "GO "
    assert_eq "READY", M$(0)
    assert_eq 5, len(M$(0))
    assert_eq "READY!", M$(0) + "!"
    assert_eq "GO ", M$(1)
    assert_eq 3, len(M$(1))
    assert_eq "GO !", M$(1) + "!"
    M$(0) = M$(0) + "!"
    assert_eq "READY!", M$(0)
    M$(1) = ""
    assert_eq 0, len(M$(1))
    assert_eq "!", M$(1) + "!"
end test

test StringArrayAssignmentSnapshot()
    dim SnapshotRows$(2, 8)
    local index, input$
    index = 0
    SnapshotRows$(index) = "AB "
    SnapshotRows$(index) = SnapshotRows$(index) + "CD"
    assert_eq "AB CD", SnapshotRows$(index)
    assert_eq 5, len(SnapshotRows$(index))
    SnapshotRows$(index) = mid$(SnapshotRows$(index), 2)
    assert_eq "B CD", SnapshotRows$(index)
    input$ = "XYZ "
    SnapshotRows$(index + 1) = input$
    assert_eq "XYZ ", SnapshotRows$(1)
    assert_eq 4, len(SnapshotRows$(1))
    assert_eq "XYZ ", input$
    if TEXT_COLUMNS = 32 then
        input$ = "123456789"
        SnapshotRows$(index) = input$
        assert_eq "12345678", SnapshotRows$(index)
        assert_eq 8, len(SnapshotRows$(index))
    end if
    input$ = ""
    SnapshotRows$(index) = input$
    assert_eq "", SnapshotRows$(index)
    assert_eq 0, len(SnapshotRows$(index))
    set_rnd(0, 0.75, 0.5)
    SnapshotRows$(index) = chr$(code("A") + int(rnd() * 2)) + chr$(code("A") + int(rnd() * 2))
    assert_eq "AB", SnapshotRows$(index)
    assert_eq 0.5, rnd()
end test

test DynamicStringArraySlices()
    dim Slices$(2, 8)
    Source$ = "ALERT"
    Slices$(0) = Source$
    assert_eq "A", left$(Slices$(0), 1)
    assert_eq "LERT", mid$(Slices$(0), 2)

    Source$ = "Z"
    Slices$(1) = Source$
    assert_eq "Z", left$(Slices$(1), 1)
end test

test StructArrays()
    dim Queue AS QueueStorage(3)
    dim NewItem AS QueueStorage

    Queue(0).QueueRow = 12
    Queue(0).QueueColumn = 2
    Queue(0).QueueText$ = "ALERT   "
    Queue(1).QueueRow = 24
    Queue(1).QueueColumn = 4
    Queue(1).QueueText$ = "STANDBY "
    NewItem.QueueRow = 15
    NewItem.QueueColumn = 6
    NewItem.QueueText$ = "INSERT  "

    assert_eq 12, Queue(0).QueueRow
    assert_eq "ALERT   ", Queue(0).QueueText$
    assert_eq 18, ShiftedQueueRow(NewItem, 3)
    assert_eq 15, NewItem.QueueRow

    insert_element(Queue, 1, NewItem)
    assert_eq 12, Queue(0).QueueRow
    assert_eq 15, Queue(1).QueueRow
    assert_eq 24, Queue(2).QueueRow
    assert_eq 6, Queue(1).QueueColumn
    assert_eq "INSERT  ", Queue(1).QueueText$

    remove_element(Queue, 0)
    assert_eq 15, Queue(0).QueueRow
    assert_eq 24, Queue(1).QueueRow
    assert_eq "INSERT  ", Queue(0).QueueText$
    assert_eq "STANDBY ", Queue(1).QueueText$
end test
