uses "../source/functions.mbas"

CopyOptimizationInput = 0

test HotModuleFunctionCalls()
    assert_eq 11, NestedBonus(4)
    assert_eq 7, AddValues(3, 4)
end test

inline function InlineBranchResult(flag)
    local answer%
    if flag then
        answer% = 7
    else
        answer% = 9
    end if
    return answer%
end function

inline function InlineReadsDestination(flag)
    local answer%
    answer% = 7
    if flag then
        answer% = 9
    end if
    return answer%
end function

function InlineBranchCaller(flag)
    local value%
    value% = InlineBranchResult(flag)
    return value%
end function

function InlineDestinationCaller(flag)
    local value%
    value% = flag
    value% = InlineReadsDestination(value%)
    return value%
end function

test InlineBranchResults()
    assert_eq 7, InlineBranchCaller(true)
    assert_eq 9, InlineBranchCaller(false)
    assert_eq 9, InlineDestinationCaller(true)
    assert_eq 7, InlineDestinationCaller(false)
end test

function CopyOptimizationFirst(value%)
    return value% + 1
end function

function CopyOptimizationSecond(value%)
    return value% + 2
end function

function CopyOptimizationChangeInput(value%)
    CopyOptimizationInput = CopyOptimizationInput + 1
    return value%
end function

function CopyOptimizationChangeParameter(value%)
    value% = 8
    return value%
end function

test RepeatedCallArguments()
    local first, second
    CopyOptimizationInput = 3
    first = CopyOptimizationFirst(CopyOptimizationInput)
    second = CopyOptimizationSecond(CopyOptimizationInput)
    assert_eq 4, first
    assert_eq 5, second
    first = CopyOptimizationChangeInput(CopyOptimizationInput)
    second = CopyOptimizationSecond(CopyOptimizationInput)
    assert_eq 3, first
    assert_eq 6, second
    first = CopyOptimizationChangeParameter(CopyOptimizationInput)
    second = CopyOptimizationSecond(CopyOptimizationInput)
    assert_eq 8, first
    assert_eq 6, second
end test

struct IntegerBounds
    left%
    right%
    speed
    fraction
end struct
dim integerBounds as IntegerBounds(2)
dim scalarBounds as IntegerBounds

function IntegerLoopValue(value)
    local result%
    result% = value
    return result%
end function

function IntegerLoopTotal()
    local i, result%
    result% = 0
    for i = 1 to 3
        result% = result% + IntegerLoopValue(i)
    next i
    return result%
end function

function FractionalLoopValue()
    local i, result%
    for i = -1.25 to -1.25
        result% = i
    next i
    return result%
end function

function ModifiedNumericParameter(value)
    local result%
    value = -1.25
    result% = value
    return result%
end function

test IntegerLoopsAndNumericFields()
    local result%
    assert_eq 6, IntegerLoopTotal()
    assert_eq -2, FractionalLoopValue()
    assert_eq -2, ModifiedNumericParameter(1)
    scalarBounds.speed = 3
    scalarBounds.fraction = -1.25
    result% = scalarBounds.speed
    assert_eq 3, result%
    result% = scalarBounds.fraction
    assert_eq -2, result%
end test

function IntegerBoundsCounter()
    local count%
    count% = integerBounds(0).left% + integerBounds(0).right%
    while count% > 0
        count% = count% - 1
    wend
    return count%
end function

function WholeChoice(flag)
    if flag then
        return -1
    else
        return 2
    end if
end function

function ForwardWholeChoice(flag)
    return WholeChoice(flag) + 1
end function

function FractionalChoice(flag)
    if flag then
        return -1.25
    end if
    return 2
end function

test IntegerFunctionResults()
    local result%
    result% = ForwardWholeChoice(true)
    assert_eq 0, result%
    result% = ForwardWholeChoice(false)
    assert_eq 3, result%
    result% = FractionalChoice(true)
    assert_eq -2, result%
end test

test IntegerBoundsAndCounter()
    local result%
    integerBounds(0).left% = 2
    integerBounds(0).right% = 3
    assert_eq 5, integerBounds(0).left% + integerBounds(0).right%
    assert_eq 0, IntegerBoundsCounter()
    integerBounds(0).speed = 2
    integerBounds(0).fraction = -1.25
    result% = integerBounds(0).speed
    assert_eq 2, result%
    result% = integerBounds(0).fraction
    assert_eq -2, result%
end test

test FunctionCallWithVariable()
    local Value
    Value = 5
    assert_eq 8, AddValues(Value, 3)
end test

test FunctionCallWithConstant()
    assert_eq 7, AddValues(2, 5)
end test

test FunctionCallWithExpression()
    assert_eq 11, AddValues(2 + 3, 3 * 2)
end test

test LocalVariableShadowing()
    Result = 99
    assert_eq 8, LocalShadow(4)
    assert_eq 99, Result
end test

test NestedFunctionCall()
    assert_eq 13, NestedBonus(5)
end test

test TemporaryValuesSurviveNestedCalls()
    assert_eq 15, AddValues(LocalShadow(2), NestedBonus(4))
    assert_eq 17, AddValues(NestedBonus(5), LocalShadow(2))
end test

test ImmediateIntegerFunctionResult()
    local result%
    result% = AddValues(-2, 0.5)
    assert_eq -2, result%
    result% = AddValues(2, 0.5)
    assert_eq 2, result%
end test

test FunctionResultsInConditions()
    local result
    result = 0
    if AddValues(2, 3) = 5 then
        result = result + 1
    end if
    if AddValues(2, 3) = 6 then
        result = result + 10
    end if
    if AddValues(1, 0) < AddValues(2, 0) then
        result = result + 2
    end if
    assert_eq 3, result
end test

inline function InlineIntegerResult(value)
    local result%
    result% = value
    return result%
end function

test InlineIntegerSnapshots()
    local result%
    result% = InlineIntegerResult(-1.25)
    assert_eq -2, result%
    assert_eq 7, InlineIntegerResult(2) + InlineIntegerResult(5)
end test

inline function InlineBoundaryValue(value%)
    local answer%
    answer% = value%
    return answer%
end function

function InlineBoundaryCaller(value%)
    local result%
    result% = InlineBoundaryValue(value%)
    return result%
end function

test InlineIntegerBoundaries()
    local original%, result%, snapshot
    ' Only Agon has both an 80-column display and 32-bit integer variables.
    if TEXT_COLUMNS = 80 then
        original% = 2147483647
        snapshot = original%
        result% = int(snapshot)
        assert_eq original%, result%
        result% = InlineBoundaryCaller(original%)
        assert_eq original%, snapshot
        assert_eq original%, result%
        original% = -2147483647
        original% = original% - 1
        snapshot = original%
        result% = int(snapshot)
        assert_eq original%, result%
        result% = InlineBoundaryCaller(original%)
        assert_eq original%, snapshot
        assert_eq original%, result%
        original% = 16777217
        result% = InlineBoundaryCaller(original%)
        assert_eq original%, result%
        original% = -16777217
        result% = InlineBoundaryCaller(original%)
        assert_eq original%, result%
    end if
end test

function IntegerParameterResult(value%)
    local result%
    result% = value% + 1
    return result%
end function

function ForwardIntegerParameter(value%)
    return IntegerParameterResult(value%)
end function

function LocallyInitializedIntegerParameter()
    local source%
    source% = 4
    return IntegerParameterResult(source%)
end function

function MixedParameterDifference(value%)
    local expected, result%
    expected = int(value% + 1)
    result% = value% + 1
    return result% - expected
end function

test IntegerParameterCallSites()
    local source%
    source% = -3
    assert_eq -2, IntegerParameterResult(source%)
    assert_eq 5, ForwardIntegerParameter(4)
    assert_eq 5, LocallyInitializedIntegerParameter()
    assert_eq 0, MixedParameterDifference(2)
    assert_eq 0, MixedParameterDifference(-1.25)
end test

test TemporaryValuesSurviveBranchesAndLoops()
    local Index, Total
    Total = 0
    for Index = 1 to 3
        if Index = 2 then
            Total = Total + AddValues(LocalShadow(Index), NestedBonus(Index))
        else
            Total = Total + AddValues(LocalShadow(Index), LocalShadow(Index + 1))
        end if
    next Index
    assert_eq 31, Total
end test

test ProcedureFunctionBareReturn()
    ProcedureResult = 0
    StoreProcedureValue(7)
    assert_eq 7, ProcedureResult
end test

test ProcedureFunctionImplicitReturn()
    ProcedureResult = 0
    StoreImplicitProcedureValue(8)
    assert_eq 9, ProcedureResult
end test
