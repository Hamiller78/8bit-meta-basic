uses "../source/functions.mbas"

struct IntegerBounds
    left%
    right%
end struct
dim integerBounds as IntegerBounds(2)

function IntegerBoundsCounter()
    local count%
    count% = integerBounds(0).left% + integerBounds(0).right%
    while count% > 0
        count% = count% - 1
    wend
    return count%
end function

test IntegerBoundsAndCounter()
    integerBounds(0).left% = 2
    integerBounds(0).right% = 3
    assert_eq 5, integerBounds(0).left% + integerBounds(0).right%
    assert_eq 0, IntegerBoundsCounter()
end test

test FunctionCallWithVariable()
    local Value
    Value = 5
    assert_eq 8, AddValues(Value, 3)
end test

test FunctionCallWithConstant()
    assert_eq 7, AddValues(2, 5)
end test

test FunctionCallWithExpression()
    assert_eq 11, AddValues(2 + 3, 3 * 2)
end test

test LocalVariableShadowing()
    Result = 99
    assert_eq 8, LocalShadow(4)
    assert_eq 99, Result
end test

test NestedFunctionCall()
    assert_eq 13, NestedBonus(5)
end test

test TemporaryValuesSurviveNestedCalls()
    assert_eq 15, AddValues(LocalShadow(2), NestedBonus(4))
    assert_eq 17, AddValues(NestedBonus(5), LocalShadow(2))
end test

test ImmediateIntegerFunctionResult()
    local result%
    result% = AddValues(-2, 0.5)
    assert_eq -2, result%
    result% = AddValues(2, 0.5)
    assert_eq 2, result%
end test

test FunctionResultsInConditions()
    local result
    result = 0
    if AddValues(2, 3) = 5 then
        result = result + 1
    end if
    if AddValues(2, 3) = 6 then
        result = result + 10
    end if
    if AddValues(1, 0) < AddValues(2, 0) then
        result = result + 2
    end if
    assert_eq 3, result
end test

inline function InlineIntegerResult(value)
    local result%
    result% = value
    return result%
end function

test InlineIntegerSnapshots()
    local result%
    result% = InlineIntegerResult(-1.25)
    assert_eq -2, result%
    assert_eq 7, InlineIntegerResult(2) + InlineIntegerResult(5)
end test

function IntegerParameterResult(value%)
    local result%
    result% = value% + 1
    return result%
end function

function ForwardIntegerParameter(value%)
    return IntegerParameterResult(value%)
end function

function LocallyInitializedIntegerParameter()
    local source%
    source% = 4
    return IntegerParameterResult(source%)
end function

function MixedParameterDifference(value%)
    local expected, result%
    expected = int(value% + 1)
    result% = value% + 1
    return result% - expected
end function

test IntegerParameterCallSites()
    local source%
    source% = -3
    assert_eq -2, IntegerParameterResult(source%)
    assert_eq 5, ForwardIntegerParameter(4)
    assert_eq 5, LocallyInitializedIntegerParameter()
    assert_eq 0, MixedParameterDifference(2)
    assert_eq 0, MixedParameterDifference(-1.25)
end test

test TemporaryValuesSurviveBranchesAndLoops()
    local Index, Total
    Total = 0
    for Index = 1 to 3
        if Index = 2 then
            Total = Total + AddValues(LocalShadow(Index), NestedBonus(Index))
        else
            Total = Total + AddValues(LocalShadow(Index), LocalShadow(Index + 1))
        end if
    next Index
    assert_eq 31, Total
end test

test ProcedureFunctionBareReturn()
    ProcedureResult = 0
    StoreProcedureValue(7)
    assert_eq 7, ProcedureResult
end test

test ProcedureFunctionImplicitReturn()
    ProcedureResult = 0
    StoreImplicitProcedureValue(8)
    assert_eq 9, ProcedureResult
end test
